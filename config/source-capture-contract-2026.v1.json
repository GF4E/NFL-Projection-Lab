    "weather": {"owner": "OS-03", "target": "issued_weather_raw_snapshot"},
    "odds": {"owner": "OS-04", "target": "market_raw_snapshot"},
    "identityLinkRule": "later canonical IDs append a reference and never rewrite source bytes, sidecar, receipt time, or evidence hash"
  },
  "qualification": {
    "resources": "isolated_owner_only_D1_and_R2",
    "fixtureOnly": true,
    "externalProviderRequests": 0,
    "providerSecretsPresent": false,
    "requiredProofs": [
