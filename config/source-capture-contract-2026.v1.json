  "requestIdentity": {
    "contract": "engine-os.redacted-http-request.v1",
    "methodUppercase": true,
    "urlIncludes": ["scheme", "host", "port_when_nondefault", "path"],
    "urlExcludes": ["userinfo", "fragment", "query_values_not_explicitly_public"],
    "publicQueryValues": "allowlist_only_sorted_multivalue",
    "nonpublicQueryHandling": "retain_sorted_key_name_only_in_redacted_query_keys",
    "publicHeaderValues": "allowlist_only",
    "forbiddenPersistedHeaders": ["authorization", "cookie", "proxy-authorization", "set-cookie"],
    "credentialBearingPath": "reject",
    "canonicalSerialization": "RFC8785_style_repository_canonical_json",
    "hash": "sha256"
  },
  "timeSemantics": {
    "sourceObservedAt": "timestamp represented by the source evidence; nullable only with an explicit source_time_missing code",
    "providerPublishedAt": "provider issue or publication timestamp; nullable only with an explicit publication_time_missing code",
    "receiptCompletedAt": "time the final response byte is available to the capture lane",
    "persistenceRequestedAt": "time immutable R2 publication begins",
    "responsePersistedAt": "time response-object read-after-write verification completes",
    "sidecarPersistedAt": "time sidecar-object read-after-write verification completes",
    "manifestPersistedAt": "D1 statement timestamp for the committed manifest extension",
    "validFrom": "first source-valid instant",
    "validTo": "last source-valid instant or null for open-ended validity",
    "orderingRules": [
      "receiptCompletedAt <= persistenceRequestedAt",
      "persistenceRequestedAt <= responsePersistedAt",
      "responsePersistedAt <= sidecarPersistedAt",
      "sidecarPersistedAt <= manifestPersistedAt",
      "validTo is null or validFrom <= validTo"
    ],
    "clockFormat": "UTC ISO-8601 milliseconds"
  },
  "responseEvidence": {
    "preservation": "exact_response_bytes_without_decode_normalize_or_recompression",
    "hash": "sha256",
    "minimumBytes": 1,
    "maximumWorkerObjectBytes": 100000000,
    "responseObjectKey": "raw/{provider}/{dataset}/sha256/{responseSha256}",
    "sidecarObjectKey": "manifests/os03a/sha256/{sidecarSha256}.json",
    "readAfterWriteVerification": "required_before_D1_pointer",
    "contentDeduplication": "provider_dataset_response_digest",
    "captureEventDeduplication": "provider_dataset_idempotency_key",
    "sameBytesDifferentOrigin": "one_response_object_distinct_capture_manifests"
  },
  "sidecar": {
    "schema": "engine-os.os-03a-capture-sidecar.v1",
    "requiredFields": [
      "captureId",
      "idempotencyKey",
      "provider",
      "dataset",
      "captureClass",
      "request",
      "requestHash",
      "responseObjectKey",
      "responseSha256",
      "responseBytes",
      "contentType",
      "etag",
      "sourceObservedAt",
      "providerPublishedAt",
      "receiptCompletedAt",
      "persistenceRequestedAt",
      "responsePersistedAt",
      "validFrom",
      "validTo",
      "sourceSchemaVersion",
      "usageRights",
      "validationState",
      "laterImport",
      "evidenceHash"
    ],
    "selfHashExcluded": true,
    "canonicalSerialization": "repository_canonical_json",
    "hash": "sha256"
  },
  "usageRights": {
    "requiredFields": [
      "licenseId",
      "rightsUri",
      "retrievedFor",
      "redistribution",
      "retentionClass",
      "reviewStatus"
    ],
    "retentionClass": "raw_source_3650_days",
    "realSourceActivationRule": "rights review must be verified before non-fixture production acquisition",
    "unknownRightsBehavior": "private_preservation_only_and_withhold_public_redistribution"
  },
  "secretSafety": {
    "scanCanonicalRequest": true,
    "scanSidecar": true,
    "scanTextualResponseBeforeR2": true,
    "binaryResponseRule": "only provider profiles with no request credential and an approved binary content type",
    "secretBearingResponseBehavior": "do_not_persist_body_record_secret_filtered_failure_only",
    "secretBearingErrorBehavior": "do_not_persist_body_record_secret_filtered_failure_only",
    "storedFailurePayload": "enumerated_code_and_secret_free_metadata_only",
    "liveMarketSecretRead": "prohibited"
  },
  "validationStates": {
    "usable": "may advance latest-good pointer",
    "raw_only_schema_invalid": "preserve exact bytes and manifest; do not advance latest-good pointer",
    "raw_only_partial": "preserve exact bytes and manifest; do not advance latest-good pointer",
    "raw_only_http_error": "preserve only after secret scan; do not advance latest-good pointer"
  },
  "publicationOrdering": [
    "validate secret policy",
    "write response object by content address",
    "read back and verify response digest and byte count",
    "build canonical sidecar with response persistence receipt",
    "write sidecar by content address",
    "read back and verify sidecar digest and byte count",
    "atomically insert D1 base manifest, OS-03A extension, append-only event, and conditional last-good pointer",
    "read back D1 pointer and reverify both R2 objects"
  ],
  "pointerRules": {
    "latestGoodOwner": "source_capture_heartbeats.latest_capture_id",
    "advanceOnlyWhen": "validationState_is_usable_and_all_R2_and_D1_evidence_verifies",
    "failedOrPartialCapture": "preserve_prior_latest_capture_id",
    "conflictingIdempotencyKey": "fail_closed_without_pointer_change",
    "manifestWithoutSidecar": "prohibited",
    "pointerWithoutManifest": "prohibited"
  },
  "eventJournal": {
    "table": "source_capture_events",
    "appendOnly": true,
    "eventTypes": [
      "capture_committed",
      "capture_deduplicated",
      "capture_failed",
      "replay_verified",
      "orphan_detected",
      "orphan_removed"
    ],
    "attemptToken": "unique_per_execution_attempt",
    "retryIdentity": "same_provider_dataset_idempotency_key_new_attempt_token",
    "payload": "canonical_secret_free_json"
  },
  "failureAndHeartbeat": {
    "failureCodes": [
      "provider_unavailable",
      "schema_invalid",
      "partial_import",
      "storage_failure",
      "manifest_failure",
      "corrupt_object",
      "secret_filtered",
      "source_time_missing",
      "publication_time_missing"
    ],
    "failureEventAndAlert": "same_D1_batch",
    "failureAlertTiming": "immediate_at_failure_before_any_later_required_horizon",
    "lastGoodRequired": true,
    "notModifiedWithoutPriorCapture": "reject",
    "freshnessThresholds": "engine-operating-contract.2026.1.maximumSourceAgeSeconds",
    "staleWatchdog": "provider_independent_check_only_no_fetch"
  },
  "retry": {
    "storageLayerProviderCalls": 0,
    "sameIdempotencyKeyRequired": true,
    "newAttemptTokenRequired": true,
    "retryAfterCommittedCapture": "verify_and_deduplicate",
    "retryAfterResponseOnlyOrphan": "reuse_verified_content_address_then_commit_manifest",
    "retryAfterConflict": "reject"
  },
  "orphanPolicy": {
    "immediateCleanup": "best_effort_for_objects_created_by_a_failed_attempt_after_reference_check",
    "sweeperMinimumAgeSeconds": 86400,
    "sweeperPrefixes": ["raw/", "manifests/os03a/"],
    "deleteReferencedObject": false,
    "deleteObjectWithUnknownReferenceState": false,
    "cleanupEvidence": "append_only_orphan_detected_and_orphan_removed_events",
    "productionSweepDuringOS03AQualification": false
  },
  "laterImport": {
    "schedule": {"owner": "OS-03", "target": "schedule_raw_snapshot"},
