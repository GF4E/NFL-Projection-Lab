      "secret_filtering",
      "append_only_manifests_and_events",
      "corruption_detection",
      "publish_before_pointer_atomicity",
      "provider_offline_replay",
      "failed_upload_behavior",
      "failed_manifest_behavior",
      "heartbeat_and_alert_behavior",
      "partial_import_last_good_preservation",
      "orphan_detection_and_cleanup",
      "disabled_market_fixture_without_dispatch"
    ]
  },
  "activationBoundary": {
