  "candidates": {
    "p0_league_season_naive": {
      "complexityRank": 0,
      "description": "A 64-game previous-season weighted home and away prior updated by current-season games, with neutral games set to the pooled mean and a paired prequential residual distribution.",
      "equation": "previous_home_and_away_means_use_only_nonneutral_prior_season_games_with_frozen_time_weights;current_home=(64*previous_home+weighted_current_nonneutral_home_count)/(64+weighted_current_nonneutral_game_weight);current_away_analogous;neutral_both=(current_home+current_away)/2;neutral_historical_games_do_not_estimate_the_location_split"
    },
    "p1_partially_pooled_rates": {
      "complexityRank": 1,
      "description": "Equal blend of latest-17-game partially pooled team offense rate and opponent series-allowed rate, plus a signed nonneutral home adjustment, with the same paired prequential residual distribution.",
      "equation": "league_L=weighted_series/weighted_team_games; rate_T=(weighted_latest17_sum+4*L)/(weighted_latest17_games+4); H=(weighted_nonneutral_home_mean-weighted_nonneutral_away_mean)/2; home=clip((offense_home+allowed_away)/2+H,4,20); away=clip((offense_away+allowed_home)/2-H,4,20); neutral_H=0",
      "ablationEquations": {
        "offense_rate_only": "home=clip(offense_home+H,4,20);away=clip(offense_away-H,4,20);neutral_H=0",
        "opponent_allowed_rate_only": "home=clip(allowed_away+H,4,20);away=clip(allowed_home-H,4,20);neutral_H=0",
        "no_home_context": "the_full_equal_blend_with_H_set_to_zero_for_all_games",
        "no_time_decay": "the_full_equal_blend_with_all_exponential_weights_set_to_one_while_the_2020_multiplier_remains_0.5"
      },
      "candidateSpecificAblations": ["offense_rate_only", "opponent_allowed_rate_only", "no_home_context", "no_time_decay"]
    },
    "p2_regularized_joint_count": {
      "complexityRank": 2,
      "ridgePenalty": 32,
      "description": "Weighted multi-output ridge adjustment to row-specific prequential P0 means over an exact fold-scaled design, converted to a joint discrete count distribution with candidate-specific prior prequential residuals.",
      "offset": "row_specific_prequential_p0_home_and_away_means",
      "response": "actual_home_and_away_counts_minus_row_specific_prequential_p0_means",
      "orderedDesign": {
        "first": ["p1_home_mean", "p1_away_mean"],
        "profileGroupOrder": ["situation_neutral_pace", "play_volume", "drive_duration", "clock_stop"],
        "perProfileFeatureColumns": ["average_of_home_and_away_profile", "home_minus_away_profile", "average_of_corresponding_missing_indicators", "home_minus_away_corresponding_missing_indicators"],
        "last": ["is_neutral_site"],
        "intercept": "prepended_unpenalized"
      },
      "foldTransform": "each_nonintercept_column_imputed_by_weighted_training_fold_mean_then_centered_and_scaled_by_weighted_training_fold_population_standard_deviation; scale_below_1e-6_becomes_1; target_transform_reuses_fit_artifact",
      "penalty": "ridge_32_on_every_scaled_design_coefficient_and_zero_on_intercept",
      "coefficientEquation": "B=(X_transpose_W_X+diag(0,32,...,32))_solve_X_transpose_W_(Y-M0)",
      "predictionEquation": "clip(M0+X_B,4,20)",
      "candidateSpecificAblations": ["no_possession_rate", "no_situation_neutral_pace", "no_play_volume", "no_drive_duration", "no_clock_stop", "no_home_context", "no_time_decay"]
      ,"ablationSemantics": {
        "no_possession_rate": "remove_both_p1_mean_design_columns_but_retain_the_p0_offset",
        "no_home_context": "remove_only_the_explicit_is_neutral_site_design_column;the_frozen_p0_offset_and_p1_design_columns_retain_their_baseline_location_adjustments",
        "no_time_decay": "use_prequential_no_decay_p0_and_p1_columns_no_decay_profiles_no_decay_fit_weights_and_no_decay_residual_weights_while_retaining_the_2020_multiplier"
      }
    }
  },
