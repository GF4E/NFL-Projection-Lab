[Unit]
Description=NFL numerical shadow cutoff state (inactive for issuance)
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=nflengine
Group=nflengine
WorkingDirectory=/Users/gabe/Documents/Codex/2026-09-04/nfl-prediction-engine-gpt6
EnvironmentFile=/etc/nfl-engine/secrets.env
Environment=NFL_RUNNER_ID=digitalocean:599707390
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
ExecStart=/opt/nfl-runtime/env/bin/python -B scripts/cloud_scheduler.py cutoff
TimeoutStartSec=600
MemoryMax=4G
MemorySwapMax=0
Nice=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/Users/gabe/Documents/Codex/2026-09-04/nfl-prediction-engine-gpt6
