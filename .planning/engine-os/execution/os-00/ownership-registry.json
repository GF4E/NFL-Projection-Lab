{
  "schemaVersion": "prediction-engine-os-ownership-registry-v1",
  "decisionId": "ADR-0001",
  "effectiveOn": "2026-08-25",
  "authoritativePlanes": {
    "git": "Code, protocols, configuration, migrations, feature definitions, ADRs, and small content-addressed manifests.",
    "r2": "Immutable raw bytes, versioned columnar datasets, large experiment outputs, model packages, forecast distributions, and publication payloads.",
    "d1": "Canonical identities, object manifests, compact point-in-time rows, leases, job state, registries, forecast summaries, evaluations, alerts, and serving pointers.",
    "worker": "Scheduled lightweight coordination, bounded acquisition, validation, verified inference, atomic publication, and read-only serving.",
    "computeRunner": "Authenticated historical replay, fitting, bootstrap or ensemble work, evaluation, and model-package publication."
  },
