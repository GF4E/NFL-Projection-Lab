  "knownNoncompliance": [
    {
      "requirement": "ARC-03",
      "finding": "D1 tables are still created by both Drizzle migrations and runtime CREATE TABLE statements.",
      "ownerTask": "OS-01"
    },
    {
      "requirement": "ARC-02",
      "finding": "The legacy job route is HTTP 410 and its runner is a no-I/O tombstone, but login, callback, team-auth, and Supabase client sources remain; full quarantine still requires removing them from the active dependency graph and deployed environment.",
      "ownerTask": "OS-00-runtime-half"
    },
    {
      "requirement": "ARC-04",
      "finding": "The current Worker lifecycle path performs coefficient work; heavy fitting still needs the compute-runner boundary.",
      "ownerTask": "OS-15"
    },
    {
      "requirement": "DATA-01",
      "finding": "No R2 binding or durable upload is present for the 502,101,912-byte Model Lab source cache.",
      "ownerTask": "OS-03"
    }
  ],
  "verifiedControls": [
    {
      "requirement": "ARC-05",
      "control": "The /sunday request-side maintenance dispatch was removed, and public Worker GET routes receive a SELECT-only D1 capability.",
      "evidence": "tests/public-runtime-boundary.test.ts"
    },
    {
      "requirement": "ARC-02",
      "control": "POST /api/jobs/:job returns 410 and src/server/jobs/runner.ts performs no provider or database I/O.",
      "evidence": "tests/public-runtime-boundary.test.ts"
    }
