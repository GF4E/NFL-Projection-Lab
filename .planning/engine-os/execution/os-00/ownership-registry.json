    "retirementSequence": [
      "Record whether any legacy row requires a one-time export; never dual-write it.",
      "Make the job API and all imports from src/server/jobs/runner.ts unreachable from the active build.",
      "Remove Supabase variables from the deployed Worker and public build.",
      "Revoke service-role, anonymous, pipeline, and legacy cron credentials.",
      "Archive migrations as historical evidence or delete them only after the export and rollback window closes."
    ],
    "rollback": "Restore from a tagged pre-quarantine release only for time-bounded data export; do not resume production writes."
