  "d1TablePolicy": {
    "owner": "d1",
    "schemaOwner": "git:drizzle",
    "currentException": "Runtime CREATE TABLE statements still exist and remain noncompliant until OS-01 removes them.",
    "legacyPersonalState": [
      "plays",
      "play_clv_audit",
      "play_correction_audit",
      "play_settlement_audit",
      "play_state_audit",
      "qb_model_overrides",
      "web_push_attempts",
      "web_push_deliveries",
      "web_push_subscriptions"
    ],
    "legacyPersonalStateDisposition": "No public mutation or engine training dependency; export if required, then remove under OS-18. It does not move to another production database."
  },
  "r2ObjectFamilies": [
    {
      "family": "raw-source-response",
      "keyTemplate": "raw/{provider}/{dataset}/sha256/{sha256}",
      "immutability": "write-once"
    },
    {
      "family": "model-lab-source",
      "keyTemplate": "model-lab/raw/sha256/{sha256}",
      "immutability": "write-once"
    },
    {
      "family": "as-of-dataset",
      "keyTemplate": "datasets/{definitionVersion}/{origin}/sha256/{sha256}.parquet",
      "immutability": "write-once"
    },
    {
      "family": "experiment-artifact",
      "keyTemplate": "experiments/{experimentId}/sha256/{sha256}",
      "immutability": "write-once"
    },
    {
      "family": "model-package",
      "keyTemplate": "models/{packageCapability}/sha256/{sha256}",
      "immutability": "write-once"
    },
    {
      "family": "forecast-distribution",
      "keyTemplate": "forecasts/{originId}/{gameId}/sha256/{sha256}",
      "immutability": "write-once"
    },
    {
      "family": "publication-payload",
      "keyTemplate": "publications/sha256/{sha256}",
      "immutability": "write-once; D1 pointer changes atomically"
    }
  ],
  "jobs": [
