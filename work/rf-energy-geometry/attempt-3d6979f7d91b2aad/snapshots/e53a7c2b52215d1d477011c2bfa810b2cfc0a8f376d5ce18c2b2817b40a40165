    def test_cycles_and_deep_original_failures(self):
        def cycle(events):
            value = []; value.append(value); return value, []
        def mutual(events):
            left, right = {}, []; left['x'] = right; right.append(left); return left, []
        for label, factory in [('cycle', cycle), ('mutual', mutual), ('deep', lambda events: (nested(sys.getrecursionlimit()*2), []))]:
            result = self.pair(label, factory)
            self.assertEqual(result['candidate']['outcome']['type'], 'RecursionError')
            self.assertNotIn('assembly', result['candidate']['events'])

    def test_aliases_and_post_capture_mutation(self):
        shared = {'x': [1., -0.]}
        original = [shared, shared]
        before = candidate.capture_value(original)
        shared['x'][0] = 9.; shared['x'][1] = 0.
        equivalent_before = candidate.capture_value([{'x': [1., -0.]}, {'x': [1., -0.]}])
        current = candidate.capture_value(original)
        old_same, new_same = candidate.same(before, equivalent_before), candidate.same(before, current)
        emit({'test': self.id(), 'label': 'owned-alias-capture', 'kind': 'mutation_decisions', 'original_before': image(original_strict([{'x': [1., -0.]}]*2)),
              'original_after': image(original_strict(original)), 'candidate_before_still_equal': old_same, 'candidate_after_equal': new_same})
        self.assertIs(old_same, True); self.assertIs(new_same, False)

    def test_mixed_comparison_never_rereads_mutated_raw_input(self):
        events = []
        raw = hooked(ListHook, events, 'capture-hook', [1, -0.])
        before = candidate.capture_value(raw)
        raw[:] = [9, 0.]; raw.error = 'must never reread'
        fallback = candidate.capture_value([Integer(1), Floating(-0.)])
        with patch.object(candidate, 'canonical', side_effect=AssertionError('same recanonicalized')) as conversion:
            actual = candidate.same(before, fallback)
