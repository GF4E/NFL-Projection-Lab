                  'candidate_same': actual, 'candidate_reverse_same': reverse, 'raw_hook_events': events,
                  'canonical_calls_during_same': conversion.call_count, 'before_mode': before.mode, 'after_mode': fallback.mode})
            self.assertIs(actual, True); self.assertIs(reverse, True)
            self.assertEqual(events, ['capture-hook']); self.assertEqual(conversion.call_count, 0)

