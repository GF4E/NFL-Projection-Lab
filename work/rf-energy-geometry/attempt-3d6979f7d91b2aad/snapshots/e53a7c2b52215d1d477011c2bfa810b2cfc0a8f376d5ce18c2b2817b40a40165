    def test_subclass_and_numpy_hooks_once_per_capture(self):
        for cls in (ListHook, DictHook, ArrayHook, ScalarHook):
            for fallback in (False, True):
                def factory(events, cls=cls, fallback=fallback):
                    payload = {'x': 'é' if fallback else [-0., 1]}
                    if cls is ListHook: payload = [payload]
                    return tuple(hooked(cls, events, side, payload) for side in ('left-hook', 'right-hook'))
                result = self.pair(cls.__name__+'-fallback-'+str(fallback), factory, True, ['fallback' if fallback else 'supported']*2)
                self.assertEqual(result['candidate']['events'], ['left-hook', 'assembly', 'right-hook'])

    def test_before_capture_errors_prevent_assembly(self):
