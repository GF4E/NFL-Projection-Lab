    def test_unexpected_local_failures_propagate_without_retry(self):
        for stage in ('canonical', 'eligibility', 'fallback-encoded', 'mixed-encoded'):
            if stage == 'mixed-encoded':
                left = candidate.capture_value([1]); right = candidate.capture_value([Integer(1)])
            local = 'canonical' if stage == 'canonical' else '_eligible' if stage == 'eligibility' else 'encoded'
            error = RuntimeError('injected '+stage)
            with patch.object(candidate, local, side_effect=error) as failing:
                function = (lambda: candidate.capture_value([1])) if stage in ('canonical', 'eligibility') else (lambda: candidate.capture_value(['é'])) if stage == 'fallback-encoded' else (lambda: candidate.same(left, right))
                actual, actual_type = outcome(function)
                emit({'test': self.id(), 'label': 'injected-'+stage, 'kind': 'deliberate_injection', 'outcome': actual, 'calls': failing.call_count})
                self.assertIs(actual_type, RuntimeError); self.assertEqual(actual['message'], str(error)); self.assertEqual(failing.call_count, 1)
            self.pair('valid-after-'+stage, lambda events: ([1, -0.], [1, -0.]), True)

    def test_failure_then_valid_and_readonly_mode(self):
        self.pair('failure-before-valid', lambda events: ([math.nan], []))
        left = candidate.capture_value([1]); right = candidate.capture_value([1])
        assignment, assignment_type = outcome(lambda: setattr(left, 'mode', 'fallback'))
        emit({'test': self.id(), 'label': 'mode-assignment-forbidden', 'kind': 'handle_contract', 'outcome': assignment,
              'retained_mode': left.mode})
        self.assertIn(assignment_type, (AttributeError, TypeError))
        self.assertEqual(left.mode, 'supported')
        actual = candidate.same(left, right)
        emit({'test': self.id(), 'label': 'read-only-mode-valid-after-failure', 'kind': 'decision', 'value': actual, 'mode': left.mode})
        self.assertIs(actual, True)

    def test_invalid_handles_rejected_without_read_or_encoding(self):
        snapshot = candidate.capture_value([1])
        for i, (left, right) in enumerate(((None, snapshot), (snapshot, [1]), (object(), object()))):
            with patch.object(candidate, 'canonical', side_effect=AssertionError('invalid handle canonicalized')) as conversion, \
                 patch.object(candidate, 'encoded', side_effect=AssertionError('invalid handle encoded')) as encoder:
                actual, actual_type = outcome(lambda: candidate.same(left, right))
                emit({'test': self.id(), 'label': 'invalid-handle-'+str(i), 'kind': 'handle_contract',
                      'outcome': actual, 'canonical_calls': conversion.call_count, 'encoded_calls': encoder.call_count})
                self.assertIs(actual_type, TypeError)
                self.assertEqual(actual['message'], 'snapshots_required')
                self.assertEqual((conversion.call_count, encoder.call_count), (0, 0))


