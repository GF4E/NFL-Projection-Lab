                    lambda events: hooked(ListHook, events, 'left-hook', [], 'left hook failed')):
            result = self.pair('left-before-assembly-error', lambda events, raw=raw: (raw(events), hooked(ListHook, events, 'unread-right', [])))
            self.assertEqual(result['candidate']['outcome']['kind'], 'error')
            self.assertNotIn('assembly', result['candidate']['events'])
