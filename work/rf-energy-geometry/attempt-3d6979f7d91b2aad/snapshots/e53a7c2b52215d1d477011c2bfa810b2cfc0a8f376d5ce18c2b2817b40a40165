    def test_node_boundary_keys_and_repeated_occurrences(self):
        for size in (NODES-1, NODES, NODES+1):
            self.modes('node-count-'+str(size), lambda size=size: [0]*(size-1), size <= NODES)
        for size in (NODES, NODES+1):
            self.modes('key-node-count-'+str(size), lambda size=size: {'x': [0]*(size-3)}, size <= NODES)
        for count in (65535, 65536):
            self.modes('alias-node-count-'+str(count), lambda count=count: [[0]]*count, 1+2*count <= NODES)

    def test_ascii_character_boundary_and_keys(self):
        for size in (CHARS-1, CHARS, CHARS+1):
            self.modes('ascii-char-count-'+str(size), lambda size=size: 'a'*size, size <= CHARS)
        for size in (CHARS, CHARS+1):
            self.modes('key-char-count-'+str(size), lambda size=size: {'x': 'a'*(size-1)}, size <= CHARS)
        self.modes('shared-char-occurrences', lambda: ['a'*(CHARS//2)]*2, True)
        self.modes('shared-char-occurrences-over', lambda: ['a'*(CHARS//2)]*2+['x'], False)
        self.modes('ascii-del-boundary', lambda: '\x7f', True)
        self.modes('unicode-first-nonascii', lambda: '\x80', False)

    def test_integer_bits_and_decimal_guard(self):
        for value in (-(1 << 256), -(1 << 255), 0, 1 << 255, (1 << 256)-1, 1 << 256):
            self.modes('integer-bits-'+str(value.bit_length())+'-'+str(value < 0), lambda value=value: value, value.bit_length() <= 256)
        limit = sys.get_int_max_str_digits()
        if limit:
            self.pair('decimal-conversion-error', lambda events: (10**limit, 1))
        self.assertEqual(sys.get_int_max_str_digits(), limit)

