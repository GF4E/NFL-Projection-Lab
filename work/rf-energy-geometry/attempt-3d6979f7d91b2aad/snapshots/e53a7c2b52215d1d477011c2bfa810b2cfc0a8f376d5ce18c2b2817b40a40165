    def test_noncontiguous_readonly_arrays_are_not_mutated(self):
        def factory(events):
            value = np.arange(24.).reshape(4, 6)[:, ::2]
            value[0, 0] = -0.; value.setflags(write=False)
            return value, value.tolist()
        self.pair('noncontiguous-readonly', factory, True)
        value = factory([])[0]
        before = (value.dtype.str, value.shape, value.strides, value.flags.writeable, value.tobytes())
        snapshot = candidate.capture_value(value)
        after = (value.dtype.str, value.shape, value.strides, value.flags.writeable, value.tobytes())
        emit({'test': self.id(), 'label': 'source-array-immutable', 'kind': 'array_image',
              'before': {'dtype': before[0], 'shape': list(before[1]), 'strides': list(before[2]), 'writeable': before[3], 'bytes_hex': before[4].hex()},
              'after': {'dtype': after[0], 'shape': list(after[1]), 'strides': list(after[2]), 'writeable': after[3], 'bytes_hex': after[4].hex()}, 'mode': snapshot.mode})
        self.assertEqual(before, after)

