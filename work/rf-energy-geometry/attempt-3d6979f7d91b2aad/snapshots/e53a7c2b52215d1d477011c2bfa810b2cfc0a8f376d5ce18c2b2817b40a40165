OBSERVATIONS = []
_OBSERVER = None
DEPTH, NODES, CHARS = 32, 131072, 4 * 1024 * 1024


def set_observation_writer(writer):
    global _OBSERVER
    if writer is not None and not callable(writer):
        raise TypeError('observation writer must be callable or None')
    _OBSERVER = writer


def emit(row):
    if _OBSERVER is None:
        OBSERVATIONS.append(row)
    else:
        _OBSERVER(row)


def outcome(function):
    try:
        value = function()
    except Exception as error:
        return {'kind': 'error', 'module': type(error).__module__,
                'type': type(error).__qualname__, 'message': str(error)}, type(error)
    return {'kind': 'decision', 'type': type(value).__qualname__, 'value': value}, type(value)


def image(raw):
    return {'ascii_body': raw.decode('ascii'), 'bytes': len(raw),
            'sha256': hashlib.sha256(raw).hexdigest()}


def nested(depth, kind=list):
    value = 0
    for _ in range(depth):
        value = [value] if kind is list else {'x': value}
    return value


class Integer(int):
    pass


class Floating(float):
    pass


class Text(str):
    pass


class Opaque:
    pass


class ListHook(list):
    def __iter__(self):
        self.events.append(self.label)
        if self.error:
            raise RuntimeError(self.error)
        return super().__iter__()


class DictHook(dict):
    def items(self):
        self.events.append(self.label)
        if self.error:
            raise RuntimeError(self.error)
        return super().items()


class ArrayHook(np.ndarray):
    def tolist(self):
        self.events.append(self.label)
        if self.error:
            raise RuntimeError(self.error)
        return self.payload


class ScalarHook(np.float64):
    def item(self):
        self.events.append(self.label)
        if self.error:
            raise RuntimeError(self.error)
        return self.payload


def hooked(cls, events, label, payload=None, error=None):
    value = np.array([1.]).view(cls) if cls is ArrayHook else cls(1.) if cls is ScalarHook else cls(payload)
    value.events, value.label, value.error, value.payload = events, label, error, payload
    return value


class Engine:
    def __init__(self, events, name):
        self.events, self.name = events, name
        self.values = {'last_origin': (2013, 1), 'ratings': {'A': 1., 'B': -0.},
                       'offense': {'A': 2., 'B': 3.}, 'defense': {'A': 4., 'B': 5.}}
        self.fail_field = None

    def __getattr__(self, field):
        if field not in self.values:
            raise AttributeError(field)
        self.events.append(self.name + '.' + field)
        if field == self.fail_field:
            raise RuntimeError(self.name + '.' + field + ' failed')
        return self.values[field]


class Outputs(dict):
    def __iter__(self):
        self.events.append('outputs.keys')
        return super().__iter__()

    def __getitem__(self, key):
        self.events.append('output.' + str(key[1]))
        return super().__getitem__(key)


class Engines(dict):
    def items(self):
        self.events.append('engines.items')
        return super().items()


class Bank:
    def __init__(self, events):
        self.events = events
        self.owned = Engines({('E3', i, 'full'): Engine(events, 'engine.' + str(i)) for i in (11, 10)})
        self.owned.events = events

    @property
    def engines(self):
        self.events.append('bank.engines')
        return self.owned


def bank_fixture(events):
    bank = Bank(events)
    outputs = Outputs({('E3', i, 'full'): {'forecasts': [{'game_id': 'game-' + str(i), 'mean': [19., 23.]}],
                                         'failure': None} for i in (11, 0, 10)})
    outputs.events = events
    return bank, outputs


class SnapshotTests(unittest.TestCase):
    def pair(self, label, factory, expected=None, modes=None, bank=False):
        records = {}
        returned_types = {}
        for route in ('original', 'candidate'):
            events, images, snapshots = [], [], []
            left, right = factory(events)
            def run():
                if route == 'original':
                    def capture(value):
                        if bank:
                            digest = original_bank_digest(*value)
                            images.append({'sha256': digest})
                        else:
                            raw = original_strict(value)
                            images.append(image(raw))
                            digest = hashlib.sha256(raw).hexdigest()
                        return digest
                else:
                    def capture(value):
                        result = candidate.capture(*value) if bank else candidate.capture_value(value)
                        snapshots.append({'mode': result.mode})
                        return result
                before = capture(left)
                events.append('assembly')
                after = capture(right)
                return before == after if route == 'original' else candidate.same(before, after)
            result, result_type = outcome(run)
            records[route] = {'outcome': result, 'events': list(events), 'images': images, 'snapshots': snapshots}
            returned_types[route] = result_type
        emit({'test': self.id(), 'label': label, 'kind': 'paired_bank' if bank else 'paired_value',
              'original': records['original'], 'candidate': records['candidate'],
              'expected_decision': expected, 'expected_modes': modes,
              'reproducer': 'frozen test method and label; independently constructed route inputs'})
        self.assertIs(returned_types['candidate'], returned_types['original'], label)
        self.assertEqual(records['candidate']['outcome'], records['original']['outcome'], label)
        self.assertEqual(records['candidate']['events'], records['original']['events'], label)
        if expected is not None:
            self.assertEqual(records['original']['outcome'], {'kind': 'decision', 'type': 'bool', 'value': expected})
        if modes is not None:
            self.assertEqual([s['mode'] for s in records['candidate']['snapshots']], modes)
        return records

    def modes(self, label, factory, supported):
        value = factory()
        real_canonical, real_encoded = candidate.canonical, candidate.encoded
        with patch.object(candidate, 'canonical', wraps=real_canonical) as conversion, \
             patch.object(candidate, 'encoded', wraps=real_encoded) as fallback:
            snapshot = candidate.capture_value(value)
            observed = {'test': self.id(), 'label': label, 'kind': 'guard_boundary',
                        'mode': snapshot.mode, 'expected_mode': 'supported' if supported else 'fallback',
                        'canonical_calls': conversion.call_count, 'encoded_calls': fallback.call_count}
            emit(observed)
            self.assertEqual(snapshot.mode, observed['expected_mode'])
            self.assertEqual(conversion.call_count, 1)
            self.assertEqual(fallback.call_count, 0 if supported else 1)
        return snapshot

    def test_complete_bank_payload_and_sorted_access_order(self):
        result = self.pair('complete-current-bank-read', lambda events: (bank_fixture(events), bank_fixture(events)), True, ['supported']*2, True)
        one = ['outputs.keys', 'output.0', 'output.10', 'output.11', 'bank.engines', 'engines.items']
        one += ['engine.'+str(i)+'.'+field for i in (10, 11) for field in ('last_origin', 'ratings', 'offense', 'defense')]
        self.assertEqual(result['candidate']['events'], one + ['assembly'] + one)

    def test_every_output_and_owned_field_is_compared(self):
        for change in ('output', 'last_origin', 'ratings', 'offense', 'defense', 'output-membership', 'engine-membership'):
            def factory(events, change=change):
                left, right = bank_fixture(events), bank_fixture(events)
                bank, outputs = right
                if change == 'output':
                    dict.__getitem__(outputs, ('E3', 11, 'full'))['forecasts'][0]['mean'][-1] = 24.
                elif change == 'output-membership':
                    del outputs[('E3', 0, 'full')]
                elif change == 'engine-membership':
                    del bank.owned[('E3', 11, 'full')]
                elif change == 'last_origin':
                    bank.owned[('E3', 11, 'full')].values[change] = (2013, 2)
                else:
                    bank.owned[('E3', 11, 'full')].values[change]['B'] = 9.
                return left, right
            self.pair('bank-change-'+change, factory, False, ['supported']*2, True)

    def test_bank_payload_attribute_failure_order(self):
        for field in ('last_origin', 'ratings', 'offense', 'defense'):
            def factory(events, field=field):
                left, right = bank_fixture(events), bank_fixture(events)
                right[0].owned[('E3', 11, 'full')].fail_field = field
                dict.__getitem__(right[1], ('E3', 0, 'full'))['failure'] = 'early difference'
                return left, right
            result = self.pair('right-field-error-'+field, factory, bank=True)
            self.assertEqual(result['candidate']['outcome']['type'], 'RuntimeError')
            self.assertIn('assembly', result['candidate']['events'])
        def failed_before(events):
            left, right = bank_fixture(events), bank_fixture(events)
            left[0].owned[('E3', 11, 'full')].fail_field = 'defense'
            return left, right
        result = self.pair('bank-before-assembly-fails', failed_before, bank=True)
        self.assertNotIn('assembly', result['candidate']['events'])

