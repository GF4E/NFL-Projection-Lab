def digest(value):
    return hashlib.sha256(c.strict(value)).hexdigest()


def load_plan():
    path = ROOT / 'tests/research-score-split/test_run_unit.py'
    spec = importlib.util.spec_from_file_location('compute_controller_plan_fixture', path)
    module = importlib.util.module_from_spec(spec); spec.loader.exec_module(module)
    return module.original_plan()


class RoutingEnvelope:
    """Synthetic clock, not runtime/capacity evidence; no shared clock patches."""
    def __init__(self):
        self.now = .75
        self.peak_rss_mib = 64.
        self.phase_measurements = [
            {'name': 'admission', 'started_seconds': 0., 'finished_seconds': .25,
             'seconds': .25, 'error_type': None},
            {'name': 'inference_smoke', 'started_seconds': .25, 'finished_seconds': .75,
             'seconds': .5, 'error_type': None}]

    def elapsed(self): return self.now
    def check(self): pass
    def _after(self, error): self.check()
    def call(self, function, *args, **kwargs):
        self.now += .00001
        try: return function(*args, **kwargs)
        finally: self.now += .00001

    def work(self, duration, error=None):
        self.now += duration
        if error is not None: raise error
        return runtime.CallbackResult('EXPLICIT-NONNUMERICAL-ROUTING')


class SourceStructureTests(unittest.TestCase):
    def test_fixed_helpers_are_original_objects_and_composition_is_explicit(self):
        import research_score_split_compute_integration as integration
        import research_score_split_compute_preflight as preflight
        for name in ('ControllerEnvelope', 'run_smoke', '_suffix', '_bank_state_digest',
                     '_admission_evidence', 'publish_origin', 'validate_publication_binding',
                     '_saved_inference_inputs'):
            self.assertIs(getattr(c, name), getattr(original_controller, name))
        self.assertIs(c.assemble_forecasts, integration.assemble_forecasts)
        self.assertIs(c.PublishedOriginGrader, integration.PublishedOriginGrader)
        self.assertIs(c.preflight, preflight.preflight)
        self.assertIs(c.validate_runtime_files, preflight.validate_runtime_files)
        self.assertIs(c.OriginAccounting, runtime.OriginAccounting)
        self.assertIs(c.Store, runtime.Store)

    def test_copied_functions_have_only_registered_ast_changes(self):
        old = ast.parse(Path(original_controller.__file__).read_bytes())
        new = ast.parse(Path(c.__file__).read_bytes())
        functions = lambda tree: {n.name: n for n in tree.body if isinstance(n, ast.FunctionDef)}
        left, right = functions(old), functions(new)
        self.assertEqual(set(right), {'_launch', '_chronological_origins', 'run', '_worker_main'})
        for name in right:
            expected, actual = copy.deepcopy(left[name]), copy.deepcopy(right[name])
            if name in ('_chronological_origins', 'run'):
                expected.body = [n for n in expected.body if not isinstance(n, (ast.Import, ast.ImportFrom))]
            if name == '_launch':
                for node in ast.walk(expected):
                    if isinstance(node, ast.Constant) and type(node.value) is str:
                        node.value = node.value.replace('One accepted RF-02F worker', 'One accepted RF-COMP-04 worker')
                        if node.value == 'rf02f-observer-': node.value = 'rfcomp04-observer-'
            if name == 'run':
                for node in ast.walk(expected):
                    if isinstance(node, ast.Constant) and node.value == 'rf02f.terminal.v1':
                        node.value = 'rfcomp04.terminal.v1'
                additions = ast.parse('envelope.call(validate_runtime_files, envelope.check)\n'
                                      'envelope.call(bound, ROOT / COMPUTE_PROTOCOL_PATH, COMPUTE_PROTOCOL_SHA)').body
                body = next(n for n in expected.body if isinstance(n, ast.Try)).body
                anchor = ast.parse('envelope.call(bound, ROOT/CONFIG, CONFIG_SHA)').body[0]
                indices = [i for i, n in enumerate(body) if ast.dump(n) == ast.dump(anchor)]
                self.assertEqual(len(indices), 1)
                body[indices[0]+1:indices[0]+1] = additions
            self.assertEqual(ast.dump(actual, include_attributes=False),
                             ast.dump(expected, include_attributes=False), name)
        source = Path(c.__file__).read_text()
        self.assertLess(source.index("if __name__ == '__main__' and '--watchdog-phase-file'"),
                        source.index('from research_score_conditional_admission import'))
        self.assertNotIn('FunctionType', source)
        self.assertNotIn('__globals__', source)


class ChronologyTests(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.origins = load_plan()

    def scenario(self, *, reject_pilot=False, wrong_origin=False, fail_grade=False):
        origins = self.origins
        trace, selected, fed, advanced, published, graded = [], {}, [], [], [], []
        context = SimpleNamespace(origins=origins, teams=('AAA', 'BBB'), expected_by_season={
            y: [g for o in origins if o['season'] == y for g in o['targetGameIds']] for y in range(2010, 2026)})
        manifest = {'explicit_synthetic_dispatch_only': True}
        manifest_sha = digest(manifest)
        envelope = RoutingEnvelope()
        accounting = runtime.OriginAccounting(envelope, origins)
        progress = {'phase': 'synthetic_start', 'completed_origins': 0,
                    'counts': dict.fromkeys(c.COUNT_KEYS, 0), 'artifacts': {}}
        def event(kind, original, **extra):
            trace.append({'kind': kind, 'origin': [original['season'], original['week']], **extra})
        test = self

        class Feed:
            def __init__(self, ctx): test.assertIs(ctx, context)
            def select(self, year, expected):
                test.assertNotIn(year, selected); test.assertIs(expected, context.expected_by_season)
                test.assertTrue(all(o['season'] < year for o in graded))
                test.assertEqual([o for o in fed if o['season'] in (year-2, year-1)],
                                 [o for o in origins if o['season'] in (year-2, year-1)])
                selected[year] = {'setting': 0, 'inner_seasons': [year-2, year-1], 'routing_only': True}
                event('select_before_current_labels', {'season': year, 'week': 1})
                return {'E3': selected[year]}
            def add(self, original, rows, receipt):
                test.assertIs(graded[-1], original); test.assertNotIn(original, fed)
                test.assertTrue(2011 <= original['season'] <= 2024)
                test.assertEqual(receipt['origin'], [original['season'], original['week']])
                test.assertEqual(rows, [['E3', i, game] for game in original['targetGameIds'] for i in range(27)])
                fed.append(original); event('feed_after_saved_grade', original)

        class Bank:
            def __init__(self, teams):
                test.assertEqual(teams, context.teams)
                self.engines = {('E3', i, v): SimpleNamespace(last_origin=None, ratings=[], offense=[], defense=[])
                    for i in range(27) for v in replay._STATE_VARIANTS if i >= 9 or v in replay._ZERO_VARIANTS}
                test.assertEqual(len(self.engines), 216)
            def advance(self, year, week, prepared, diagonal):
                original = origins[len(advanced)]
                test.assertEqual((year, week), (original['season'], original['week']))
                test.assertIs(prepared, original); test.assertEqual(len(diagonal), 81)
                if year >= 2013: test.assertIn(year, selected)
                for engine in self.engines.values(): engine.last_origin = (year, week)
                advanced.append(original); event('advance', original)
                return {**diagonal, **{key: {'routing_state': [year, week]} for key in self.engines}}

        def forecast(ctx, original, check):
            test.assertIs(ctx, context); check(); event('forecast_inputs', original)
            mappers = {}
            for delay in (12, 24):
                payload = {'synthetic_mapper_only': delay}; h = digest(payload)
                mappers[delay] = {'payload': payload, 'pointer': {'name': 'object-'+h+'.json', 'sha256': h}}
            return {'origin': {**original, 'week': 2} if wrong_origin else original,
                'mapper_sources': mappers, 'bank_prepared': original,
                'diagonal_outputs': {('E3', i, v): {'routing_state': [original['season'], original['week']]}
                                     for i, v in replay._DIAGONAL_KEYS},
                'source_pointers': {'synthetic_only': True}}

        def assemble(view, bank, outputs, choice, **kwargs):
            original = view['origin']; year = original['season']; ids = original['targetGameIds']
            test.assertEqual(choice, selected.get(year)); test.assertEqual(len(outputs), 297)
            test.assertIs(kwargs['accounting'], accounting)
            event('composed_assembler_dispatch', original)
            if (year, original['week']) in ((2013, 1), (2013, 2)):
                accounting.callback('fit', lambda: envelope.work(.001), game_id=ids[0], setting=9,
                    variant='full', stage='inner', operation='fit')
                if reject_pilot and original['week'] == 2:
                    with test.assertRaisesRegex(ValueError, 'intentional_callback_failure'):
                        accounting.callback('fit', lambda: envelope.work(.008, ValueError('intentional_callback_failure')),
                            game_id=ids[0], setting=10, variant='full', stage='inner', operation='fit')
            return {'full_setting_forecasts': [['E3', i, g] for g in ids for i in range(27)]
                        if 2011 <= year <= 2024 else [],
                    'outer_selected_forecasts': [[family, variant, g]
                        for family, variant in [('E3', v) for v in runtime.SPLIT_VARIANTS] + list(RAW_REFERENCES)
                        for g in ids] if year >= 2013 else [], 'synthetic_routing_only': True}

        def publish(store, man, sha, view, bank, outputs, assembly, env):
            original = view['origin']; suffix = c._suffix(original)
            test.assertEqual(sha, manifest_sha); test.assertNotIn(original, published)
            value = {'manifest_sha256': sha, 'origin': [original['season'], original['week']], **assembly}
            store.write('forecast-'+suffix+'.json', value)
            pointer = store.pointer('forecast-'+suffix+'.json')
            store.write('publication-binding-'+suffix+'.json', {'publication': pointer, 'manifest_sha256': sha})
            test.assertEqual(store.read_bound(pointer), value)
            os.fsync(store.fd); published.append(original); event('published_fsynced', original)
            return pointer

        def validate(store, man, sha, view, assembly, pointer, env):
            value = store.read_bound(pointer)
            test.assertEqual(value['manifest_sha256'], sha)
            test.assertEqual(value['origin'], [view['origin']['season'], view['origin']['week']])
            return value, store.read_bound(store.pointer('publication-binding-'+c._suffix(view['origin'])+'.json'))

        class Grader:
            last_attempt_origin = None
            last_attempt_counts = None
            def grade(self, store, man, sha, view, assembly, pointer, ctx, acc, *, validate_binding):
                original = view['origin']; year = original['season']; n = len(original['targetGameIds'])
                self.last_attempt_origin = [year, original['week']]
                validate_binding(); test.assertIs(published[-1], original); test.assertNotIn(original, graded)
                event('grade_after_publication', original)
                inner, outer = assembly['full_setting_forecasts'], assembly['outer_selected_forecasts']
                counts = dict(inner_rows=len(inner), outer_rows=len(outer), copied_diagonal_inner=9*n if inner else 0,
                    scored_inner=18*n if inner else 0, copied_e3_outer=11*n if outer else 0,
                    scored_outer=2*n if outer else 0, copied_raw_outer=6*n if outer else 0,
                    actual_score_calls=(18*n if inner else 0)+(2*n if outer else 0),
                    actual_mass_cdf_calls=13*n*8 if outer else 0)
                self.last_attempt_counts = counts
                if fail_grade and (year, original['week']) == (2013, 1):
                    raise ValueError('synthetic_current_grader_failure')
                if (year, original['week']) in ((2013, 1), (2013, 2)):
                    acc.callback('score', lambda: envelope.work(.002), game_id=original['targetGameIds'][0],
                        setting=0, variant='zero_strength_update', stage='outer', operation='score',
                        double_grid=True, diagnostics=True)
                name = 'routing-grade-'+c._suffix(original)+'.json'
                store.write(name, {'routing_only': True, 'inner_keys': inner, 'outer_keys': outer, 'counts': counts})
                saved = store.read_bound(store.pointer(name)); os.fsync(store.fd)
                graded.append(original); event('graded_fsynced', original)
                return {'inner_rows': saved['inner_keys'], 'outer_rows': saved['outer_keys'], 'counts': counts,
                        'grading_receipt': {'origin': [year, original['week']], 'routing_only': True},
                        'artifacts': {'routing_only': store.pointer(name)}}

        def pilot(plan, ledger, suffix):
            test.assertEqual(len(ledger['origins']), 53); test.assertEqual(suffix, origins[53:])
            projection = runtime.pilot_projection(plan, ledger, suffix)
            test.assertIs(projection['within_time_screen'], True)
            test.assertEqual(projection['failed_callback_count'], 1 if reject_pilot else 0)
            event('real_formula_synthetic_cost_pilot', origins[52], remaining_origins=len(suffix))
            return {**projection, 'within_time_screen': False, 'synthetic_forced_rejection': True} if reject_pilot else projection

        with tempfile.TemporaryDirectory() as directory:
            store = runtime.Store(Path(directory).resolve(), 'rfcomp04-routing-only')
            try:
                with ExitStack() as stack:
                    for name, replacement in [('forecast_inputs', forecast), ('StrictSelectionFeed', Feed),
                        ('SplitTrajectoryBank', Bank), ('assemble_forecasts', assemble), ('PublishedOriginGrader', Grader),
                        ('publish_origin', publish), ('validate_publication_binding', validate), ('pilot_projection', pilot)]:
                        stack.enter_context(patch.object(c, name, replacement))
                    error = None
                    try: c._chronological_origins(context, store, manifest, manifest_sha, {}, envelope, accounting, progress)
                    except ValueError as exc: error = str(exc)
                count = 0 if wrong_origin else 51 if fail_grade else 53 if reject_pilot else 277
                self.assertEqual(progress['completed_origins'], count)
                self.assertEqual(graded, origins[:count])
                self.assertEqual(advanced, origins[:count + int(fail_grade)])
                self.assertEqual(published, origins[:count + int(fail_grade)])
                self.assertEqual(len(accounting.snapshot()['origins']), count + int(fail_grade or wrong_origin))
                self.assertEqual('origin-index.json' in store.index, not (wrong_origin or fail_grade or reject_pilot))
                self.assertTrue(all(2011 <= o['season'] <= 2024 for o in fed))
                if count == 277:
                    index = store.read_bound(store.pointer('origin-index.json'))
                    self.assertEqual(index['counts'], progress['counts']); self.assertEqual(len(index['origins']), 277)
                    self.assertEqual(sum(len(o['targetGameIds']) for o in graded), 4175)
                    self.assertEqual(progress['counts']['inner_rows'], 98469)
                    self.assertEqual(progress['counts']['outer_rows'], 64733)
                    self.assertEqual(len(fed), 242); self.assertEqual(list(selected), list(range(2013, 2026)))
                with self.assertRaisesRegex(ValueError, 'nonchronological_or_nested_origin'):
                    with accounting.origin(origins[0]): pass
                CONTROLLER_TEST_EVIDENCE.append({'scope': 'synthetic_dispatch_only_no_numeric_evidence',
                    'reject_pilot': reject_pilot, 'wrong_origin': wrong_origin, 'fail_grade': fail_grade,
                    'completed_origins': count, 'counts': progress['counts'], 'expected_error': error,
                    'trace': trace, 'store_index': dict(store.index),
                    'limitations': 'Artificial clock and scientific routing seams; actual Store and OriginAccounting only.'})
                return error, progress, trace
            finally: store.close()

    def test_complete_277_origin_4175_game_order_and_dispatch_counts(self):
        error, progress, trace = self.scenario()
        self.assertIsNone(error)
        self.assertEqual([x['origin'] for x in trace if x['kind'] == 'advance'],
                         [[o['season'], o['week']] for o in self.origins])

    def test_actual_pilot_formula_retains_53_prefix_and_stops_224_suffix(self):
