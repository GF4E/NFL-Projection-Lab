class TerminalFlowTests(unittest.TestCase):
    def setUp(self):
        self.temp = tempfile.TemporaryDirectory(); self.addCleanup(self.temp.cleanup)
        self.folder = Path(self.temp.name).resolve(); self.phase = self.folder/'phase.json'
        watchdog._write_phase(self.phase, {'version': 'rf02f.owned-phase.v1', 'owner': 'a'*32,
            'phase': 'starting', 'smoke_started': None, 'smoke_finished': None}, initial=True)
        manifest = {'version': 'rfcomp04.synthetic-controller-test.v1',
            'parent_manifest_sha256': c.PARENT_MANIFEST, 'parent_index_sha256': c.PARENT_INDEX,
            'bound_hashes': {'config': c.CONFIG_SHA}, 'code_hashes': {'synthetic-source.py': 'a'*64},
            'qualification': {'synthetic': True}, 'independent_reviews': {'synthetic': True}}
        self.ready = {'manifest': manifest, 'manifest_sha256': digest(manifest),
                      'identity': 'rfcomp04-synthetic-terminal', 'config': {}}
        self.context = SimpleNamespace(origins=[])
        self.evaluation = {'status': 'reject_all', 'synthetic_terminal_only': True}
        self.ledger = SimpleNamespace(_origins=[], snapshot=lambda: {'origins': []})
        self.checked = []

    @contextmanager
    def seams(self, **overrides):
        def bound(path, fingerprint, *args):
            self.checked.append(('bound', str(path), fingerprint)); return b'{}'
        def runtime_files(check):
            check(); self.checked.append(('runtime_files',))
        values = {'preflight': lambda *args: self.ready, 'admit_source': lambda *args: self.context,
                  'OUTPUT_PARENT': self.folder, '_admission_evidence': lambda *args: {'synthetic': True},
                  'run_smoke': lambda *args: {'synthetic': True}, 'OriginAccounting': lambda *args: self.ledger,
                  '_chronological_origins': lambda *args: [], '_saved_inference_inputs': lambda *args: ([], {}, []),
                  'evaluate': lambda *args: self.evaluation, 'bound': bound, 'validate_runtime_files': runtime_files}
        values.update(overrides)
        with ExitStack() as stack:
            for name, value in values.items(): stack.enter_context(patch.object(c, name, value))
            yield

    def execute(self):
        return c.run(c.ROOT, '/explicit-synthetic-unread-acceptance', 'e'*64, self.phase, time.monotonic())

    def terminal(self):
        return json.loads((self.folder/self.ready['identity']/'completion/terminal.json').read_bytes())

    def test_new_terminal_atomic_pair_and_post_science_source_runtime_protocol_checks(self):
        with self.seams(): result = self.execute()
        terminal = self.terminal()
        self.assertEqual(result['status'], 'reject_all'); self.assertEqual(terminal['version'], 'rfcomp04.terminal.v1')
        self.assertEqual(self.checked, [('bound', str(c.ROOT/'synthetic-source.py'), 'a'*64),
            ('bound', str(c.ROOT/c.CONFIG), c.CONFIG_SHA), ('runtime_files',),
            ('bound', str(c.ROOT/c.COMPUTE_PROTOCOL_PATH), c.COMPUTE_PROTOCOL_SHA)])
        index = json.loads((self.folder/self.ready['identity']/'completion/artifact-index.json').read_bytes())
        self.assertEqual(index['files']['completion/terminal.json']['sha256'], digest(terminal))
        self.assertEqual(index['uncommitted_artifacts'], []); self.assertEqual(index['uncommitted_staging'], [])
        CONTROLLER_TEST_EVIDENCE.append({'scope': 'synthetic_terminal_routing_only', 'terminal_version': terminal['version'],
                                         'source_runtime_protocol_checks': self.checked})

    def test_existing_identity_refuses_before_second_admission(self):
        with self.seams(): self.execute()
        def no_admission(*args): self.fail('second admission forbidden')
        with self.seams(admit_source=no_admission):
            with self.assertRaises(FileExistsError): self.execute()
        self.assertEqual(self.terminal()['status'], 'reject_all')

    def test_preflight_rejection_prevents_store_and_all_science(self):
        def reject(*args): raise ValueError('unaccepted_current_receipt')
        def forbidden(*args): self.fail('work before accepted preflight')
        with self.seams(preflight=reject, Store=forbidden, admit_source=forbidden, evaluate=forbidden):
            with self.assertRaisesRegex(ValueError, 'unaccepted_current_receipt'): self.execute()
        self.assertFalse((self.folder/self.ready['identity']).exists())

    def test_runtime_file_change_after_evaluation_forces_invalid_terminal(self):
        def changed(check): check(); raise ValueError('runtime_binary_changed')
        with self.seams(validate_runtime_files=changed): result = self.execute()
        self.assertEqual(result['status'], 'protocol_invalid')
        terminal = self.terminal()
        self.assertEqual(terminal['version'], 'rfcomp04.terminal.v1')
        self.assertEqual(terminal['reason'], 'runtime_binary_changed')
        self.assertIn('evaluation', terminal['artifacts'])

    def test_invalid_evaluation_payload_is_retained_before_invalid_terminal(self):
        self.evaluation = {'status': 'protocol_invalid', 'reason': 'synthetic_inference_failure', 'details': ['preserve']}
        with self.seams(): result = self.execute()
        self.assertEqual(result['status'], 'protocol_invalid')
        terminal = self.terminal(); pointer = terminal['artifacts']['evaluation']
        raw = (self.folder/self.ready['identity']/pointer['name']).read_bytes()
        self.assertEqual(hashlib.sha256(raw).hexdigest(), pointer['sha256'])
        self.assertEqual(json.loads(raw), self.evaluation)
        self.assertEqual(self.checked, [])

    def test_partial_ordinary_write_is_retained_as_invalid_evidence(self):
        class PartialStore(runtime.Store):
            def write(self, name, value):
                if name == 'admission.json':
                    self.uncommitted_artifacts.add(name)
                    fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600, dir_fd=self.fd)
                    with os.fdopen(fd, 'wb') as out: out.write(b'{"incomplete":'); out.flush(); os.fsync(out.fileno())
                    raise OSError('synthetic_partial_write')
                return super().write(name, value)
        with self.seams(Store=PartialStore): result = self.execute()
        self.assertEqual(result['status'], 'protocol_invalid')
        folder = self.folder/self.ready['identity']
        index = json.loads((folder/'completion/artifact-index.json').read_bytes())
        self.assertEqual(index['uncommitted_artifacts'], ['admission.json'])
        self.assertEqual((folder/'admission.json').read_bytes(), b'{"incomplete":')
        self.assertEqual(index['files']['admission.json']['sha256'], hashlib.sha256(b'{"incomplete":').hexdigest())

    def test_post_commit_failure_never_constructs_a_competing_terminal(self):
        class LateStore(runtime.Store):
            def finish(self, terminal, budget=None):
                super().finish(terminal, budget)
                raise OSError('synthetic_post_commit_fsync')
        class NoCompetingEnvelope(c.ControllerEnvelope):
            def finalize_invalid(self, *args): raise AssertionError('competing terminal forbidden')
        with self.seams(Store=LateStore, ControllerEnvelope=NoCompetingEnvelope):
            with self.assertRaisesRegex(OSError, 'synthetic_post_commit_fsync'): self.execute()
        self.assertEqual(self.terminal()['status'], 'reject_all')
        self.assertEqual(len(list((self.folder/self.ready['identity']).glob('completion'))), 1)

    def test_user_interrupt_survives_failed_metadata_finalization(self):
        class FailedClosure(c.ControllerEnvelope):
            def finalize_invalid(self, *args): raise OSError('synthetic_closure_failure')
        for kind in (KeyboardInterrupt, SystemExit):
            self.ready['identity'] = 'rfcomp04-synthetic-'+kind.__name__.lower()
            error = kind('preserve_original_interrupt')
            def interrupted(*args): raise error
            with self.seams(admit_source=interrupted, ControllerEnvelope=FailedClosure):
                try: self.execute()
                except BaseException as caught: self.assertIs(caught, error)
                else: self.fail('original interrupt lost')
            self.assertFalse((self.folder/self.ready['identity']/'completion').exists())


