    def test_exposed_2025_changes_only_prescribed_stability_point(self):
        values = decision_fixture()
        before = self.decide(values)
        for key, rows in values[2].items():
            for i, row in enumerate(rows):
                if values[1][i]['season'] == 2025:
                    row['joint_energy_score'] = 120. if key == ('E2C', 'full') else 100.
                    row['joint_nll'] = 1e6
                    row['home_width_80'] = 1e6
        after = self.decide(values)
        self.assertEqual(before['mapping_checks'], after['mapping_checks'])
        self.assertEqual(before['all_issued_native_failure_rates'], after['all_issued_native_failure_rates'])
        for key in before['stability']:
            for field in ('development_gain', 'season_gains', 'leave_one_season_out_gains'):
                self.assertEqual(before['stability'][key][field], after['stability'][key][field])
        self.assertFalse(after['candidate_qualified'])
        changed_checks = [name for name in before['candidate_checks'] if before['candidate_checks'][name] != after['candidate_checks'][name]]
        self.assertEqual(set(changed_checks), {'N0:full:exposed_2025_positive', 'N0C:full:exposed_2025_positive'})

