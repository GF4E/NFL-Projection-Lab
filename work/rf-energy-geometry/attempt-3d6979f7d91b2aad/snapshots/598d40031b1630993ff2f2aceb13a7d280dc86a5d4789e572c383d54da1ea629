    def test_point_secondary_width_and_coverage_boundaries(self):
        values = decision_fixture()
        for row in values[2]['E2C', 'full']:
            row['joint_energy_score'] = 99.
            row['joint_nll'] = 1.005 * 10.
            row['home_mae'] = 3.1
            for target in unit.TARGETS: row[target + '_width_80'] = 22.
        self.assertTrue(self.decide(values)['candidate_qualified'])
        values[2]['E2C', 'full'][0]['joint_nll'] += 1e-8
        self.assertFalse(self.decide(values)['candidate_qualified'])
        values = decision_fixture()
        for row in values[2]['E2C', 'full']:
            row['joint_energy_score'] = 98.
            row['home_width_80'] = 50.
        self.assertTrue(self.decide(values)['candidate_qualified'])
        for row in values[2]['E2C', 'full']: row['joint_energy_score'] = 98.01
        self.assertFalse(self.decide(values)['candidate_qualified'])
        for coverage, expected in ((.72, True), (.88, True), (.71999, False), (.88001, False)):
            values = decision_fixture()
            if coverage in (.72, .88):
                # Integer indicators yield exactly the registered boundary, avoiding
                # a sum of repeated non-binary synthetic coverage fractions.
                values[1][:] = [{'game_id': str(i), 'season': 2013 + i % 12, 'week': 1} for i in range(100)] + [
                                {'game_id': 'diagnostic', 'season': 2025, 'week': 1}]
                for key in values[2]:
                    values[2][key] = [dict(values[2][key][0]) for _ in values[1]]
                    values[3][key] = [False] * len(values[1])
                    for i, row in enumerate(values[2][key]):
                        for target in unit.TARGETS: row[target + '_coverage_80'] = float(i < 80)
                for i, row in enumerate(values[2]['E2C', 'full']):
                    row['home_coverage_80'] = float(i < round(100 * coverage))
            else:
                for row in values[2]['E2C', 'full']: row['home_coverage_80'] = coverage
            self.assertEqual(self.decide(values)['candidate_qualified'], expected)

