    config = configuration()
    mapped, raw, comparisons, cells = unit._registered(config)
    metadata = [{'game_id': f'{year}-{i}', 'season': year, 'week': i + 1}
                for year in unit.YEARS for i in range(5)]
    metrics, failures = {}, {}
    for key in mapped + raw:
        rows = []
        for row in metadata:
            energy = 98. if key[0] == 'E2C' else 100.
            result = {'joint_energy_score': energy, 'joint_nll': 10.}
            for target in unit.TARGETS:
                result.update({target + '_crps': 5., target + '_mae': 3.,
                               target + '_coverage_80': float(row['week'] <= 4), target + '_width_80': 20.})
            rows.append(result)
        metrics[key], failures[key] = rows, [False] * len(metadata)
    inference = {'comparisons': {}, 'calibration_cells': {}}
    for name, ref, candidate in comparisons:
        removal = ref[0] == candidate[0]
        lo, hi = (-.02, -.001) if removal else (.001, .03)
        inference['comparisons'][name] = {'gain': .02, 'blocks': {
            str(length): {'lower': lo, 'upper': hi, 'bootstrap_sd': .01} for length in unit.LENGTHS}}
    for cell in cells:
        inference['calibration_cells'][':'.join(map(str, cell))] = {'residual': 0., 'blocks': {
            str(length): {'lower': -.01, 'upper': .01, 'bootstrap_sd': .01} for length in unit.LENGTHS}}
    return config, metadata, metrics, failures, mapped, inference


def production_fixture():
    config = configuration()
    mapped, raw, _, _ = unit._registered(config)
    metadata = []
    for year, count in zip(unit.YEARS, unit.YEAR_COUNTS):
        weeks = 17 if year <= 2020 else 18
        for week in range(1, weeks + 1):
            for i in range(count // weeks + (week <= count % weeks)):
                metadata.append({'game_id': f'{year}-{week}-{i}', 'season': year, 'week': week})
    base = {'joint_energy_score': 2., 'joint_nll': 3., 'home_win_probability': .4, 'tie_probability': .2,
            'away_win_probability': .4, 'home_win_observed': 0., 'predicted_covariance': .1, 'residual_product': .2,
            'grid_cells': [8, 8], 'grid_transport_bound': 1e-8, 'grid_probability_bound': 1e-10,
            'double_grid_difference': 1e-10, 'home_win_brier': .16, 'home_win_log_loss': .51,
            'win_tie_loss_brier': .5, 'win_tie_loss_log_loss': .92,
            'tail_absolute_margin_21': .01, 'tail_total_70': .02,
            'observed_absolute_margin_21': 0., 'observed_total_70': 0.}
    for target, observed in zip(unit.TARGETS, (1., 2., -1., 3.)):
        base.update({target + '_observed': observed, target + '_mean': observed + .1,
                     target + '_crps': 1., target + '_mae': .1, target + '_squared_error': .01,
                     target + '_pit': .5})
        for level in unit.LEVELS:
            suffix = str(round(100 * level))
            base.update({f'{target}_lower_{suffix}': -2, f'{target}_upper_{suffix}': 4,
                         f'{target}_coverage_{suffix}': 1., f'{target}_width_{suffix}': 6,
                         f'{target}_boundary_distance_{suffix}': .01})
    rows = {}
    for key in mapped + raw:
        row_metrics = dict(base)
        if key in mapped:
            row_metrics.update({target + '_interval_mass_80': .83 for target in unit.TARGETS})
        rows[key] = [{'game_id': row['game_id'], 'native_failure': None, 'metrics': dict(row_metrics)} for row in metadata]
    return config, metadata, rows, {name: True for name in unit.AUDITS}


class InferenceTests(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.started = time.monotonic()

    @classmethod
    def tearDownClass(cls):
        elapsed = time.monotonic() - cls.started
        rss = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss / (1024 ** 2 if sys.platform == 'darwin' else 1024)
        if elapsed > 120 or rss > 4096:
            raise AssertionError(f'synthetic_budget_exceeded: seconds={elapsed}, rss_mib={rss}')

    def decide(self, values):
        _, metadata, metrics, failures, mapped, inference = values
        return unit._decision(metadata, metrics, failures, mapped, inference)

    def test_exact_registered_order_and_families(self):
        config = configuration()
        mapped, raw, comparisons, cells = unit._registered(config)
        self.assertEqual((len(mapped), len(raw), len(comparisons), len(cells)), (20, 6, 28, 16))
        self.assertEqual(comparisons[0], ('N0C:full->N0C:no_home_effect', ('N0C', 'full'), ('N0C', 'no_home_effect')))
        self.assertEqual(comparisons[-1], ('S1:full->E2C:full', ('S1', 'full'), ('E2C', 'full')))
        for field in ('series', 'raw_references', 'comparisons', 'calibration_cells'):
            for operation in ('drop', 'duplicate', 'reverse'):
                changed = copy.deepcopy(config)
                if operation == 'drop': changed[field].pop()
                elif operation == 'duplicate': changed[field][-1] = changed[field][0]
                else: changed[field].reverse()
                with self.subTest(field=field, operation=operation), self.assertRaises(unit.InferenceFailure):
                    unit._registered(changed)
        changed = copy.deepcopy(config)
        changed['inference']['members'] = 8
        self.assertEqual(unit.evaluate(changed, [], {}, {})['status'], 'protocol_invalid')

    def test_paired_ratio_recomputed_with_shared_counts_and_separate_families(self):
        losses = np.array([[1., 2., 1.], [3., 1., 2.], [4., 5., 2.], [2., 1., 3.]])
        residuals = np.array([[.2, -.8], [-.8, .2], [.1, -.9], [.1, .1]])
        groups = np.array([0, 0, 1, 2])
        counts = np.array([[1, 1, 1], [2, 0, 1], [0, 2, 1], [1, 0, 2], [2, 1, 0]])
        references, candidates = np.array([0, 0, 1]), np.array([1, 2, 2])
        result = unit.paired_block_statistics(losses, residuals, counts, groups, references, candidates)
        expected_gains, expected_residuals = [], []
        for row in counts:
            multiplicities = row[groups]
            means = np.average(losses, axis=0, weights=multiplicities)
            expected_gains.append(1 - means[candidates] / means[references])
            expected_residuals.append(np.average(residuals, axis=0, weights=multiplicities))
        np.testing.assert_allclose(result['sampled_gains'], expected_gains, rtol=0, atol=1e-15)
        np.testing.assert_allclose(result['sampled_residuals'], expected_residuals, rtol=0, atol=1e-15)
        self.assertFalse(np.allclose(result['sampled_gains'][0], np.mean(1 - losses[:, candidates] / losses[:, references], axis=0)))
        expected_energy = unit.simultaneous_intervals(result['gains'], np.array(expected_gains))
        expected_calibration = unit.simultaneous_intervals(result['residuals'], np.array(expected_residuals))
        for actual, expected in zip(result['energy'], expected_energy): np.testing.assert_allclose(actual, expected)
        for actual, expected in zip(result['calibration'], expected_calibration): np.testing.assert_allclose(actual, expected)
        self.assertNotEqual(result['energy'][3], result['calibration'][3])

    def test_block_invalid_denominators_counts_and_nonfinites(self):
        good = (np.array([[1., 2.], [2., 1.]]), np.array([[.1], [-.1]]), np.array([[1, 1], [2, 1]]),
                np.array([0, 1]), np.array([0]), np.array([1]))
        for position, value in ((0, [[0., 2.], [0., 1.]]), (0, [[np.nan, 2.], [2., 1.]]),
                                (2, [[0, 0], [1, 1]]), (2, [[.5, 1], [1, 1]]),
                                (2, [[-1, 2], [1, 1]]), (3, [0, 2]), (4, [True])):
            args = list(good); args[position] = value
            with self.subTest(position=position), self.assertRaises(unit.InferenceFailure):
                unit.paired_block_statistics(*args)

    def test_each_count_matrix_reused_for_28_energy_and_16_actual_mass_cells(self):
        mapped, raw, comparisons, cells = unit._registered(configuration())
        metadata = [{'game_id': 'a', 'season': 2013, 'week': 1}, {'game_id': 'b', 'season': 2013, 'week': 2}]
        metrics = {}
        for index, key in enumerate(mapped + raw):
            metrics[key] = []
            for i in range(2):
                row = {'joint_energy_score': 10. + index + i * (1 + index / 10)}
                for target in unit.TARGETS:
                    row[target + '_interval_mass_80'] = .6
                    row[target + '_pit'] = .2 + i * .6
                    for level in unit.LEVELS:
                        row[f'{target}_coverage_{round(100 * level)}'] = float(i == 0)
                metrics[key].append(row)
        counts = np.resize(np.array([[1, 1], [2, 0], [0, 2]], dtype=np.int16), (10000, 2))
        calls = []
        def weights(meta, length, **kwargs):
            calls.append((meta, length, kwargs))
            return counts.copy(), np.array([0, 1]), [(2013, 1), (2013, 2)]
        real_intervals = unit.simultaneous_intervals
        shapes = []
        def intervals(point, sampled):
            shapes.append((len(point), sampled.shape))
            return real_intervals(point, sampled)
        with patch.object(unit, 'block_weights', side_effect=weights), \
             patch.object(unit, 'simultaneous_intervals', side_effect=intervals):
            result = unit._infer(metadata, metrics, mapped, raw, comparisons, cells)
        self.assertEqual([call[1] for call in calls], [1, 3, 6])
        self.assertTrue(all(call[2] == {'members': 10000, 'required_seasons': 12} for call in calls))
        self.assertEqual(shapes, [(28, (10000, 28)), (16, (10000, 16))] * 3)
        self.assertTrue(all(abs(cell['residual'] + .1) < 1e-15 for cell in result['calibration_cells'].values()))
        self.assertEqual(len(result['blocks']['1']['coverage']), 240)
        self.assertEqual(len(result['blocks']['1']['pit_simultaneous_bands']), 80)
        with patch.object(unit, 'block_weights', return_value=(counts[:2], np.array([0, 1]), [(2013, 1), (2013, 2)])):
            with self.assertRaisesRegex(unit.InferenceFailure, 'production_bootstrap_member_count'):
                unit._infer(metadata, metrics, mapped, raw, comparisons, cells)

