    def test_structural_unavailability_must_match_actual_constant_predictor(self):
        rows = [{**{target + '_mean': 1. for target in unit.TARGETS}, 'home_win_probability': .5} for _ in range(3)]
        valid = {target: {'status': 'unavailable_by_design', 'reason': 'constant_predictor', 'rank': 1,
                         'prediction_min': .5 if target == 'home_win' else 1.,
                         'prediction_max': .5 if target == 'home_win' else 1., 'n': 3}
                 for target in (*unit.TARGETS, 'home_win')}
        unit._validate_calibration(valid, rows)
        for field, value in (('reason', 'failed'), ('rank', True), ('prediction_max', 2.), ('n', True),
                             ('status', 'diagnostic_failure')):
            changed = copy.deepcopy(valid); changed['home'][field] = value
            with self.assertRaises(unit.InferenceFailure): unit._validate_calibration(changed, rows)
        rows[0]['home_mean'] = 1.01
        with self.assertRaisesRegex(unit.InferenceFailure, 'unsubstantiated'):
            unit._validate_calibration(valid, rows)

    def test_production_membership_validation_and_missing_audit_fail_closed(self):
        config, metadata, rows, audits = production_fixture()
        result = unit._validate(config, metadata, rows, audits)
        self.assertEqual((len(result[0]), len(result[1])), (20, 6))
        with self.assertRaises(unit.InferenceFailure): unit._validate(config, metadata[:-1], rows, audits)
        for value in (False, 1, None):
            changed = dict(audits); changed['leakage'] = value
            with self.assertRaisesRegex(unit.InferenceFailure, 'required_audit_failure'):
                unit._validate(config, metadata, rows, changed)
        self.assertEqual(unit.evaluate(config, [], {}, audits)['status'], 'protocol_invalid')
        first = rows['E2C', 'full'][0]
        old = first['game_id']; first['game_id'] = 'wrong'
        with self.assertRaisesRegex(unit.InferenceFailure, 'alignment'):
            unit._validate(config, metadata, rows, audits)
        first['game_id'] = old
        first['metrics']['home_interval_mass_80'] = 1.1
        with self.assertRaisesRegex(unit.InferenceFailure, 'interval_mass'):
            unit._validate(config, metadata, rows, audits)
        first['metrics']['home_interval_mass_80'] = .83
        rows['N0C', 'full'][0]['native_failure'] = 'unexpected'
        with self.assertRaisesRegex(unit.InferenceFailure, 'required_N0'):
            unit._validate(config, metadata, rows, audits)

    def test_evaluate_filters_development_before_inference(self):
        config, metadata, rows, audits = production_fixture()
        fake_card = {'games': 3135, 'metrics': {}, 'calibration': {}, 'pit': {}}
        captured = []
        def infer(dev_metadata, dev_metrics, mapped, raw, comparisons, cells):
            captured.append((len(dev_metadata), max(row['season'] for row in dev_metadata),
                             len(dev_metrics['E2C', 'full']), dev_metrics['E2C', 'full'][0]['joint_energy_score']))
            return {'synthetic': True}
        with patch.object(unit, 'aggregate', return_value=fake_card), \
             patch.object(unit, '_validate_calibration'), patch.object(unit, '_infer', side_effect=infer), \
             patch.object(unit, '_decision', return_value={'status': 'reject_all'}):
            first = unit.evaluate(config, metadata, rows, audits)
            for key in rows:
                for i, row in enumerate(rows[key]):
                    if metadata[i]['season'] == 2025: row['metrics']['joint_energy_score'] = 1e9
            second = unit.evaluate(config, metadata, rows, audits)
        self.assertEqual(first['status'], 'reject_all')
        self.assertEqual(second['status'], 'reject_all')
        self.assertEqual(captured, [(3135, 2024, 3135, 2.), (3135, 2024, 3135, 2.)])


