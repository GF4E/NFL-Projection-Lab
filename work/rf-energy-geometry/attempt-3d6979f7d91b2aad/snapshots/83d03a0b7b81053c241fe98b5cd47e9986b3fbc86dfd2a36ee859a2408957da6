    def test_pointer_hash_and_size_fail_before_reader(self):
        good = {'path': 'synthetic-pointer.json', 'sha256': 'a' * 64, 'bytes': 1}
        mutations = [('sha256', x) for x in (None, True, 1, '', 'a' * 63, 'g' * 64)]
        mutations += [('bytes', x) for x in (None, True, 1.0, -1, 0, '1')]
        for field, value in mutations:
            pointer = dict(good); pointer[field] = value
            called = []
            with self.subTest(field=field, value=value), self.assertRaises(ValueError):
                p._pointer(pointer, ROOT, lambda: None, read=lambda *a, **k: called.append(True))
            self.assertEqual(called, [])
