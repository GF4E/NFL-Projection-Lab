    def test_injected_fft_and_geometry_errors_no_retry_or_eviction(self):
        for alias in ('_rfft2', '_irfft2', '_build_distance'):
            owner = candidate.LagGeometry()
            for shape in ((2, 2), (3, 3)):
                owner.energy_score(*fixture(dirac(shape)))
            before = owner.cache_info()
            error = RuntimeError('injected '+alias)
            with patch.object(candidate, alias, side_effect=error) as failing:
                actual, actual_type = call(lambda: owner.energy_score(*fixture(dirac((5, 5)))))
                after = owner.cache_info()
                emit({'test': self.id(), 'label': 'injection-'+alias, 'kind': 'deliberate_injection', 'result': actual,
                      'calls': failing.call_count, 'cache_before': before, 'cache_after': after})
                self.assertIs(actual_type, RuntimeError); self.assertEqual(actual['outcome']['message'], str(error))
                self.assertEqual(failing.call_count, 1)
                self.assertEqual(after['entries'], before['entries']); self.assertEqual(after['evictions'], before['evictions'])
                self.assertEqual(after['misses'], before['misses'] + int(alias == '_build_distance'))
            self.compare('valid-after-'+alias, lambda events: fixture(dirac((5, 5))), owner)

