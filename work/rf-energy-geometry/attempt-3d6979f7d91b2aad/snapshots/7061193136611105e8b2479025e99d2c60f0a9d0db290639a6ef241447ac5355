    def test_original_fallback_grid_and_observation_hook_order(self):
        for fail_grid, fail_index in ((False, None), (True, None), (False, 0), (False, 1)):
            def factory(events, fail_grid=fail_grid, fail_index=fail_index):
                y = ObservedHook([1., 2.]); y.events = events; y.fail = fail_index
                return GridHook(dirac((2, 2)), events, fail_grid), y
            _, rows = self.compare('fallback-hooks-'+str(fail_grid)+'-'+str(fail_index), factory, expect_fallback=True)
            expected = ['grid.probability']
            if not fail_grid:
                expected.append('observed.0')
                if fail_index != 0: expected.append('observed.1')
            self.assertEqual(rows['candidate']['events'], expected)

