    def test_full_scorer_metrics_and_single_skellam_wrap(self):
        def law(independent):
            return JointDistribution(np.array([[0., 0.]]), np.array([0.]), 1., np.array([.8, 1.1]), np.zeros(2), 0, independent)
        for independent in (False, True):
            for double_grid, diagnostics in ((False, False), (True, False), (True, True)):
                owner = candidate.LagGeometry(); left, right = law(independent), law(independent)
                before = {f: image(getattr(right, f)) for f in ('atoms','alpha','rates','theta')}
                old, old_type = call(lambda: original_score(left, [2, 1], 'synthetic-energy-'+str(independent), double_grid=double_grid, diagnostics=diagnostics))
                real_wrapper = candidate.SkellamDistribution
                with patch.object(candidate, 'SkellamDistribution', wraps=real_wrapper) as wrapper:
                    new, new_type = call(lambda: owner.score_forecast(right, [2, 1], 'synthetic-energy-'+str(independent), double_grid=double_grid, diagnostics=diagnostics))
                    wraps = wrapper.call_count
                after = {f: image(getattr(right, f)) for f in ('atoms','alpha','rates','theta')}
                emit({'test': self.id(), 'label': 'score-'+str((independent,double_grid,diagnostics)), 'kind': 'full_metrics_parity',
                      'original': old, 'candidate': new, 'wrapper_calls': wraps, 'flags': {'double_grid': double_grid, 'diagnostics': diagnostics},
                      'independent': independent, 'law_before': before, 'law_after': after, 'law_scalars': {'beta': image(right.beta), 'iterations': right.iterations},
                      'observed': image([2, 1]), 'game_id': 'synthetic-energy-'+str(independent), 'cache': owner.cache_info()})
                self.assertIs(new_type, old_type); self.assertEqual(new, old); self.assertEqual(old['outcome']['kind'], 'metrics')
                self.assertEqual(wraps, 1); self.assertEqual(before, after)

    def test_full_scorer_invalid_target_retains_original_boundary(self):
        law = JointDistribution(np.array([[0., 0.]]), np.array([0.]), 1., np.array([.8, 1.1]), np.zeros(2), 0)
        for observed in ([1.5, 2.], [math.nan, 0.], [-1., 0.], [1.]):
            owner = candidate.LagGeometry()
            old, old_type = call(lambda: original_score(law, observed, 'invalid-synthetic-target'))
            new, new_type = call(lambda: owner.score_forecast(law, observed, 'invalid-synthetic-target'))
            emit({'test': self.id(), 'label': 'invalid-scorer-target', 'kind': 'full_metrics_parity', 'input': image(observed),
                  'original': old, 'candidate': new, 'cache': owner.cache_info()})
            self.assertIs(old_type, new_type); self.assertEqual(old, new)
            self.assertEqual(old['outcome']['message'], 'invalid_target_pair'); self.assertEqual(owner.cache_info()['misses'], 0)


