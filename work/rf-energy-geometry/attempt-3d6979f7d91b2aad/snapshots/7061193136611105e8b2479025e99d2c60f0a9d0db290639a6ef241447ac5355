OBSERVATIONS = []
_WRITER = None


def set_observation_writer(writer):
    global _WRITER
    if writer is not None and not callable(writer):
        raise TypeError('observation writer must be callable or None')
    _WRITER = writer


def emit(row):
    if _WRITER is None:
        OBSERVATIONS.append(row)
    else:
        _WRITER(row)


def scalar_image(value):
    kind = type(value)
    if kind in (float, np.float64, np.float32):
        return {'type': kind.__name__, 'float_hex': float(value).hex(),
                'float64_bits': struct.pack('>d', float(value)).hex()}
    if value is None or kind in (bool, int, str):
        return {'type': kind.__name__, 'value': value}
    if kind is complex:
        return {'type': 'complex', 'real': value.real.hex(), 'imag': value.imag.hex()}
    return {'type': kind.__name__}


def image(value):
    if isinstance(value, np.ndarray):
        result = {'type': type(value).__name__, 'dtype': value.dtype.str, 'shape': list(value.shape),
                  'strides': list(value.strides), 'writeable': bool(value.flags.writeable)}
        if value.dtype.hasobject:
            result['object_values'] = [scalar_image(v) for v in np.ndarray.flatten(value)]
        else:
            result['c_bytes_hex'] = np.ndarray.tobytes(value, order='C').hex()
        return result
    if isinstance(value, (tuple, list)):
        return {'type': type(value).__name__, 'items': [image(v) for v in list.__iter__(value)]} if isinstance(value, list) else {'type': 'tuple', 'items': [image(v) for v in value]}
    return scalar_image(value)


def inputs(grid, observed):
    fields = vars(grid) if hasattr(grid, '__dict__') else {}
    probability = fields.get('probability', fields.get('_probability'))
    return {'grid_type': type(grid).__name__, 'probability': image(probability), 'observed': image(observed),
            'bounds': {name: image(fields[name]) for name in ('omitted_probability_bound', 'score_error_bound') if name in fields}}


def call(function):
    error_type = None
    with warnings.catch_warnings(record=True) as caught:
        warnings.simplefilter('always')
        try:
            value = function()
            if type(value) is dict:
                raw = original_strict(value)
                answer = {'kind': 'metrics', 'type': 'dict', 'bytes': len(raw),
                          'sha256': hashlib.sha256(raw).hexdigest(), 'ascii_body': raw.decode('ascii')}
            else:
                answer = {'kind': 'return', **scalar_image(value)}
        except Exception as error:
            error_type = type(error)
            answer = {'kind': 'error', 'module': type(error).__module__, 'type': type(error).__qualname__, 'message': str(error)}
    return {'outcome': answer, 'warnings': [{'category': type(w.message).__module__+'.'+type(w.message).__qualname__, 'message': str(w.message)} for w in caught]}, error_type


def dirac(shape, mass=1.):
    p = np.zeros(shape, dtype=np.float64)
    p.flat[0] = mass
    return p


def fixture(p, y=(1., 2.)):
    return ScoreGrid(p, 0., 0.), np.asarray(y, dtype=np.float64)


class GridSubclass(ScoreGrid):
    pass


class ArraySubclass(np.ndarray):
    pass


class GridHook:
    def __init__(self, probability, events, fail=False):
        self._probability, self.events, self.fail = probability, events, fail

    @property
    def probability(self):
        self.events.append('grid.probability')
        if self.fail:
            raise RuntimeError('grid probability failed')
        return self._probability


class ObservedHook(list):
    def __getitem__(self, index):
        self.events.append('observed.'+str(index))
        if self.fail == index:
            raise RuntimeError('observation failed '+str(index))
        return super().__getitem__(index)


class EnergyGeometryTests(unittest.TestCase):
    def compare(self, label, factory, owner=None, expected_error=None, expect_fallback=False):
        owner = candidate.LagGeometry() if owner is None else owner
        records, types = {}, {}
        for route in ('original', 'candidate'):
            events = []
            grid, observed = factory(events)
            before = inputs(grid, observed)
            if route == 'original':
                actual, error_type = call(lambda: original_energy(grid, observed))
            else:
                cache_before = owner.cache_info()
                real = candidate._original_energy_score
                with patch.object(candidate, '_original_energy_score', wraps=real) as fallback:
                    actual, error_type = call(lambda: owner.energy_score(grid, observed))
                    fallback_calls = fallback.call_count
                cache_after = owner.cache_info()
            records[route] = {'result': actual, 'input_before': before, 'input_after': inputs(grid, observed), 'events': list(events)}
            types[route] = error_type
        emit({'test': self.id(), 'label': label, 'kind': 'energy_parity', 'original': records['original'],
              'candidate': records['candidate'], 'cache_before': cache_before, 'cache_after': cache_after,
              'fallback_calls': fallback_calls, 'expected_fallback': expect_fallback, 'expected_error': expected_error})
        self.assertEqual(records['candidate']['result'], records['original']['result'], label)
        self.assertIs(types['candidate'], types['original'], label)
        self.assertEqual(records['candidate']['events'], records['original']['events'], label)
        self.assertEqual(records['original']['input_before'], records['candidate']['input_before'], label)
        for row in records.values():
            self.assertEqual(row['input_before'], row['input_after'], label)
        self.assertEqual(fallback_calls, int(expect_fallback), label)
        if expect_fallback:
            self.assertEqual(cache_before, cache_after, label)
        if expected_error:
            self.assertEqual(records['original']['result']['outcome']['message'], expected_error)
        return owner, records

