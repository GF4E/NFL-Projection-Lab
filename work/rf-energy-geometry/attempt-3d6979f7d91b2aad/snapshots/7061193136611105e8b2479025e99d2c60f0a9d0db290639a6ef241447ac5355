    def test_real_fft_is_fresh_on_hits_and_geometry_built_late(self):
        owner = candidate.LagGeometry(); events = []; built = []
        real_forward, real_inverse, real_build = candidate._rfft2, candidate._irfft2, candidate._build_distance
        def forward(*args, **kwargs):
            events.append('rfft2'); return real_forward(*args, **kwargs)
        def inverse(*args, **kwargs):
            events.append('irfft2'); return real_inverse(*args, **kwargs)
        def build(shape):
            events.append('distance'); result = real_build(shape); built.append(result); return result
        with patch.object(candidate, '_rfft2', side_effect=forward) as f, \
             patch.object(candidate, '_irfft2', side_effect=inverse) as r, \
             patch.object(candidate, '_build_distance', side_effect=build) as b:
            for i in range(3):
                self.compare('real-fft-call-'+str(i), lambda events, i=i: fixture(dirac((4, 4)), (float(i), 2.)), owner)
            observed = {'test': self.id(), 'label': 'actual-fresh-fft-events', 'kind': 'dependency_calls', 'events': events,
                        'rfft2': f.call_count, 'irfft2': r.call_count, 'distance': b.call_count,
                        'matrices': [image(value) for value in built], 'cache': owner.cache_info()}
            emit(observed)
            self.assertEqual(events, ['rfft2', 'irfft2', 'distance', 'rfft2', 'irfft2', 'rfft2', 'irfft2'])
            self.assertEqual((f.call_count, r.call_count, b.call_count), (3, 3, 1))
        self.assertEqual(len(built), 1)
        self.assertEqual(built[0].dtype, np.dtype('float64'))
        self.assertTrue(built[0].flags.c_contiguous); self.assertFalse(built[0].flags.writeable)
        self.assertTrue(built[0].flags.owndata)

