def publication_fixture(origin, manifest='f' * 64):
    full = [{'family': 'E3', 'setting': i, 'game_id': g, 'native_failure': None, 'distribution': {'recipe': 'synthetic'}}
            for g in origin['targetGameIds'] for i in range(27)] if 2011 <= origin['season'] <= 2024 else []
    outer = [{'family': f, 'variant': v, 'setting': 0, 'game_id': g, 'native_failure': None,
              'distribution': {'recipe': 'synthetic'}} for f, v in tuple(('E3', v) for v in a.SPLIT_VARIANTS) + a.RAW_REFERENCES
             for g in origin['targetGameIds']] if origin['season'] >= 2013 else []
    return {'version': 'rf02f.origin-publication.v1', 'manifest_sha256': manifest, 'parent_manifest_sha256': a.PARENT_MANIFEST,
            'origin': [origin['season'], origin['week']], 'origin_at': origin['originAt'],
            'target_game_ids': origin['targetGameIds'], 'full_setting_forecasts': full, 'outer_selected_forecasts': outer}


def proof(origin, manifest='f' * 64):
    raw = encoded(publication_fixture(origin, manifest))
    pointer = {'name': 'forecasts.json', 'sha256': a.sha(raw), 'bytes': len(raw)}
    receipt = a._publication(origin, pointer, lambda p: raw, manifest)
    # Explicit synthetic post-grading binding; real grade_inputs derives this
    # only from the authenticated source inner-loss file after publication.
    return replace(receipt, _diagonal_binding=tuple((i, g, float(i+1), None)
                    for g in origin['targetGameIds'] for i in range(9)))


def batch(origin):
    return [{'family': 'E3', 'setting': i, 'game_id': g, 'native_failure': None,
             'metrics': {'joint_energy_score': float(i + 1)}} for g in origin['targetGameIds'] for i in range(27)]


class ArchiveTests(unittest.TestCase):
    def tiny(self, *args, **kwargs):
        value = TinyArchive(*args, **kwargs)
        self.addCleanup(value.close)
        return value

    def test_import_inert_and_production_has_no_fixture_bypass(self):
        with patch.object(a, 'Archive', side_effect=AssertionError('archive opened')):
            importlib.reload(a)
        with self.assertRaises(TypeError):
            a.admit_source(ROOT, lambda: None, fixture={})
        with tempfile.TemporaryDirectory() as path, self.assertRaises((ValueError, FileNotFoundError)):
            a.admit_source(Path(path).resolve(), lambda: None)

    def test_real_index_binding_membership_and_symlink_rejection(self):
        x = self.tiny()
        a._physical(x.archive)
        (x.directory / 'unexpected.json').write_text('{}')
        with self.assertRaisesRegex(ValueError, 'physical_archive'):
            a._physical(x.archive)
        (x.directory / 'unexpected.json').unlink()
        path = x.directory / 'state-2011-01.json'
        path.write_text('{}')
        with self.assertRaisesRegex(ValueError, 'bound_file_mismatch'):
            x.call()
        path.unlink(); path.symlink_to(x.directory / 'manifest.json')
        with self.assertRaises((ValueError, OSError)):
            x.call()

