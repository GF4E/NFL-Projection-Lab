def record(game, year, week, kickoff, home=21, away=17):
    dt = datetime.fromisoformat(kickoff)
    return {'gameId': game, 'season': year, 'week': week, 'homeTeam': 'T00', 'awayTeam': 'T01',
            'neutral': False, 'kickoffAt': kickoff, 'homeScore': home, 'awayScore': away, 'overtime': 0,
            'availability': {str(d): (dt + timedelta(hours=d)).isoformat() for d in (12, 24)}}


def source_fixture(year=2011, week=1):
    records = [record('old', year-1, 17, f'{year-1}-12-26T17:00:00+00:00'),
               record('z-target', year, week, f'{year}-09-11T17:00:00+00:00'),
               record('a-target', year, week, f'{year}-09-12T17:00:00+00:00')]
    window = {'eligibleInputIds': ['old'], 'inputIdSha256': a.sha(encoded(['old'])),
              'firstDeliveryIds': ['old'], 'omittedPriorInputIds': [], 'minimumTrainingMet': True}
    origin = {'season': year, 'week': week, 'originAt': f'{year}-09-06T14:30:00+00:00',
              'role': 'outer' if year >= 2013 else 'inner', 'targetGameIds': ['z-target', 'a-target'],
              'windows': {'12': copy.deepcopy(window), '24': copy.deepcopy(window)}}
    return records, origin


def mapper_fixture(records, origin, delay=12):
    prepared = prepare_origin(records, origin, delay)
    mapper = a.JointBase.from_scores([[r.home_score, r.away_score] for r in prepared['history']],
                                    a.weights(prepared['history'], origin['season'], 2.5))
    payload = {'atoms': mapper.atoms.tolist(), 'weights': mapper.weights.tolist(), 'b': mapper.b,
               'epsilon': mapper.epsilon, 'input_sha256': prepared['input_hash'], 'half_life': 2.5}
    _, alpha, beta, rates, _, _ = mapper.components(np.zeros(2))
    law = JointDistribution(mapper.atoms.copy(), alpha, beta, rates, np.zeros(2), 0)
    return prepared, mapper, payload, law


def state_fixture(origin, mean):
    forecasts = [{'game_id': g, 'mean': copy.deepcopy(mean), 'failure': None,
                  'initialization_only': False} for g in sorted(origin['targetGameIds'])]
    rows = []
    for family, variant in SERIES:
        if variant in ('independent_marginals', 'deterministic_noise'):
            continue
        for index in range(len(SETTINGS[family])):
            output = {'forecasts': copy.deepcopy(forecasts), 'events': {
                'delivered': ['old'], 'initialization_only': [],
                'offseason_retention_applied': origin['season'] > 2010 and origin['week'] == 1},
                'support': None, 'league_mean': float(sum(mean)/2), 'home_effect': 0.,
                'elo_score_slope': 0., 'absorbing_failure': False}
            rows.append({'key': [family, index, variant], 'output': output,
                         'ratings': [1500.] * 32, 'offense': [0.] * 32, 'defense': [0.] * 32})
    return {'origin': copy.deepcopy(origin), 'actual_computation_at': '2026-09-05T00:00:00+00:00',
            'historical_status': 'retrospective_inferred', 'prospective': False, 'trajectory_state': rows}


def metrics_fixture(target, outer=False):
    # These are explicit schema fixtures, not claimed scored forecast evidence.
    value = {key: 0. for key in (a._OUTER_METRICS if outer else a._BASE_METRICS)}
    value['joint_energy_score'] = 1.
    value['grid_cells'] = [64, 64]
    h, away = target['homeScore'], target['awayScore']
    for name, observation in zip(a._TARGETS, (h, away, h-away, h+away)):
        value[name + '_observed'] = float(observation)
    return value


class TinyArchive:
    """Real Archive + hashes; only a single synthetic origin, never1909 dummies."""
    def __init__(self, year=2011, week=1, warmup=False):
        self.temp = tempfile.TemporaryDirectory()
        self.directory = Path(self.temp.name).resolve()
        self.records, self.origin = source_fixture(year, week)
        if warmup:
            self.origin['windows']['12']['minimumTrainingMet'] = False
            self.origin['windows']['24']['minimumTrainingMet'] = False
        self.prepared, self.mapper, payload, self.law = mapper_fixture(self.records, self.origin)
        self.contents = {}
        manifest = {'bound_hashes': {'config': 'a' * 64}, 'code_hashes': {'synthetic': 'b' * 64}}
        self.manifest_hash = a.sha(encoded(manifest))
        self.contents['manifest.json'] = manifest
        self.state = state_fixture(self.origin, self.law.moments()[0].tolist())
        suffix = a._suffix(self.origin)
        self.contents['state-' + suffix + '.json'] = self.state
        self.selection = {family: {'setting': 0} for family in SETTINGS}
        mapper_sha = a.sha(encoded(payload))
        pointer = {'name': 'object-' + mapper_sha + '.json', 'sha256': mapper_sha}
        self.mapper_pointers = {payload['input_sha256']: pointer}
        self.contents[pointer['name']] = payload
        self.descriptor = distribution_descriptor(self.law, pointer)
        if warmup:
            self.contents['warmup-' + suffix + '.json'] = {'status': 'warmup_unforecastable', 'targets': self.origin['targetGameIds']}
        else:
            full = [{'family': family, 'setting': i, 'game_id': g, 'native_failure': None,
                     'distribution': copy.deepcopy(self.descriptor)} for g in self.origin['targetGameIds']
                    for family, settings in SETTINGS.items() for i in range(len(settings))]
            outer = []
            if year >= 2013:
                noises = {}
                for g in self.origin['targetGameIds']:
                    noise = [np.random.Generator(np.random.PCG64(canonical_seed('noise', g, side))).standard_normal()
                             for side in ('home', 'away')]
                    # Synthetic-only two numerical fits supply genuine descriptor
                    # consistency for the output-only deterministic-noise helper.
                    noises[g] = self.mapper.fit(self.law.moments()[0] + noise)
                for family, variant in SERIES:
                    for g in self.origin['targetGameIds']:
                        law = noises[g] if variant == 'deterministic_noise' else replace(self.law, independent=True) if variant == 'independent_marginals' else self.law
                        outer.append({'family': family, 'variant': variant, 'setting': 0, 'game_id': g,
                                      'native_failure': None, 'distribution': distribution_descriptor(law, pointer)})
            self.publication = {'classification': 'retrospective', 'origin_at': self.origin['originAt'],
                                'manifest_sha256': self.manifest_hash,
                                'full_setting_forecasts': full, 'outer_selected_forecasts': outer}
            self.contents['forecasts-' + suffix + '.json'] = self.publication
            self.refresh_lineage()
            by_id = {r['gameId']: r for r in self.records}
            self.inner = [{k: row[k] for k in ('family', 'setting', 'game_id', 'native_failure')} |
                          {'metrics': metrics_fixture(by_id[row['game_id']])} for row in full]
            self.contents['inner-losses-' + suffix + '.json'] = self.inner
            if year >= 2013:
                self.losses = [{k: row[k] for k in ('family', 'variant', 'game_id', 'native_failure')} |
                               {'metrics': metrics_fixture(by_id[row['game_id']], True)} for row in outer]
                self.contents['outer-losses-' + suffix + '.json'] = self.losses
        self.save()

    def refresh_lineage(self):
        body_sha = a.sha(encoded(self.publication))
        self.contents['ancestry-' + a._suffix(self.origin) + '.json'] = {
            str(d): lineage(prepare_origin(self.records, self.origin, d), 'a' * 64,
                            a.sha(encoded({'synthetic': 'b' * 64})), self.manifest_hash,
                            {'forecast_bytes_sha256': body_sha, 'delay_hours': d}) for d in (12, 24)}

    def save(self):
        index = {}
        for name, value in self.contents.items():
            raw = encoded(value)
            (self.directory / name).write_bytes(raw)
            index[name] = {'sha256': a.sha(raw), 'bytes': len(raw)}
        raw = encoded({'files': index})
        (self.directory / 'artifact-index.json').write_bytes(raw)
        self.archive = a.Archive(self.directory, self.manifest_hash, a.sha(raw))

    def call(self, grade=False):
        return a._origin_artifacts(self.archive, {r['gameId']: r for r in self.records}, self.origin,
                                   SETTINGS, SERIES, self.selection, self.mapper_pointers, lambda: None, grade=grade)

    def close(self):
        self.temp.cleanup()


