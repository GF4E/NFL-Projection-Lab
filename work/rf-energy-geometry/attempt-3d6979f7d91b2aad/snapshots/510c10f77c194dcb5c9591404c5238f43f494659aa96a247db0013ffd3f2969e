    def test_selector_prior_universe_cached_integrity_and_season_before_add(self):
        sources = [source_fixture(y) for y in (2011, 2012, 2013)]
        # Unique IDs across years, preserving original nonlexicographic order.
        for records, origin in sources:
            suffix = '-' + str(origin['season'])
            for r in records: r['gameId'] += suffix
            origin['targetGameIds'] = [g + suffix for g in origin['targetGameIds']]
            for window in origin['windows'].values():
                window['eligibleInputIds'] = ['old' + suffix]
                window['inputIdSha256'] = a.sha(encoded(window['eligibleInputIds']))
                window['firstDeliveryIds'] = ['old' + suffix]
        origins = [o for _, o in sources]
        records = [r for rows, _ in sources for r in rows if r['gameId'] in {g for o in origins for g in o['targetGameIds']}]
        context = context_fixture(origins, records); feed = a.StrictSelectionFeed(context)
        with self.assertRaises(ValueError): feed.add(origins[1], batch(origins[1]), proof(origins[1]))
        for origin in origins[:2]: feed.add(origin, batch(origin), proof(origin))
        with self.assertRaisesRegex(ValueError, 'annual_selection_not_frozen'):
            feed.add(origins[2], batch(origins[2]), proof(origins[2]))
        expected = context.expected_by_season
        selected = feed.select(2013, expected)
        self.assertEqual(selected['E3']['setting'], 0)
        bad = copy.deepcopy(expected); bad[2011].reverse()
        with self.assertRaisesRegex(ValueError, 'prior_universe_changed'): feed.select(2013, bad)
        with self.assertRaisesRegex(ValueError, 'invalid_outer_year'): feed.select(True, expected)
        with self.assertRaisesRegex(ValueError, 'selection_run_swap'):
            feed.add(origins[2], batch(origins[2]), proof(origins[2], 'e'*64))
        feed._selector.frozen_choices[2013]['E3']['setting'] = 1
        with self.assertRaisesRegex(ValueError, 'cached_selection_changed'): feed.select(2013, expected)


