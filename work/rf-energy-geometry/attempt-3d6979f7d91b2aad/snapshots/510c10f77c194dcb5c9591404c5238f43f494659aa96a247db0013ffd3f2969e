    def test_both_real_closures_and_mapper_weight_b_tampering(self):
        records, origin = source_fixture(2021)
        records.insert(0, record('older', 2019, 17, '2019-12-26T17:00:00+00:00', 10, 30))
        for window in origin['windows'].values():
            window['eligibleInputIds'] = ['older', 'old']
            window['inputIdSha256'] = a.sha(encoded(['older', 'old']))
        prepared, mapper, payload, _ = mapper_fixture(records, origin)
        actual = a._mapper(payload, prepared, {r['gameId']: r for r in records}, 2021)
        self.assertEqual(type(actual), a.JointBase)
        self.assertFalse(np.allclose(actual.weights, np.full(len(actual.weights), 1/len(actual.weights))))
        for field in ('b', 'weights'):
            changed = copy.deepcopy(payload)
            if field == 'b': changed['b'] += .1
            else: changed['weights'] = changed['weights'][1:] + changed['weights'][:1]
            with self.assertRaisesRegex(ValueError, 'mapper_empirical'):
                a._mapper(changed, prepared, {r['gameId']: r for r in records}, 2021)
        changed = copy.deepcopy(records); changed[0]['homeScore'] += 1
        new = prepare_origin(changed, origin)
        with self.assertRaisesRegex(ValueError, 'mapper_source'):
            a._mapper(payload, new, {r['gameId']: r for r in changed}, 2021)

