            "config": runner.digest(runner.read_regular(ROOT / "config/research-team-score-successor.v1.json")),
            "specification": config["specification"]["sha256"]}
        return {"root": ROOT, "successorConfig": config, "bindings": bindings,
                "codeHashes": {}, "accepted": ({}, {"budget": {}}, {}, {}),
                "implementation": {"receipt": {"qualification": {"manifestSha256": "q"}},
                                   "receiptSha256": "r", "anchorSha256": "a", "frozenObjects": []}}

    def test_private_mapper_binding_and_combined_smoke(self):
        legacy_mapper = runner.replay.common_mapper.__globals__["JointBase"]
        module = runner.build_runner(self.context())
        self.assertIs(module.common_mapper.__globals__["JointBase"], runner.JointBase)
        self.assertIs(runner.replay.common_mapper.__globals__["JointBase"], legacy_mapper)
        self.assertIsNot(legacy_mapper, runner.JointBase)
        self.assertEqual(module.common_mapper.__code__, runner.replay.common_mapper.__code__)
        self.assertEqual(module._SMOKE_COMMAND, [sys.executable, "-I", "-c", runner.SMOKE_PROGRAM])
        self.assertIn("tests/research-score-successor", runner.SMOKE_PROGRAM)
        self.assertIn("tests/research-score'", runner.SMOKE_PROGRAM)
        self.assertEqual(module.CODE_FILES, runner.CODE_FILES)
        self.assertEqual(module.TEST_FILES, runner.TEST_FILES)

    def test_document_chain_reauthenticated_at_inherited_invocation(self):
        context = self.context()
        context["codeHashes"] = {name: runner.digest(runner.read_regular(ROOT / name))
                                 for name in runner.CODE_FILES + runner.TEST_FILES}
        module = runner.build_runner(context)
        with mock.patch("research_score_successor_qualify.load_successor",
                        return_value=(context["successorConfig"], context["bindings"])), \
                mock.patch.object(runner, "load_accepted", return_value=context["accepted"]) as accepted:
            self.assertEqual(module.load_accepted(ROOT), context["accepted"])
            accepted.assert_called_once_with(ROOT)
        with mock.patch("research_score_successor_qualify.load_successor",
                        return_value=(context["successorConfig"], {"changed": True})), \
                mock.patch.object(runner, "load_accepted") as accepted:
            with self.assertRaisesRegex(ValueError, "successor_changed_after_preflight"):
                module.load_accepted(ROOT)
            accepted.assert_not_called()
        with mock.patch("research_score_successor_qualify.load_successor",
                        return_value=(context["successorConfig"], context["bindings"])), \
                mock.patch.object(runner, "load_accepted", return_value=({}, {}, {}, {})):
            with self.assertRaisesRegex(ValueError, "inherited_acceptance_changed_after_preflight"):
                module.load_accepted(ROOT)

    def test_identity_hash_binds_successor_before_output_creation(self):
        module = runner.build_runner(self.context())
        module.CODE_FILES, module.TEST_FILES = [], []
        module.load_accepted = lambda _root: ({}, {}, {}, {"config": "old"})
        module.runtime_manifest = lambda _config: {"pinned": True}
        identities = []
        class BeforeOutput:
            def __init__(self, parent, identity):
                identities.append(identity)
                raise RuntimeError("captured_before_output")
        module.ImmutableRun = BeforeOutput
        for suffix in ("first", "second"):
            module._SUCCESSOR_BINDING["implementation_receipt_sha256"] = suffix
            with self.assertRaisesRegex(RuntimeError, "captured_before_output"):
                module.run()
        self.assertTrue(all(identity.startswith("rf02s-v1-") for identity in identities))
        self.assertNotEqual(*identities)
        self.assertEqual(runner.replay.common_mapper.__globals__["JointBase"], runner.legacy.JointBase)


