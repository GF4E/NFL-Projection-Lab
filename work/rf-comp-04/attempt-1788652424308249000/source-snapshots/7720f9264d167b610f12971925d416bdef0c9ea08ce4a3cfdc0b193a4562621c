            new_pointer = dict(pointer, sha256=unit.sha(unit.strict(changed)), bytes=len(unit.strict(changed)))
            with self.subTest(mutation=mutation), self.assertRaises(unit.RunFailure):
                unit.verify_envelope(changed, new_pointer, f['manifest'], key, 2013, f['origin']['originAt'], [])

    def test_persisted_recipe_reconstruction_and_old_theta_rejected(self):
        f = fixture(self.store); pointer = self.publish(f)
        publication = self.store.read_bound(pointer)
        recipe = publication['rows'][0]
        def recover(value):
            chosen = recipe['provenance']['chosen_source']; key = chosen['family'], chosen['variant']
            return unit.recover_recipe(value, f['archive'], f['rows'], f['references']['forecast'],
                    f['annual'][1][key], f['annual'][2][key], f['manifest'], f['origin'], f['origin']['originAt'], [], {}, f['counts'])
        result = recover(recipe)
        self.assertEqual(unit.law_fingerprint(result), recipe['result_distribution_fingerprint'])
        with self.assertRaisesRegex(unit.RunFailure, 'transformed_law_recipe'):
            recover(f['rows']['N0', 'full', 'z-first']['distribution'])
        for field, value in (('result_distribution_fingerprint', 'f' * 64), ('native_failure', 'changed'),
                             ('parent_forecast', {'name': 'wrong'})):
            changed = copy.deepcopy(recipe); changed[field] = value
            with self.subTest(field=field), self.assertRaises(unit.RunFailure): recover(changed)
        changed = copy.deepcopy(recipe); changed['provenance']['transformation']['s'] = .5
        changed['provenance']['sha256'] = unit.fingerprint({key: value for key, value in changed['provenance'].items() if key != 'sha256'})
        with self.assertRaisesRegex(unit.RunFailure, 'persisted_transformed_law'): recover(changed)

