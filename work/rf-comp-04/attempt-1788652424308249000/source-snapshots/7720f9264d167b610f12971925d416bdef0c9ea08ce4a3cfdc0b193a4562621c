    def test_real_nonidentity_2014_receipts_recipe_grading_and_differing_fallback_scale(self):
        f = fixture(self.store)
        f['origin'].update(season=2014, originAt='2014-09-02T14:30:00+00:00')
        for game in f['origin']['targetGameIds']:
            f['records'][game].update(season=2014, kickoffAt='2014-09-04T18:00:00+00:00')
            f['contexts'][game].update(season=2014, kickoff_at='2014-09-04T18:00:00+00:00')
        f['references']['forecast']['name'] = 'forecasts-2014-01.json'
        f['references']['loss']['name'] = 'outer-losses-2014-01.json'
        original = unit.recover_source(f['archive'], f['rows']['N0', 'full', 'z-first']['distribution'], {})
        source_hash = unit.distribution_fingerprint(original)
        kickoff = datetime.fromisoformat('2013-12-01T18:00:00+00:00')
        games = [f'synthetic-prior-{i}' for i in range(256)]
        bodies, envelopes, pointers = {}, {}, {}
        for family, variant in unit.ORDINARY:
            observed = (1, 1) if family == 'N0' else (0, 2)
            case = unit.canonical(unit.calibration_case(original, *observed))
            case_hash = unit.fingerprint(case)
            sources, cases = [], []
            for game in games:
                common = {'family': family, 'variant': variant, 'season': 2013, 'game_id': game,
                          'source_fingerprint': source_hash, 'case_fingerprint': case_hash}
                sources.append({**common, 'origin_at': '2013-11-26T14:30:00+00:00', 'kickoff_at': kickoff.isoformat(),
                    'availability': {str(hours): (kickoff + timedelta(hours=hours)).isoformat() for hours in (12, 24)},
                    'native_failure': None, 'observed_home': observed[0], 'observed_away': observed[1]})
                cases.append({**common, 'weight': 1, 'case': case})
            body = unit.annual_receipt(family, variant, 2014, f['origin']['originAt'], {2013: games}, sources, cases)
            later = [{'season': 2025, 'unreadable_future_payload': object()}]
            unchanged = unit.annual_receipt(family, variant, 2014, f['origin']['originAt'], {2013: games}, sources + later, cases + later)
            self.assertEqual(body, unchanged)
            envelope = unit.receipt_envelope(body, f['manifest'], [])
            name = f'warm-2014-{family.lower()}-{variant.replace("_", "-")}.json'
            self.store.write(name, envelope)
            bodies[family, variant], envelopes[family, variant], pointers[family, variant] = body, envelope, self.store.pointer(name)
        self.assertLess(bodies['N0', 'full']['scale'], 1.)
        self.assertNotEqual(bodies['N0', 'full']['scale'], bodies['E2', 'full']['scale'])
        f['annual'] = bodies, envelopes, pointers, []
        for variant in ('full', 'independent_marginals', 'no_offense', 'no_defense'):
            for game in f['origin']['targetGameIds']:
                f['rows']['E2', variant, game]['native_failure'] = 'synthetic-inherited-failure'
                f['losses']['E2', variant, game]['native_failure'] = 'synthetic-inherited-failure'
        pointer = self.publish(f)
        recipes = self.store.read_bound(pointer)['rows']
        mapped, _ = self.grade(f, pointer)
        for row, recipe in zip(mapped, recipes):
            raw_family, variant = row['family'][:-1], row['variant']
            fallback = recipe['native_failure'] is not None
            key = ('N0', 'full') if fallback else (raw_family, 'full' if variant == 'independent_marginals' else variant)
            expected, descriptor = unit.transform_distribution(original, bodies[key]['scale'])
            if variant == 'independent_marginals': expected, _ = unit.independent_control(expected, descriptor)
            self.assertEqual(recipe['result_distribution_fingerprint'], unit.law_fingerprint(expected))
            self.assertEqual(recipe['provenance']['transformation']['s'], bodies[key]['scale'])
            if fallback:
                self.assertEqual(recipe['annual_envelope'], pointers['N0', 'full'])
                self.assertNotEqual(recipe['annual_envelope'], pointers['E2', 'full'])
            expected_metrics = unit.score_forecast(expected, [0, 2], row['game_id'], double_grid=True, diagnostics=True)
            for target in ('home', 'away', 'margin', 'total'):
                expected_metrics[target + '_interval_mass_80'] = float(expected.cdf(target, expected_metrics[target + '_upper_80'])
                    - expected.cdf(target, expected_metrics[target + '_lower_80'] - 1))
            self.assertEqual(unit.strict(row['metrics']), unit.strict(expected_metrics))

