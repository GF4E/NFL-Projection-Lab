    def test_receipt_foreign_run_same_year_cutoff_and_mutation_rejected(self):
        f = fixture(self.store); key = ('E2', 'full')
        envelope, pointer = f['annual'][1][key], f['annual'][2][key]
        unit.verify_envelope(envelope, pointer, f['manifest'], key, 2013, f['origin']['originAt'], [])
        for mutation in ('run', 'cutoff', 'year', 'scale'):
            changed = copy.deepcopy(envelope)
            if mutation == 'run': changed['run_manifest_sha256'] = 'd' * 64
            elif mutation == 'cutoff': changed['pure_receipt']['cutoff'] = '2013-09-04T14:30:00+00:00'
            elif mutation == 'year': changed['target_season'] = 2014
            else: changed['pure_receipt']['scale'] = .5
