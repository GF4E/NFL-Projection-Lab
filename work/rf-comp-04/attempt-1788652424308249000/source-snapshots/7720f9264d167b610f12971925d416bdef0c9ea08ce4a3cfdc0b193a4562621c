        def collect(*args):
            order.append('collector'); now[0] = 601.; args[-1].check()
        with patch.object(unit.time, 'monotonic', side_effect=lambda: now[0]), \
             patch.object(unit, 'OUTPUT_PARENT', self.directory), \
             patch.object(unit, 'preflight', return_value=(None, {}, {}, admission, manifest)), \
             patch.object(unit, 'admit_archive', side_effect=admit), \
