class SyntheticArchive:
    def __init__(self, values):
        self.values = values
        self.index = {name: {'sha256': unit.sha(unit.strict(value)), 'bytes': len(unit.strict(value))}
                      for name, value in values.items()}

    def read(self, pointer):
        return copy.deepcopy(self.values[pointer['name'] if isinstance(pointer, dict) else pointer])


def saved(mapper, pointer, independent=False):
    theta = np.array([0., -0.])
    _, alpha, beta, rates, _, _ = mapper.components(theta)
    d = JointDistribution(mapper.atoms.copy(), alpha, beta, rates, theta, 3, independent)
    mean, covariance = d.moments()
    return {'version': 'rf.joint-distribution.v2', 'mapper': pointer, 'theta': theta.tolist(), 'beta': beta,
            'rates': rates.tolist(), 'alphaSha256': unit.sha(unit.encoded(alpha.tolist())), 'iterations': 3,
            'independent': independent, 'mean': mean.tolist(), 'covariance': covariance.tolist()}


def fixture(store):
    mapper_value = {'atoms': [[0., 2.], [2., 0.]], 'weights': [.5, .5], 'b': 1., 'epsilon': .05}
    mapper_hash = unit.sha(unit.strict(mapper_value))
    pointer = {'name': 'object-' + mapper_hash + '.json', 'sha256': mapper_hash}
    mapper = JointBase(np.array(mapper_value['atoms']), np.array(mapper_value['weights']), 1.)
    archive = SyntheticArchive({pointer['name']: mapper_value})
    origin = {'season': 2013, 'week': 1, 'originAt': '2013-09-03T14:30:00+00:00', 'targetGameIds': ['z-first', 'a-last']}
    records = {game: {'gameId': game, 'season': 2013, 'week': 1, 'kickoffAt': '2013-09-05T18:00:00+00:00',
                      'homeScore': 0, 'awayScore': 2} for game in origin['targetGameIds']}
    contexts = {game: {'game_id': game, 'season': 2013, 'week': 1, 'kickoff_at': records[game]['kickoffAt']}
                for game in origin['targetGameIds']}
    parent_rows, parent_losses = {}, {}
    series = list(unit.SERIES) + [key for key in unit.RAW_REFERENCES if key not in unit.SERIES]
    for family, variant in series:
        descriptor = saved(mapper, pointer, variant == 'independent_marginals')
        for game in origin['targetGameIds']:
            key = family, variant, game
            parent_rows[key] = {'family': family, 'variant': variant, 'game_id': game,
                                'native_failure': None, 'distribution': copy.deepcopy(descriptor)}
            parent_losses[key] = {'family': family, 'variant': variant, 'game_id': game,
                                 'native_failure': None, 'metrics': {'home_observed': 0., 'away_observed': 2.}}
    references = {'forecast': {'name': 'forecasts-2013-01.json', 'sha256': 'a' * 64, 'bytes': 123},
                  'loss': {'name': 'outer-losses-2013-01.json', 'sha256': 'b' * 64, 'bytes': 456}}
    manifest_hash = 'c' * 64
    bodies, envelopes, pointers = {}, {}, {}
    for family, variant in unit.ORDINARY:
        body = unit.annual_receipt(family, variant, 2013, origin['originAt'], {}, [], [])
        envelope = unit.receipt_envelope(body, manifest_hash, [])
        name = f'annual-{family.lower()}-{variant.replace("_", "-")}.json'
        store.write(name, envelope)
        bodies[family, variant], envelopes[family, variant], pointers[family, variant] = body, envelope, store.pointer(name)
    counts = {'prediction_reconstruction_calls': 0, 'mapped_prediction_calls': 0,
              'recipe_reconstruction_calls': 0, 'score_calls': 0}
    return {'archive': archive, 'origin': origin, 'records': records, 'contexts': contexts, 'rows': parent_rows,
            'losses': parent_losses, 'references': references, 'manifest': manifest_hash,
            'annual': (bodies, envelopes, pointers, []), 'budget': unit.Budget(), 'counts': counts}


class RunTests(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.started = time.monotonic()

    @classmethod
    def tearDownClass(cls):
        elapsed = time.monotonic() - cls.started
        rss = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss / (1024 ** 2 if sys.platform == 'darwin' else 1024)
        if elapsed > 120 or rss > 4096:
            raise AssertionError(f'synthetic_budget_exceeded: seconds={elapsed}, rss_mib={rss}')

    def setUp(self):
        self.temp = tempfile.TemporaryDirectory()
        self.directory = Path(self.temp.name).resolve()
        self.store = unit.Store(self.directory, 'synthetic-run')

    def tearDown(self):
        self.store.close()
        self.temp.cleanup()

    def publish(self, f):
        return unit.publish_origin(self.store, f['archive'], f['manifest'], f['origin'], f['contexts'], f['rows'],
                                   f['references'], f['annual'][0], f['annual'][2], f['budget'], f['counts'])

    def grade(self, f, pointer, records=None):
        return unit.grade_origin(self.store, f['archive'], f['manifest'], f['origin'], pointer,
                                f['records'] if records is None else records, f['rows'], f['losses'], f['references'],
                                f['annual'], f['origin']['originAt'], f['budget'], f['counts'])

    def test_complete_publication_is_durable_before_any_grader_outcome(self):
        f = fixture(self.store)
        with patch.object(unit.os, 'fsync', wraps=os.fsync) as synced:
            pointer = self.publish(f)
            self.assertIn(self.store.fd, [call.args[0] for call in synced.call_args_list])
        publication = self.store.read_bound(pointer)
        self.assertEqual(len(publication['rows']), 40)
        self.assertEqual(publication['rows'][0]['game_id'], 'z-first')
        self.assertEqual(publication['rows'][1]['game_id'], 'a-last')
        self.assertNotIn('observed_home', publication['rows'][0])
        owner = self
        class Guard(dict):
            def __getitem__(self, key):
                if key in ('homeScore', 'awayScore'):
                    owner.assertEqual(len(owner.store.read_bound(pointer)['rows']), 40)
                return super().__getitem__(key)
        records = {key: Guard(value) for key, value in f['records'].items()}
        real_score = unit.score_forecast
        with patch.object(unit, 'score_forecast', wraps=real_score) as score:
            mapped, raw = self.grade(f, pointer, records)
        self.assertEqual((len(mapped), len(raw), score.call_count), (40, 12, 40))
        self.assertTrue(all(call.kwargs == {'double_grid': True, 'diagnostics': True} for call in score.call_args_list))
        self.assertEqual(f['counts'], {'prediction_reconstruction_calls': 40, 'mapped_prediction_calls': 40,
                                      'recipe_reconstruction_calls': 40, 'score_calls': 40})
        for row in mapped:
            self.assertTrue(all(0 <= row['metrics'][target + '_interval_mass_80'] <= 1
                                for target in ('home', 'away', 'margin', 'total')))
        self.assertIs(raw[0]['metrics'], f['losses']['N0', 'full', 'z-first']['metrics'])

