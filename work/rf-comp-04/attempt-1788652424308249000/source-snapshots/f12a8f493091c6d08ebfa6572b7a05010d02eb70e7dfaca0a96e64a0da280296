import copy
import json
from pathlib import Path
import sys
import unittest
from unittest.mock import patch
import numpy as np

ROOT=Path(__file__).resolve().parents[2]
sys.path.insert(0,str(ROOT/'scripts'))
import research_score_compute_qualify as q


class ComputeQualificationTests(unittest.TestCase):
    def contract(self):
        root=Path('/synthetic')
        config={'specification':{'path':'spec.md','sha256':q.digest(b'spec')},
                'predecessorConfig':{'path':'prior.json','sha256':q.digest(b'prior')},
                'predecessorImplementation':{'path':'impl.json','sha256':q.digest(b'impl')},
                'frozenSourceHashes':{'source.py':q.digest(b'source')}}
        raw=q.encoded(config)
        receipt={'result':'accepted_for_implementation_only','implementationAuthorized':True,
                 'configSha256':q.digest(raw),'protocolSha256':q.digest(b'spec')}
        rr=q.encoded(receipt)
        files={root/q.ACCEPTANCE_PATH:rr,root/q.CONFIG_PATH:raw,root/'spec.md':b'spec',root/'prior.json':b'prior',
               root/'impl.json':b'impl',root/'source.py':b'source'}
        return root,files,q.digest(rr)

    def test_contract_every_changed_binding_blocks(self):
        root,files,anchor=self.contract()
        with patch.object(q,'read_regular',side_effect=lambda p:files[p]),patch.object(q,'ACCEPTANCE_SHA',anchor):
            config,bindings=q.load_compute(root)
            self.assertEqual(set(bindings),{'acceptance','config','specification','predecessorConfig','predecessorImplementation'})
        for name in files:
            changed=dict(files);changed[name]+=b'x'
            with patch.object(q,'read_regular',side_effect=lambda p:changed[p]),patch.object(q,'ACCEPTANCE_SHA',anchor):
                with self.assertRaisesRegex(ValueError,'frozen_bytes_mismatch'):q.load_compute(root)

    def archive(self):
        root=Path('/synthetic-input')
        manifest={'code_hashes':{'old.py':'known'},'successor':{'implementation_receipt_sha256':'impl'}}
        bodies={'manifest.json':q.encoded(manifest),'terminal-failure.json':q.encoded({'status':'protocol_invalid','reason':'pilot_projected_budget_exceeded'})}
        idx=q.encoded({'files':{name:{'sha256':q.digest(raw),'bytes':len(raw)} for name,raw in bodies.items()}})
        config={'inputRunDirectory':str(root),'inputIndexSha256':q.digest(idx),'inputManifestSha256':q.digest(bodies['manifest.json']),
                'inputCounts':{'indexedFiles':2,'indexedBytes':sum(map(len,bodies.values()))},
                'frozenSourceHashes':manifest['code_hashes'],'predecessorImplementation':{'sha256':'impl'}}
        files={root/name:raw for name,raw in bodies.items()};files[root/'artifact-index.json']=idx
        return config,files

    def test_input_corruption_and_counts_refused(self):
        config,files=self.archive()
        with patch.object(q,'read_regular',side_effect=lambda p:files[p]):self.assertEqual(len(q.read_input(config)),2)
        for path in files:
            changed=dict(files);changed[path]+=b'x'
            with patch.object(q,'read_regular',side_effect=lambda p:changed[p]):
                with self.assertRaisesRegex(ValueError,'frozen_bytes_mismatch'):q.read_input(config)
        for key in ('indexedFiles','indexedBytes'):
            changed=copy.deepcopy(config);changed['inputCounts'][key]+=1
            with patch.object(q,'read_regular',side_effect=lambda p:files[p]):
                with self.assertRaisesRegex(ValueError,'input_.*count_mismatch'):q.read_input(changed)
        changed=copy.deepcopy(config);changed['frozenSourceHashes']={}
        with patch.object(q,'read_regular',side_effect=lambda p:files[p]):
            with self.assertRaisesRegex(ValueError,'input_source_bindings_mismatch'):q.read_input(changed)

    def test_exact_canonical_comparison_catches_signed_zero(self):
        q.canonical_equal({'a':1.,'nested':[-0.]},{'a':1.,'nested':[-0.]})
        with self.assertRaisesRegex(ValueError,'canonical_metric_dictionary_mismatch'):
            q.canonical_equal({'a':0.},{'a':-0.})
        with self.assertRaises(ValueError):q.canonical_equal({'a':np.nan},{'a':0.})

    def test_mapper_pointer_hash_checked_after_cached_name(self):
        raw=q.encoded({'atoms':[[10,20],[20,10]],'weights':[0.5,0.5],'b':20.,'epsilon':0.05})
        pointer={'name':'mapper.json','sha256':q.digest(raw)}
        occurrence={'descriptor':{'mapper':pointer}}
        cache={}
        with patch.object(q,'recover_distribution',side_effect=lambda base,descriptor:base):
            first=q.recover_occurrence(occurrence,{'mapper.json':raw},cache)
            self.assertIs(q.recover_occurrence(occurrence,{'mapper.json':raw},cache),first)
            changed=copy.deepcopy(occurrence)
            changed['descriptor']['mapper']['sha256']='0'*64
            with self.assertRaisesRegex(ValueError,'frozen_bytes_mismatch:distribution_mapper'):
                q.recover_occurrence(changed,{'mapper.json':raw},cache)
            self.assertEqual(len(cache),1)

    def test_complete_count_key_set_required(self):
        expected={key:1 for key in q.COUNT_KEYS};config={'inputCounts':expected}
        q.counts_or_fail(expected,config)
        for changed in ({},expected|{'extra':1},expected|{'outerGames':2}):
            with self.assertRaisesRegex(ValueError,'scored_population_mismatch'):q.counts_or_fail(changed,config)

    def scored_fixture(self):
        files={};admitted={'records':[]}
        for season,week,game in ((2010,6,'a'),(2010,7,'b'),(2011,1,'c')):
            record={'family':'N0','setting':0,'game_id':game,'native_failure':None,'distribution':{}}
            files[f'forecasts-{season}-{week:02}.json']=q.encoded({'full_setting_forecasts':[record],'outer_selected_forecasts':[]})
            files[f'inner-losses-{season}-{week:02}.json']=q.encoded([{'family':'N0','setting':0,'game_id':game,'native_failure':None,'metrics':{'probe':1}}])
            admitted['records'].append({'gameId':game,'homeScore':21,'awayScore':17})
        return files,admitted

    def test_original_inner_double_grid_flags_and_order_corruption(self):
        files,admitted=self.scored_fixture()
        with patch.object(q,'registered_series',return_value=[('N0','full')]):
            rows=list(q.scoring_occurrences(files,{},admitted))
            self.assertEqual([r['doubleGrid'] for r in rows],[True,False,True])
            self.assertTrue(all(not r['diagnostics'] for r in rows))
            modified=dict(files);name='inner-losses-2010-06.json';value=json.loads(modified[name]);value[0]['game_id']='wrong';modified[name]=q.encoded(value)
            with self.assertRaisesRegex(ValueError,'forecast_loss_key_order_mismatch'):list(q.scoring_occurrences(modified,{},admitted))
            modified=dict(files);value=json.loads(modified[name]);value[0]['native_failure']='changed';modified[name]=q.encoded(value)
            with self.assertRaisesRegex(ValueError,'failure_record_mismatch'):list(q.scoring_occurrences(modified,{},admitted))

    def gate(self):
        return json.loads((ROOT/'config/research-team-score-compute.v1.json').read_text())['efficiencyGate']

    def test_all_paired_passes_minimum_savings_and_cost_screen(self):
        gate=self.gate()
        good=q.efficiency_result([20,21,22],[10,11,12],500,gate)
        self.assertTrue(good['passed']);self.assertEqual(good['minimumSavingsSeconds'],10)
        self.assertEqual(good['screenProjectedSeconds'],gate['originalPilotElapsed']+(gate['originalMeanOuterSeconds']-5)*gate['originalRemainingWork']+gate['originalInferenceProjection'])
        for b,c,rss in (([20,20,20],[10,10,21],500),([20,20,20],[15,15,15],500),([2,2,2],[1,1,1],500),([20,20,20],[10,10,10],4097)):
            self.assertFalse(q.efficiency_result(b,c,rss,gate)['passed'])
        bad=q.efficiency_result([20,20,20],[10,10,18],500,gate)
        self.assertEqual(bad['minimumSavingsSeconds'],2);self.assertFalse(bad['passed'])

    def test_nonfinite_invalid_or_incomplete_timings_fail_closed(self):
        gate=self.gate()
        for b,c,rss in (([20,20],[10,10],500),([20,np.nan,20],[10,10,10],500),([0,20,20],[10,10,10],500),([20,20,20],[-1,10,10],500),([20,20,20],[10,10,10],np.nan),([20,20,20],[10,10,10],-1)):
            with self.assertRaisesRegex(ValueError,'invalid_timing_measurements'):q.efficiency_result(b,c,rss,gate)


if __name__=='__main__':unittest.main()
