def run(repository_root, acceptance_path, acceptance_sha256, phase_file, started_monotonic):
    """One worker. Final acceptance is mandatory; no resume or alternate limits."""
    envelope = ControllerEnvelope(started_monotonic)
    store = accounting = None
    progress = {'phase': 'prefit_acceptance', 'completed_origins': 0,
                'counts_scope': 'completed_saved_grading_batches', 'counts': {key: 0 for key in COUNT_KEYS}, 'artifacts': {}}
    manifest_sha = None
    try:
        phase, _ = _read_phase(Path(phase_file))
        require(phase['phase'] == 'starting', 'owned_starting_watchdog_phase_required')
        ready = envelope.call(preflight, repository_root, acceptance_path, acceptance_sha256, envelope.check)
        manifest, manifest_sha, config = ready['manifest'], ready['manifest_sha256'], ready['config']
        require(hashlib.sha256(strict(manifest)).hexdigest() == manifest_sha, 'manifest_store_encoding_mismatch')
        store = Store(OUTPUT_PARENT, ready['identity'])
        require(store.write('manifest.json', manifest) == manifest_sha, 'manifest_write_mismatch')
        store.write('started.json', {'actual_computation_at': datetime.now(timezone.utc).isoformat(),
            'envelope_started_monotonic': envelope.started, 'worker_started_elapsed_seconds': envelope.elapsed(),
            'watchdog_phase_path': str(Path(phase_file)), 'historical_status': 'retrospective_inferred'})
        progress['phase'] = 'source_admission'
        context = envelope.measure_phase('admission', admit_source, repository_root, envelope.check)
        admission = _admission_evidence(context)
        store.write('admission.json', admission)
        progress['artifacts']['admission'] = store.pointer('admission.json')
        progress['phase'] = 'complete_synthetic_smoke'
        smoke = run_smoke(envelope, phase_file)
        store.write('smoke.json', smoke)
        progress['artifacts']['smoke'] = store.pointer('smoke.json')
        accounting = OriginAccounting(envelope, context.origins)
        evidence = _chronological_origins(context, store, manifest, manifest_sha, config, envelope, accounting, progress)
        progress['phase'] = 'saved_public_inference_inputs'
        metadata, rows, score_pointers = _saved_inference_inputs(context, store, manifest_sha, config, evidence, envelope)
        ledger = envelope.call(accounting.snapshot)
        require(all(row['complete'] and row['error_type'] is None
                    and all(call['error_type'] is None for call in row['callbacks']) for row in ledger['origins']),
                'unresolved_scientific_call_failure')
        store.write('accounting.json', ledger)
        progress['artifacts']['accounting'] = store.pointer('accounting.json')
        # Each True value below is backed by a fixed pre-fit qualification,
        # actual authenticated admission, successful chronological publication /
        # grading / prior-only selection, complete variant counts and strict rows.
        audits = {'admission': True, 'leakage': True, 'falsification': True, 'no_new_numerical_failure': True}
        store.write('inference-input-index.json', {'metadata': metadata, 'source_scores': score_pointers,
            'series': [{'key': list(key), 'rows': len(values), 'sha256': hashlib.sha256(strict(values)).hexdigest()}
                       for key, values in rows.items()], 'audit_checks': audits,
            'audit_evidence': {**progress['artifacts'], 'prefit_qualification': manifest['qualification'],
                               'prefit_reviews': manifest['independent_reviews']}})
        progress['artifacts']['inference_inputs'] = store.pointer('inference-input-index.json')
        progress['phase'] = 'complete_public_inference'
        began = envelope.elapsed()
        result = envelope.call(evaluate, config, metadata, rows, audits)
        inference_seconds = envelope.elapsed() - began
        store.write('evaluation.json', result)
        progress['artifacts']['evaluation'] = store.pointer('evaluation.json')
        require(result['status'] != 'protocol_invalid', 'complete_public_inference_invalid:' + str(result.get('reason', 'see_saved_evaluation')))
        require(result['status'] in ('reject_all', 'mechanism_supported_distribution_unqualified', 'research_shadow_candidate'),
                'unknown_statistical_terminal')
        del rows, metadata, result, ledger
        # Reauthenticate source code after execution without refitting or
        # reopening the complete historical archive a second time.
        for path, fingerprint in manifest['code_hashes'].items():
            envelope.call(bound, ROOT/path, fingerprint)
        envelope.call(bound, ROOT/CONFIG, CONFIG_SHA)
        envelope.call(validate_runtime_files, envelope.check)
        envelope.call(bound, ROOT / COMPUTE_PROTOCOL_PATH, COMPUTE_PROTOCOL_SHA)
        envelope.call(bound, ROOT / RESOURCE_PROTOCOL_PATH, RESOURCE_PROTOCOL_SHA)
        envelope.call(bound, ROOT / RESOURCE_POLICY_PATH, RESOURCE_POLICY_SHA)
        envelope.call(bound, ROOT / GUARD_PROTOCOL_PATH, GUARD_PROTOCOL_SHA)
        envelope.call(validate_predecessor_terminal, envelope.check)
        progress['phase'] = 'terminal_publication'
        evaluation = store.read_bound(progress['artifacts']['evaluation'])
        terminal = {'version': 'rfcomp09.terminal.v1', 'status': evaluation['status'],
            'manifest_sha256': manifest_sha, **progress, 'seconds': envelope.elapsed(),
            'public_inference_seconds': inference_seconds, 'peak_rss_mib': envelope.peak_rss_mib,
            'production_authorized': False, 'prospective_evidence': False, 'provider_requests': 0,
            'automatic_restart': False, 'external_five_percent_achieved': False,
            'independent_actual_result_acceptance': False,
            'post_terminal_independent_numerical_and_temporal_review_required': True}
        store.finish(terminal, envelope.check)
        envelope.check()
        return {'status': terminal['status'], 'run_directory': str(store.path),
                'independent_actual_result_acceptance': False}
    except BaseException as error:
        # Never create a competing terminal after atomic completion committed,
        # including a post-rename fsync/deadline failure with uncertain durability.
        if store is not None and store.finalized:
            raise
        # Anchor metadata allowance to the actual exception/earliest deadline,
        # before constructing diagnostic metadata or copying a failed ledger.
        if envelope.phase == 'science':
            try:
                envelope.check()
                envelope._stop('controller_exception:' + type(error).__name__, time.monotonic())
            except RuntimeStop:
                pass
        terminal = {'version': 'rfcomp09.terminal.v1', 'status': 'protocol_invalid',
            'manifest_sha256': manifest_sha, **progress, 'reason': str(error), 'error_type': type(error).__name__,
            'clock_failure': copy.deepcopy(envelope._clock_failure),
            'seconds': envelope.elapsed(), 'production_authorized': False, 'prospective_evidence': False,
            'provider_requests': 0, 'automatic_restart': False, 'independent_actual_result_acceptance': False,
            'post_terminal_independent_numerical_and_temporal_review_required': True,
            'last_origin_accounting': copy.deepcopy(accounting._origins[-1]) if accounting and accounting._origins else None}
        if store is not None:
            try:
                envelope.finalize_invalid(store, terminal)
            except BaseException as closure_error:
                if isinstance(error, (KeyboardInterrupt, SystemExit)):
                    raise error from closure_error
                raise
        if isinstance(error, (KeyboardInterrupt, SystemExit)) or store is None:
            raise
        return {'status': 'protocol_invalid', 'run_directory': str(store.path), 'reason': str(error),
                'independent_actual_result_acceptance': False}
    finally:
        envelope.close()
        if store is not None:
            store.close()


def _worker_main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--repository-root', required=True)
    parser.add_argument('--implementation-acceptance', required=True)
    parser.add_argument('--implementation-acceptance-sha256', required=True)
    parser.add_argument('--watchdog-phase-file', required=True)
    parser.add_argument('--envelope-started-monotonic', required=True, type=float)
    args = parser.parse_args()
    result = run(args.repository_root, args.implementation_acceptance, args.implementation_acceptance_sha256,
                 args.watchdog_phase_file, args.envelope_started_monotonic)
    print(json.dumps(result, sort_keys=True, allow_nan=False))
    return 1 if result['status'] == 'protocol_invalid' else 0


if __name__ == '__main__':
    raise SystemExit(_worker_main())
