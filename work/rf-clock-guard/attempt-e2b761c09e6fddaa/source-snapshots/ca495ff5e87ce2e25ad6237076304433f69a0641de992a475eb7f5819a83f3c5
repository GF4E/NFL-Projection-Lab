def save(kind, **values):
    row = {'kind': kind, **values}
    json.dumps(row, sort_keys=True, allow_nan=False)
    OBSERVATIONS.append(row)
    return row


def fixture_module(path, name):
    spec = importlib.util.spec_from_file_location(name, ROOT / path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def definitions(module):
    tree = ast.parse(Path(module.__file__).read_bytes())
    return {n.name: n for n in tree.body if isinstance(n, (ast.FunctionDef, ast.ClassDef))}


def array_image(array):
    return {'dtype': array.dtype.str, 'shape': list(array.shape),
            'c_bytes_hex': array.tobytes(order='C').hex(),
            'writeable': bool(array.flags.writeable)}


def original_images(case):
    return json.loads(original_runtime.strict({
        'source_laws': {k: list(v.values()) for k, v in case.view['source_laws'].items()},
        'mappers': {str(k): {'atoms': array_image(v.atoms), 'weights': array_image(v.weights),
                            'b': v.b, 'epsilon': v.epsilon}
                    for k, v in case.view['mappers'].items()}}))


