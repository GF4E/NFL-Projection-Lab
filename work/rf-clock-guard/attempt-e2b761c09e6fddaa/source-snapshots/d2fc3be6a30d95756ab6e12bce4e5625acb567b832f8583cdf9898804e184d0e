class Clock:
    def __init__(self):self.now=time.monotonic();self.trace=[];self.hook=None;self.live=True
    def __call__(self):
        value=time.monotonic() if self.live else self.now;self.trace.append({'event':'acquire','value':value.hex()})
        hook,self.hook=self.hook,None
        if hook:hook()
        self.trace.append({'event':'return','value':value.hex()});return value

@contextmanager
def controlled():
    clock=Clock()
    class Envelope(unit.ControllerEnvelope):
        def _arm(self):pass
        def elapsed(self):return clock.now-self.started
    previous=signal.getsignal(signal.SIGALRM)
    with patch.object(unit,'time',SimpleNamespace(monotonic=clock)),patch.object(unit,'rss_mib',return_value=16.):
        env=Envelope();clock.live=False;clock.now=env._last
        try:yield env,clock
        finally:env.close()
    assert signal.getsignal(signal.SIGALRM) is previous
    assert signal.getitimer(signal.ITIMER_REAL)==(0.,0.)

def inject_line(function, lineno, callback):
    old=sys.gettrace(); fired=[]
    def trace(frame,event,arg):
        if frame.f_code is function.__code__ and event=='line' and frame.f_lineno==lineno and not fired:
            fired.append(lineno);callback()
        return trace
    return old,trace,fired

class InterleavingTests(unittest.TestCase):
    def test_original_exact_body_counterexample_and_true_reversal(self):
        path=ROOT/'scripts/research_score_resource_policy.py';tree=ast.parse(path.read_text())
        cls=next(n for n in tree.body if isinstance(n,ast.ClassDef) and n.name=='RuntimeEnvelope')
        method=next(n for n in cls.body if isinstance(n,ast.FunctionDef) and n.name=='check')
        class Stop(BaseException):pass
        results=[]
        for nested in (True,False):
            trace=[]; state=SimpleNamespace(phase='science',stop_reason=None,_last=99.,_deadline=1000.,_smoke_deadline=None,peak_rss_mib=0.)
            samples=iter([100.,101.] if nested else [100.,99.]);once=[False]
            def clock():
                v=next(samples);trace.append(['acquired',v])
                if nested and not once[0]:once[0]=True;state.check()
                return v
            def stop(reason,*a):raise Stop(reason)
            state._stop=stop
            namespace={'time':SimpleNamespace(monotonic=clock),'math':math,'rss_mib':lambda:16.,'finite':lambda x:math.isfinite(x),'RuntimeStop':Stop}
            exec(compile(ast.Module(body=[method],type_ignores=[]),str(path),'exec'),namespace)
            state.check=MethodType(namespace['check'],state)
            with self.assertRaisesRegex(Stop,'invalid_monotonic_clock'):
                state.check()
                if not nested:state.check()
            results.append({'nested':nested,'trace':trace,'last':state._last})
        save('original_counterexample',source_sha256=hashlib.sha256(path.read_bytes()).hexdigest(),cases=results)

    def test_nested_sample_request_takes_no_nested_sample_and_is_serviced(self):
        with controlled() as (env,clock):
            trace=[];clock.trace=[];clock.now+=1.
            def nested():
                before=len(clock.trace);clock.now+=1.;env._watchdog(signal.SIGALRM,None)
                self.assertEqual(len(clock.trace),before);self.assertTrue(env._check_pending);trace.append('nested_deferred')
            clock.hook=nested;env.check()
            self.assertEqual(env._last,clock.now);self.assertFalse(env._check_active)
            self.assertGreaterEqual(sum(x['event']=='acquire' for x in clock.trace),2)
            save('nested_sample',trace=clock.trace,events=trace,last=env._last.hex())

    def test_every_guard_line_entry_pending_release_interleaving(self):
        lines,start=inspect.getsourcelines(unit.ControllerEnvelope.check)
        targets=[start+i for i,s in enumerate(lines) if s.strip() and not s.lstrip().startswith(('def ','#','"""'))]
        records=[]
        for line in targets:
            with controlled() as (env,clock):
                clock.trace=[];clock.now+=1.;events=[]
                def nested():
                    events.append({'active_before':env._check_active,'pending_before':env._check_pending})
                    clock.now+=1.;env._watchdog(signal.SIGALRM,None)
                old,trace,fired=inject_line(unit.ControllerEnvelope.check,line,nested)
                sys.settrace(trace)
                try:env.check()
                finally:sys.settrace(old)
                self.assertFalse(env._check_active);self.assertEqual(env.phase,'science')
                if fired:self.assertEqual(env._last,clock.now)
                records.append({'line':line,'fired':bool(fired),'events':events,'samples':clock.trace,'last':env._last.hex()})
        self.assertGreaterEqual(sum(r['fired'] for r in records),6)
        save('guard_line_interleavings',records=records)

    def test_nested_branch_assignment_and_return_requests_are_serviced(self):
        lines,start=inspect.getsourcelines(unit.ControllerEnvelope.check)
        targets=[start+i for i,line in enumerate(lines) if '_check_pending = True' in line or line.strip()=='return']
        records=[]
        for target in targets:
            with controlled() as (env,clock):
                fired=[];old=sys.gettrace()
                def trace(frame,event,arg):
                    if frame.f_code is unit.ControllerEnvelope.check.__code__ and event=='line' and frame.f_lineno==target and env._check_active and not fired:
                        fired.append(target);clock.now+=1.;env._watchdog(signal.SIGALRM,None)
                    return trace
                clock.hook=lambda:env._watchdog(signal.SIGALRM,None)
                sys.settrace(trace)
                try:env.check()
                finally:sys.settrace(old)
                self.assertFalse(env._check_active);self.assertEqual(env._last,clock.now)
                records.append({'line':target,'fired':bool(fired),'samples':clock.trace})
        self.assertGreaterEqual(sum(r['fired'] for r in records),2)
        save('nested_branch_interleavings',records=records)

