    def test_finite_repeated_pending_requests_do_not_recurse(self):
        with controlled() as (env,clock):
            calls=[]
            def rss():
                calls.append(len(inspect.stack()));clock.now+=.01
                if len(calls)<=20:env._watchdog(signal.SIGALRM,None)
                return 16.
            with patch.object(unit,'rss_mib',side_effect=rss):env.check()
            self.assertEqual(len(calls),21);self.assertEqual(min(calls),max(calls));self.assertFalse(env._check_active)
            save('finite_pending_drain',checks=len(calls),stack_depths=calls)

class FailureTests(unittest.TestCase):
    def test_true_reversal_and_nonfinite_are_not_retried(self):
        for label,value in [('backward',-1.),('nan',float('nan')),('positive_infinity',float('inf')),('negative_infinity',-float('inf'))]:
            with controlled() as (env,clock):
                clock.now=env._last-1 if label=='backward' else value;clock.trace=[]
                with self.assertRaisesRegex(unit.RuntimeStop,'invalid_monotonic_clock'):env.check()
                self.assertFalse(env._check_active);self.assertEqual(env.phase,'stopped')
                self.assertEqual(env._clock_failure['sample']['float_hex'],clock.now.hex())
                self.assertEqual(env._clock_failure['previous_last']['float_hex'],env._last.hex())
                save('clock_failure',case=label,samples=len(clock.trace),reason=env.stop_reason,diagnostic=env._clock_failure)

