    def test_actual_complete_smoke_success_failure_and_reentry(self):
        from research_score_split_watchdog import _write_phase, _read_phase
        for fail in (False,True):
            with tempfile.TemporaryDirectory() as folder:
                path=Path(folder)/'phase.json'
                _write_phase(path,{'version':'rf02f.owned-phase.v1','owner':'a'*32,'phase':'starting',
                                  'smoke_started':None,'smoke_finished':None},initial=True)
                with unit.ControllerEnvelope() as env:
                    marker=KeyboardInterrupt('body interrupt')
                    try:
                        with env.complete_smoke(path):
                            self.assertEqual(_read_phase(path)[0]['phase'],'smoke')
                            self.assertIsNotNone(env._whole_smoke_deadline)
                            if fail:raise marker
                    except KeyboardInterrupt as error:self.assertTrue(fail);self.assertIs(error,marker)
                    phase=_read_phase(path)[0]
                    self.assertEqual(phase['phase'],'smoke' if fail else 'science')
                    self.assertIsNone(env._whole_smoke_deadline)
                    with self.assertRaisesRegex(ValueError,'reuse'):
                        with env.complete_smoke(path):self.fail('reused smoke')
                    save('actual_complete_smoke',failed=fail,phase=phase)

    def test_real_signal_pending_crosses_real_deadline(self):
        previous=signal.getsignal(signal.SIGALRM);calls=[]
        with unit.ControllerEnvelope() as env:
            def rss():
                calls.append({'active':env._check_active,'before_pending':env._check_pending})
                if len(calls)==1:
                    env._deadline=time.monotonic()+.02
                    signal.setitimer(signal.ITIMER_REAL,.005)
                    time.sleep(.04)
                    self.assertTrue(env._check_pending)
                return 16.
            with patch.object(unit,'rss_mib',side_effect=rss),self.assertRaisesRegex(unit.RuntimeStop,'9000'):env.check()
            self.assertFalse(env._check_active);self.assertEqual(env.phase,'stopped')
            save('real_signal_pending_deadline',calls=calls,reason=env.stop_reason)
        self.assertIs(signal.getsignal(signal.SIGALRM),previous);self.assertEqual(signal.getitimer(signal.ITIMER_REAL),(0.,0.))

