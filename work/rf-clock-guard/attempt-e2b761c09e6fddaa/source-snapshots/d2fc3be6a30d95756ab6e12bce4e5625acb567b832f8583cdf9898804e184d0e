    def test_pending_failure_propagates_original_without_drain(self):
        for cls in (ValueError,KeyboardInterrupt,SystemExit):
            with controlled() as (env,clock):
                failure=cls('original');calls=[]
                def rss():calls.append(1);env._watchdog(signal.SIGALRM,None);raise failure
                with patch.object(unit,'rss_mib',side_effect=rss):
                    try:env.check()
                    except BaseException as actual:self.assertIs(actual,failure)
                    else:self.fail('original exception lost')
                self.assertEqual(len(calls),1);self.assertFalse(env._check_active)
                save('original_exception',type=cls.__name__,checks=len(calls),pending=env._check_pending)

    def test_exception_release_signal_cannot_replace_original(self):
        for cls in (ValueError,KeyboardInterrupt,SystemExit):
            with controlled() as (env,clock):
                primary=cls('primary');secondary=ValueError('nested replacement');calls=[];fired=[]
                def rss():
                    calls.append(1)
                    raise primary if len(calls)==1 else secondary
                old=sys.gettrace()
                def trace(frame,event,arg):
                    if frame.f_code is unit.ControllerEnvelope.check.__code__ and event=='return' and not env._check_active and not fired:
                        fired.append(True);env._watchdog(signal.SIGALRM,None)
                    return trace
                actual=None
                with patch.object(unit,'rss_mib',side_effect=rss):
                    sys.settrace(trace)
                    try:env.check()
                    except BaseException as error:actual=error
                    finally:sys.settrace(old)
                save('exception_release_signal',original=cls.__name__,actual=None if actual is None else type(actual).__name__,
                     same_exception=actual is primary,rss_calls=len(calls),injected=bool(fired))
                self.assertTrue(fired);self.assertIs(actual,primary);self.assertEqual(len(calls),1)

    def test_later_watchdog_rethrows_primary_until_explicit_check(self):
        for target in ('rss','deadline'):
            with controlled() as (env,clock):
                primary=KeyboardInterrupt('swallowed for test');calls=[]
                def fail():calls.append(1);raise primary
                with patch.object(unit,'rss_mib',side_effect=fail):
                    try:env.check()
                    except KeyboardInterrupt as error:self.assertIs(error,primary)
                    for _ in range(2):
                        try:env._watchdog(signal.SIGALRM,None)
                        except BaseException as error:self.assertIs(error,primary)
                        else:self.fail('handler silently ignored primary')
                self.assertEqual(len(calls),1)
                if target=='deadline':clock.now=env.started+9001.
                with patch.object(unit,'rss_mib',return_value=4097. if target=='rss' else 16.),self.assertRaises(unit.RuntimeStop):env.check()
                self.assertIn('4096' if target=='rss' else '9000',env.stop_reason)
                save('latched_primary_then_explicit_check',target=target,reason=env.stop_reason,failed_rss_calls=len(calls))

    def test_latch_write_and_explicit_reset_signal_boundaries(self):
        lines,start=inspect.getsourcelines(unit.ControllerEnvelope.check)
        latch=next(start+i for i,line in enumerate(lines) if '_check_failed_error = error' in line)
        reset=next(start+i for i,line in enumerate(lines) if '_check_failed_error = None' in line)
        after_reset=next(start+i for i,line in enumerate(lines) if 'while True:' in line)
        records=[]
        for target in (latch,reset,after_reset):
            with controlled() as (env,clock):
                primary=KeyboardInterrupt('primary');calls=[]
                if target!=latch:env._check_failed_error=primary
                def rss():
                    calls.append(1)
                    if target==latch:raise primary
                    return 16.
                old,trace,fired=inject_line(unit.ControllerEnvelope.check,target,lambda:env._watchdog(signal.SIGALRM,None))
                actual=None
                with patch.object(unit,'rss_mib',side_effect=rss):
                    sys.settrace(trace)
                    try:env.check()
                    except BaseException as error:actual=error
                    finally:sys.settrace(old)
                self.assertTrue(fired);self.assertFalse(env._check_active)
                if target in (latch,reset):self.assertIs(actual,primary)
                else:self.assertIsNone(actual);self.assertIsNone(env._check_failed_error);self.assertEqual(len(calls),2)
                self.assertEqual(len(calls),1 if target==latch else 0 if target==reset else 2)
                records.append({'line':target,'rss_calls':len(calls),'same_primary':actual is primary,'active':env._check_active})
        save('latch_reset_boundary_interleavings',records=records)

