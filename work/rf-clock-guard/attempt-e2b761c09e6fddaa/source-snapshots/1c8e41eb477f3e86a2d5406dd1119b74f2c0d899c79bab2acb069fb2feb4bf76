    def test_counts_failure_records_and_complete_ledgers_are_required(self):
        cases = [
            ("terminal-decision.json", lambda v: v.update(nativeFailures=1), "qualification_not_accepted"),
            ("terminal-decision.json", lambda v: v.update(equalityFailures=False), "qualification_not_accepted"),
            ("terminal-decision.json", lambda v: v.update(canonicalEqualOccurrences=5), "qualification_population_mismatch"),
            ("occurrence-ledger.json", lambda v: v.pop(), "qualification_equality_ledger_count_mismatch"),
            ("occurrence-ledger.json", lambda v: v[0].update(nativeFailure="changed"), "qualification_equality_ledger_invalid"),
            ("occurrence-ledger.json", lambda v: v[1].update(v[0]), "qualification_duplicate_occurrence"),
            ("occurrence-ledger.json", lambda v: v[2].update(diagnostics=False), "qualification_outer_flags_changed"),
            ("occurrence-ledger.json", lambda v: v[1].update(doubleGrid=True), "qualification_inner_flags_changed"),
            ("timing-pass-0.json", lambda v: v["occurrences"].pop(), "qualification_timing_population_mismatch"),
            ("timing-pass-1.json", lambda v: v["occurrences"][0].update(order=["baseline", "candidate"]),
             "qualification_timing_ledger_invalid"),
            ("timing-pass-2.json", lambda v: v["occurrences"][0].update(baselineSeconds=7.0),
             "qualification_timing_totals_mismatch"),
        ]
        for name, change, expected in cases:
            with self.subTest(name=name, expected=expected), tempfile.TemporaryDirectory() as temp:
                fixture = self.fixture(Path(temp).resolve())
                self.revise_artifact(fixture, name, change)
                with self.assertRaisesRegex(ValueError, expected):
                    self.verify(fixture)

    def test_efficiency_is_recomputed_without_best_pass_selection(self):
        config = json.loads(runner.read_regular(ROOT / "config/research-team-score-compute.v1.json"))
        runner.verify_efficiency(self.efficiency(config, [20.0] * 3, [10.0] * 3), config)
        for baseline, candidate, rss in (
                ([20.0] * 3, [10.0, 10.0, 21.0], 256.0),  # One slower pass.
                ([20.0] * 3, [14.1] * 3, 256.0),          # Ratio threshold.
                ([10.0] * 3, [5.0] * 3, 256.0),          # Absolute conservative projection.
                ([20.0] * 3, [10.0] * 3, 4096.01)):
            with self.subTest(baseline=baseline, candidate=candidate, rss=rss):
                with self.assertRaisesRegex(ValueError, "qualification_efficiency_not_passed"):
                    runner.verify_efficiency(self.efficiency(config, baseline, candidate, rss), config)
        for field, value in (("minimumSavingsSeconds", 100.0), ("medianRatio", 0.0),
                             ("screenProjectedSeconds", 1.0), ("passed", 1), ("rssMiB", float("nan")),
                             ("baselineSeconds", [float("inf")] * 3)):
            efficiency = self.efficiency(config, [20.0] * 3, [10.0] * 3)
            efficiency[field] = value
            with self.subTest(field=field), self.assertRaises(ValueError):
                runner.verify_efficiency(efficiency, config)

