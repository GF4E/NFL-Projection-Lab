    def fixture(self, parent):
        root = parent / "checkout"
        (root / Path(runner.ANCHOR_PATH).parent).mkdir(parents=True)
        output_parent = parent / "research-data"
        output_parent.mkdir()
        codes = {name: runner.digest(name.encode()) for name in runner.CODE_FILES + runner.TEST_FILES}
        old_sources = {name: codes[name] for name in runner.numerical.CODE_FILES + runner.numerical.TEST_FILES}
        bindings = {"acceptance": "a" * 64, "config": "b" * 64, "specification": "c" * 64,
                    "predecessorConfig": "d" * 64, "predecessorImplementation": "e" * 64}
        runtime = {"isolatedMode": True, "modelWorkers": 1}
        config = json.loads(runner.read_regular(ROOT / "config/research-team-score-compute.v1.json"))
        config["frozenSourceHashes"] = old_sources
        # A small, explicitly synthetic complete population exercises the same verifier.
        counts = {"fullSettingScoredOccurrences": 2, "outerScoredOccurrences": 4, "allScoredOccurrences": 6,
                  "outerGames": 2, "outerSeries": 2}
        config["inputCounts"].update(counts)
        manifest = {"version": "rf02c-qualification.v1", "bindings": bindings, "runtime": runtime,
                    "frozenSourceHashes": old_sources,
                    "codeHashes": {name: codes[name] for name in runner.QUALIFICATION_CODE_FILES},
                    "inputManifestSha256": config["inputManifestSha256"],
                    "inputIndexSha256": config["inputIndexSha256"],
                    "footballFits": 0, "newForecasts": 0, "providerRequests": 0, "productionAuthorized": False}
        manifest_raw = runner.encoded(manifest)
        directory = output_parent / ("rf02c-qualification-v1-" + runner.digest(manifest_raw)[:16])
        directory.mkdir()
        ledger = [{"scope": "inner", "originFile": "forecasts-2011-01.json", "key": ["N0", 0, game],
                   "gameId": game, "doubleGrid": i == 0, "diagnostics": False, "nativeFailure": None,
                   "metricSha256": "f" * 64, "canonicalEqual": True} for i, game in enumerate(("g1", "g2"))]
        outer = [{"scope": "outer", "originFile": "forecasts-2013-01.json", "key": [family, "full", game],
                  "gameId": game, "doubleGrid": True, "diagnostics": True, "nativeFailure": None,
                  "metricSha256": "f" * 64, "canonicalEqual": True}
                 for family in ("N0", "S1") for game in ("g1", "g2")]
        efficiency = self.efficiency(config, [20.0] * 3, [10.0] * 3)
        terminal = {"status": "qualified", "equalityFailures": 0, "nativeFailures": 0, "footballFits": 0,
                    "newForecasts": 0, "productionAuthorized": False, "counts": counts,
                    "canonicalEqualOccurrences": 6, "efficiency": efficiency,
                    "independentAcceptance": "pending", "fullReplayAuthorized": False, "seconds": 90.0}
        artifacts = {"manifest.json": manifest_raw, "terminal-decision.json": runner.encoded(terminal),
                     "occurrence-ledger.json": runner.encoded(ledger + outer)}
        for pair in range(3):
            rows = [{"occurrenceIndex": i, "key": row["key"],
                     "order": ["baseline", "candidate"] if (pair + i) % 2 == 0 else ["candidate", "baseline"],
                     "baselineSeconds": 5.0, "candidateSeconds": 2.5, "canonicalEqual": True}
                    for i, row in enumerate(outer)]
            artifacts[f"timing-pass-{pair}.json"] = runner.encoded({"passIndex": pair, "occurrences": rows,
                                                                   "baselineSeconds": 20.0, "candidateSeconds": 10.0})
        for name, raw in artifacts.items():
            (directory / name).write_bytes(raw)
        index_raw = runner.encoded({"files": {name: {"sha256": runner.digest(raw), "bytes": len(raw)}
                                             for name, raw in artifacts.items()}})
        (directory / "artifact-index.json").write_bytes(index_raw)
        receipt = {"version": "rf02c-implementation-acceptance.v1", "result": "accepted_for_one_replay",
                   "independentReviewer": "independent-synthetic-reviewer", "computeBindings": bindings,
                   "codeHashes": codes, "runtime": runtime, "productionAuthorized": False,
                   "providerAccessAllowed": False, "automaticRestart": False,
                   "qualification": {"directory": str(directory), "manifestSha256": runner.digest(manifest_raw),
                                     "indexSha256": runner.digest(index_raw),
                                     "terminalSha256": runner.digest(artifacts["terminal-decision.json"])}}
        self.freeze(root, receipt)
        return root, config, bindings, runtime, codes, output_parent, receipt

    def efficiency(self, config, baseline, candidate, rss=256.0):
        savings = min(before - after for before, after in zip(baseline, candidate))
        ratio = runner.median(after / before for before, after in zip(baseline, candidate))
        gate = config["efficiencyGate"]
        screen = (gate["originalPilotElapsed"]
                  + max(0, gate["originalMeanOuterSeconds"] - savings / gate["pilotOrigins"])
                  * gate["originalRemainingWork"] + gate["originalInferenceProjection"])
        return {"pairedPasses": 3, "baselineSeconds": baseline, "candidateSeconds": candidate,
                "minimumSavingsSeconds": savings, "medianRatio": ratio, "screenProjectedSeconds": screen,
                "rssMiB": rss, "passed": True}

    def freeze(self, root, receipt):
        raw = runner.encoded(receipt)
        (root / runner.IMPLEMENTATION_PATH).write_bytes(raw)
        (root / runner.ANCHOR_PATH).write_bytes(runner.encoded({
            "version": "rf02c-implementation-anchor.v1", "receiptSha256": runner.digest(raw)}))

    def verify(self, fixture):
        return runner.verify_implementation(*fixture[:5], output_parent=fixture[5])

    def revise_artifact(self, fixture, name, transform):
        root, *_, receipt = fixture
        directory = Path(receipt["qualification"]["directory"])
        value = json.loads((directory / name).read_bytes())
        transform(value)
        raw = runner.encoded(value)
        (directory / name).write_bytes(raw)
        index = json.loads((directory / "artifact-index.json").read_bytes())
        index["files"][name] = {"sha256": runner.digest(raw), "bytes": len(raw)}
        index_raw = runner.encoded(index)
        (directory / "artifact-index.json").write_bytes(index_raw)
        receipt["qualification"]["indexSha256"] = runner.digest(index_raw)
        if name == "terminal-decision.json":
            receipt["qualification"]["terminalSha256"] = runner.digest(raw)
        self.freeze(root, receipt)

