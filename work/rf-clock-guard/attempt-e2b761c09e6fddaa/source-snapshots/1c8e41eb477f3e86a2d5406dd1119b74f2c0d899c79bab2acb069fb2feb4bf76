    def test_identity_hash_binds_successor_before_output_creation(self):
        module = runner.build_runner(self.context())
        module.CODE_FILES, module.TEST_FILES = [], []
        module.load_accepted = lambda _root: ({}, {}, {}, {"config": "old"})
        module.runtime_manifest = lambda _config: {"pinned": True}
        identities = []
        class BeforeOutput:
            def __init__(self, parent, identity):
                identities.append(identity)
                raise RuntimeError("captured_before_output")
        module.ImmutableRun = BeforeOutput
        for suffix in ("first", "second"):
            module._COMPUTE_BINDING["implementation_receipt_sha256"] = suffix
            with self.assertRaisesRegex(RuntimeError, "captured_before_output"):
                module.run()
        self.assertTrue(all(identity.startswith("rf02c-v1-") for identity in identities))
        self.assertNotEqual(*identities)
        self.assertEqual(runner.replay.common_mapper.__globals__["JointBase"], runner.legacy.JointBase)

    def test_consumed_compute_identity_cannot_restart(self):
        module = runner.build_runner(self.context())
        module.CODE_FILES, module.TEST_FILES = [], []
        module.load_accepted = lambda _root: ({}, {}, {}, {"config": "synthetic"})
        module.runtime_manifest = lambda _config: {"pinned": True}
        original_store = module.ImmutableRun
        class AfterCreate(original_store):
            def __init__(self, parent, identity):
                super().__init__(parent, identity)
                self.close()
                raise RuntimeError("synthetic_stop_after_identity")
        module.ImmutableRun = AfterCreate
        with tempfile.TemporaryDirectory() as temp:
            module.OUTPUT_PARENT = Path(temp).resolve()
            with self.assertRaisesRegex(RuntimeError, "synthetic_stop_after_identity"):
                module.run()
            with self.assertRaises(FileExistsError):
                module.run()
            self.assertEqual(len(list(module.OUTPUT_PARENT.iterdir())), 1)


