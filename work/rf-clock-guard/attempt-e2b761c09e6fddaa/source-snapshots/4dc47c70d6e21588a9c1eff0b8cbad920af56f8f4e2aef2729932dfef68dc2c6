def load_fixture(filename, name):
    spec = importlib.util.spec_from_file_location(name, ROOT / filename)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


class Clock:
    def __init__(self): self.now = time.monotonic()
    def __call__(self): return self.now
    def advance(self, seconds): self.now += seconds


@contextmanager
def controlled(controller_clock=False, parent_age=None):
    clock = Clock()
    base = unit.ControllerEnvelope if controller_clock else unit.RuntimeEnvelope

    class TestEnvelope(base):
        def _arm(self): pass  # No real timer is needed for a controlled clock.
        def elapsed(self): return clock.now - self.started

    prior = signal.getsignal(signal.SIGALRM)
    with patch.object(unit, 'time', SimpleNamespace(monotonic=clock)):
        args = {} if parent_age is None else {'started_monotonic': clock.now-parent_age}
        envelope = TestEnvelope(**args)
        try:
            yield envelope, clock
        finally:
            envelope.close()
    if signal.getsignal(signal.SIGALRM) is not prior:
        raise AssertionError('test leaked signal handler')


def original_plan():
    origins, seen = [], []
    for year in range(2010, 2026):
        weeks = 17 if year <= 2020 else 18
        count = 256 if year <= 2020 else 271 if year == 2022 else 272
        base, remainder = divmod(count-32, weeks-2)
        sizes = [16, 16] + [base + (i < remainder) for i in range(weeks-2)]
        for week, size in enumerate(sizes, 1):
            games = [f'synthetic-{year}-{week}-{i}' for i in range(size)]
            # Fixed already-seen history gives exact binary cost arithmetic;
            # this is an accounting fixture, not a reconstructed NFL closure.
            history = seen[:16]
            origins.append({'season': year, 'week': week, 'targetGameIds': games,
                'windows': {'12': {'eligibleInputIds': history}},
                'originAt': f'{year}-{week:02d}-synthetic'})
            seen.extend(games)
    return origins


def measured_pilot(origins):
    with controlled() as (envelope, clock):
        envelope.measure_phase('admission', lambda: clock.advance(2.))
        envelope.measure_phase('inference_smoke', lambda: clock.advance(3.))
        accounting = original_runtime.OriginAccounting(envelope, origins)
        for origin in origins[:53]:
            with accounting.origin(origin):
                if origin['season'] == 2013:
                    game = origin['targetGameIds'][0]
                    for kind, duration, failed, fallback, operation in (
                            ('fit', 1/4096, False, False, 'fit'),
                            ('fit', 1/1024, True, False, 'fit'),
                            ('fit', 1/2048, False, True, 'recovery'),
                            ('score', 1/2048, False, False, 'score')):
                        def callback():
                            clock.advance(duration)
                            if failed: raise ValueError('synthetic_failed_callback')
                            return unit.CallbackResult(None, 'native_failure' if fallback else None, fallback)
                        try:
                            accounting.callback(kind, callback, game_id=game, setting=9,
                                variant='full', stage='outer', operation=operation,
                                **({'double_grid': True, 'diagnostics': True} if kind == 'score' else {}))
                        except ValueError as error:
                            if not failed or str(error) != 'synthetic_failed_callback': raise
                clock.advance(1/256)
        return accounting.snapshot()


def tree(module): return ast.parse(Path(module.__file__).read_bytes())
def functions(node):
    return {n.name: n for n in node.body if isinstance(n, (ast.FunctionDef, ast.ClassDef))}


