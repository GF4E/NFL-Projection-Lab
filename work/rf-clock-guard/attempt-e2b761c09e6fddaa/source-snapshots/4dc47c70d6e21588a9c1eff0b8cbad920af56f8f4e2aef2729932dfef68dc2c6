class ProjectionTests(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.origins = original_plan()
        cls.ledger = measured_pilot(cls.origins)

    def project(self, ledger, remaining=None):
        return unit.pilot_projection(self.origins, ledger, self.origins[53:] if remaining is None else remaining)

    def at(self, target):
        ledger = copy.deepcopy(self.ledger)
        first = original_runtime.pilot_projection(self.origins, ledger, self.origins[53:])
        # All synthetic counts/durations use exact binary values: solve only E,
        # preserving every actual interval, failed callback and original formula.
        ledger['elapsed_seconds'] += target - first['projected_total_seconds']
        return ledger

    def test_below_between_at_above_caps_exact_delegated_formula(self):
        for target in (7199., 7200., 8000., 9000., 9000.000000000002):
            ledger = self.at(target)
            old = original_runtime.pilot_projection(self.origins, ledger, self.origins[53:])
            new = self.project(ledger)
            save('pilot_pair', requested_projection=target, original=old, resource=new,
                 ledger_sha256=hashlib.sha256(original_runtime.strict(ledger)).hexdigest())
            self.assertEqual(old['projected_total_seconds'], target)
            self.assertEqual(new, {**old, 'within_time_screen': target <= 9000,
                                  'passed': target <= 9000})
            self.assertEqual(old['within_time_screen'], target <= 7200)
            self.assertEqual((new['fit_slots_per_future_game'], new['score_slots_per_future_game'],
                              new['callback_maximum_multiplier']), (31, 31, 2))

    def test_failures_remain_maxima_and_rss_still_vetoes(self):
        ledger = self.at(8000.); result = self.project(ledger)
        self.assertEqual(result['failed_callback_count'], 2)
        self.assertEqual(result['maximum_fit_seconds'], 1/1024)
        self.assertEqual(result['maximum_score_seconds'], 1/2048)
        self.assertEqual(result['remaining_origins'], 224)
        for rss, passed in ((4096., True), (4096.0001, False)):
            ledger['peak_rss_mib'] = rss; new = self.project(ledger)
            save('rss_projection', rss=rss, result=new)
            self.assertTrue(new['within_time_screen']); self.assertIs(new['passed'], passed)

    def test_invalid_membership_anchor_and_failed_interval_preserve_original_errors(self):
        for case in ('suffix', 'origin', 'fit_anchor', 'outer_flags', 'negative_time'):
            ledger=copy.deepcopy(self.ledger);remaining=copy.deepcopy(self.origins[53:])
            if case=='suffix': remaining.pop()
            elif case=='origin': ledger['origins'][-1]['game_ids'].reverse()
            elif case=='fit_anchor':
                for row in ledger['origins']:
                    for call in row['callbacks']:
                        if call['operation']=='fit': call['operation']='recovery'
            elif case=='outer_flags': ledger['origins'][-1]['callbacks'][-1]['diagnostics']=False
            else: ledger['origins'][-1]['callbacks'][1]['seconds']=-1.
            errors=[]
            for function in (original_runtime.pilot_projection, unit.pilot_projection):
                try: function(self.origins, ledger, remaining)
                except Exception as error: errors.append((type(error),str(error)))
            save('invalid_pilot_pair', case=case, errors=[[e.__module__+'.'+e.__name__,s] for e,s in errors])
            self.assertEqual(len(errors),2);self.assertIs(errors[0][0],errors[1][0]);self.assertEqual(errors[0][1],errors[1][1])


class RuntimeTests(unittest.TestCase):
    def test_initial_9000_deadline_and_no_7200_or_600_stop(self):
        with controlled() as (env, clock):
            self.assertEqual(env._deadline-env.started,9000.)
            env.measure_phase('admission',lambda:clock.advance(601.))
            clock.now=env.started+7200.;env.check()
            clock.now=env.started+8999.5;env.check()
            clock.now=env.started+9000.
            with self.assertRaisesRegex(unit.RuntimeStop,'9000'):env.check()
            save('initial_deadline',stop=env.stop_reason,elapsed=env.scientific_stop_elapsed,deadline=env._deadline-env.started)
            self.assertEqual(env.scientific_stop_elapsed,9000.)
            with self.assertRaises(unit.RuntimeStop):env.call(lambda:self.fail('science after stop'))

    def test_parent_start_counts_imports_and_delayed_delivery(self):
        with controlled(True,parent_age=7300.) as (env,clock):
            self.assertEqual(env._deadline-env.started,9000.);env.check()
            clock.now=env.started+9025.
            with self.assertRaisesRegex(unit.RuntimeStop,'9000'):env.check()
            self.assertEqual(env.scientific_stop_elapsed,9000.)
            save('parent_start_deadline',observed_elapsed=env.elapsed(),scientific_stop=env.scientific_stop_elapsed)

    def test_earlier_smoke_and_failed_callbacks_keep_original_limits(self):
        with controlled(True) as (env,clock):
            env._whole_smoke_deadline=env.started+120.
            clock.now=env.started+9005.
            with self.assertRaisesRegex(unit.RuntimeStop,'complete_smoke'):env.check()
            self.assertEqual(env.scientific_stop_elapsed,120.)
            save('earliest_complete_smoke',elapsed=env.scientific_stop_elapsed,reason=env.stop_reason)
        with controlled() as (env,clock):
            def fails(): clock.advance(121.);raise ValueError('original_callback_failure')
            with self.assertRaisesRegex(unit.RuntimeStop,'120_second_smoke'):
                env.measure_phase('inference_smoke',fails)
            save('smoke_failed_callback',measurements=env.phase_measurements,reason=env.stop_reason)
            self.assertEqual(env.scientific_stop_elapsed,120.)
            self.assertEqual(env.phase_measurements[0]['seconds'],121.)

    def test_memory_boundary_and_interrupt_preservation(self):
        with controlled() as (env,_):
            with patch.object(unit,'rss_mib',return_value=4096.):env.check()
            with patch.object(unit,'rss_mib',return_value=4096.001):
                with self.assertRaisesRegex(unit.RuntimeStop,'4096'):env.check()
            save('memory_stop',reason=env.stop_reason)
        for error in (ValueError,KeyboardInterrupt,SystemExit):
            with controlled() as (env,clock):
                def callback(): clock.now=env.started+9001.;raise error('preserved')
                expected=unit.RuntimeStop if error is ValueError else error
                with self.assertRaises(expected):env.call(callback)
                self.assertEqual(env.stop_reason,'registered_9000_second_deadline')
                save('post_callback_stop',raised=expected.__name__,original=error.__name__,reason=env.stop_reason)

    def test_real_short_signal_escapes_exception_and_restores_handler(self):
        prior=signal.getsignal(signal.SIGALRM)
        with unit.RuntimeEnvelope() as env:
            env._deadline=time.monotonic()+.02;env._arm()
            with self.assertRaisesRegex(unit.RuntimeStop,'9000'):
                try:time.sleep(.12)
                except Exception:self.fail('deadline swallowed')
            save('actual_short_signal',reason=env.stop_reason)
        self.assertIs(signal.getsignal(signal.SIGALRM),prior)
        self.assertEqual(signal.getitimer(signal.ITIMER_REAL),(0.,0.))

    def test_real_invalid_closure_no_science_and_no_second_terminal(self):
        with tempfile.TemporaryDirectory() as folder:
            store=original_runtime.Store(Path(folder).resolve(),'synthetic-resource-grace')
            env=unit.RuntimeEnvelope()
            try:
                old_finish=store.finish
                def finish(value,check):
                    self.assertEqual(env.phase,'metadata_finalization')
                    with self.assertRaises(unit.RuntimeStop):env.call(lambda:self.fail('grace science'))
                    return old_finish(value,check)
                with patch.object(store,'finish',side_effect=finish):
                    terminal=env.finalize_invalid(store,{'status':'protocol_invalid','reason':'synthetic'})
                save('actual_metadata_closure',terminal=terminal,finalized=store.finalized)
                self.assertEqual(terminal['invalid_finalization_only_cap_seconds'],30)
                self.assertTrue(store.finalized)
                with self.assertRaises(ValueError):env.finalize_invalid(store,{'status':'protocol_invalid'})
            finally:env.close();store.close()

    def test_expired_grace_does_not_refresh_after_late_delivery(self):
        with tempfile.TemporaryDirectory() as folder:
            store=original_runtime.Store(Path(folder).resolve(),'synthetic-expired-grace')
            env=unit.RuntimeEnvelope()
            try:
                env.started=time.monotonic()-9031.;env._deadline=env.started+9000.
                with patch.object(store,'finish',side_effect=AssertionError('late terminal write')) as finish:
                    with self.assertRaisesRegex(unit.RuntimeStop,'metadata_finalization'):
                        env.finalize_invalid(store,{'status':'protocol_invalid'})
                self.assertEqual(finish.call_count,0);self.assertFalse(store.finalized)
                self.assertEqual(env.scientific_stop_elapsed,9000.)
                self.assertEqual(env._grace_deadline,env.started+9030.)
                save('expired_grace',reason=env.stop_reason,scientific_stop=env.scientific_stop_elapsed,finalized=store.finalized)
            finally:env.close();store.close()


class WatchdogTests(unittest.TestCase):
    def child(self,code,limits=(2.,256.,1.,.01),phase=False,smoke=.12,public=False):
        with tempfile.TemporaryDirectory() as folder:
            args={'cwd':ROOT,'output_parent':Path(folder),'identity':'synthetic-resource-child'}
            command=[PYTHON,'-I','-c',code]
            before=signal.getsignal(signal.SIGALRM)
            report=(watchdog.supervise(command,**args) if public else
                    watchdog._supervise(command,**args,limits=limits,phase_status=phase,_smoke_seconds=smoke))
            root=Path(folder)/args['identity'];artifacts={}
            for name,pointer in report['artifacts'].items():
                raw=(root/name).read_bytes()
                self.assertEqual(pointer,{'sha256':hashlib.sha256(raw).hexdigest(),'bytes':len(raw)})
                artifacts[name]=raw.decode('utf8')
            save('owned_child',report=report,artifact_bodies=artifacts)
            self.assertEqual(json.loads((root/'process-report.json').read_bytes()),report)
            self.assertFalse(report['scientific_terminal_verified']);self.assertFalse(report['automatic_restart'])
            self.assertEqual(report['worker_grace_seconds'],0)
            self.assertIs(signal.getsignal(signal.SIGALRM),before)
            self.assertEqual(signal.getitimer(signal.ITIMER_REAL),(0.,0.))
            with self.assertRaises(ChildProcessError):os.waitpid(report['pid'],os.WNOHANG)
            return report

    def header(self):
        return ('import sys,time;sys.path.insert(0,'+repr(str(ROOT/'scripts'))+');'
            'from research_score_split_watchdog import transition_phase;'
            "p=sys.argv[sys.argv.index('--watchdog-phase-file')+1];")

    def test_public_9000_policy_and_real_phase_handshake(self):
        report=self.child(self.header()+"transition_phase(p,'smoke');transition_phase(p,'science')",public=True)
        self.assertEqual(report['status'],'completed_process');self.assertEqual(report['exit_code'],0)
        self.assertEqual(report['limits'],{'scientific_seconds':9000.,'rss_mib':4096.,
            'parent_metadata_seconds':30.,'rss_sample_interval_seconds':.05,'complete_smoke_seconds':120.})
        self.assertEqual(report['phase_progression'][-1]['phase'],'science')
        with tempfile.TemporaryDirectory() as folder:
            for limits in ((9000.1,256.,1.,.01),(2.,4096.1,1.,.01),(2.,256.,30.1,.01)):
                with self.assertRaisesRegex(ValueError,'invalid_private_test_limits'):
                    watchdog._supervise([PYTHON,'-I','-c','pass'],cwd=ROOT,output_parent=Path(folder),identity='invalid',limits=limits)
            self.assertEqual(list(Path(folder).iterdir()),[])

    def test_native_signal_suppression_hard_stops_without_worker_grace(self):
        report=self.child("import hashlib,signal;signal.signal(signal.SIGALRM,signal.SIG_IGN);signal.signal(signal.SIGTERM,signal.SIG_IGN);hashlib.pbkdf2_hmac('sha256',b'x',b'y',1000000000)",limits=(.2,256.,1.,.01))
        self.assertEqual(report['stop_reason'],'scientific_wall_deadline')
        self.assertEqual(report['exit_code'],-signal.SIGKILL)
        self.assertAlmostEqual(report['scientific_stop_elapsed_seconds'],.2,places=6)
        self.assertEqual(report['kill_requests'][0]['pgid'],report['pid'])

    def test_short_external_smoke_and_rss_remain_enforced(self):
        report=self.child(self.header()+"transition_phase(p,'smoke');time.sleep(3)",phase=True)
        self.assertEqual(report['stop_reason'],'complete_smoke_deadline')
        self.assertEqual(report['exit_code'],-signal.SIGKILL)
        report=self.child('import time;x=bytearray(80*1024**2);time.sleep(3)',limits=(2.,48.,1.,.01))
        self.assertIn(report['stop_reason'],('sampled_group_rss_limit','waited_worker_peak_rss_limit'))
        self.assertEqual(report['exit_code'],-signal.SIGKILL)

    def test_missing_observation_and_existing_identity_are_not_success(self):
        with patch.object(watchdog,'_observe',return_value=[]):
            report=self.child('import time;time.sleep(3)')
        self.assertEqual(report['status'],'observation_or_setup_failure')
        self.assertTrue(report['observation_errors'])
        with tempfile.TemporaryDirectory() as folder:
            path=Path(folder)/'taken';path.mkdir();(path/'sentinel').write_bytes(b'unchanged')
            with self.assertRaises(FileExistsError):
                watchdog.supervise([PYTHON,'-I','-c',"raise AssertionError('must not spawn')"],
                    cwd=ROOT,output_parent=Path(folder),identity='taken')
            self.assertEqual(list(path.iterdir()),[path/'sentinel'])
            self.assertEqual((path/'sentinel').read_bytes(),b'unchanged')


