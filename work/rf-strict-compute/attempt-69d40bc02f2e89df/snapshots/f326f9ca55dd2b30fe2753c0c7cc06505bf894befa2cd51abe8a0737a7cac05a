    def test_pointer_hash_and_size_fail_before_reader(self):
        good = {'path': 'synthetic-pointer.json', 'sha256': 'a' * 64, 'bytes': 1}
        mutations = [('sha256', x) for x in (None, True, 1, '', 'a' * 63, 'g' * 64)]
        mutations += [('bytes', x) for x in (None, True, 1.0, -1, 0, '1')]
        for field, value in mutations:
            pointer = dict(good); pointer[field] = value
            called = []
            with self.subTest(field=field, value=value), self.assertRaises(ValueError):
                p._pointer(pointer, ROOT, lambda: None, read=lambda *a, **k: called.append(True))
            self.assertEqual(called, [])
        for value in (None, True, '', 'a' * 63):
            with self.assertRaises(ValueError):
                p._stage_evidence({'path': 'stage.json', 'sha256': value}, ROOT, lambda: None,
                                  read=lambda *a, **k: self.fail('invalid stage hash reached reader'))

    def test_null_qualification_review_and_evidence_bypass_closed(self):
        f = Fixture()
        f.acceptance['qualification'].update(sha256=None, bytes=None)
        for pointer in f.acceptance['independent_reviews'].values():
            f.mutate_document(pointer, lambda x: x.update(qualification_sha256=None))
        with self.assertRaisesRegex(ValueError, 'invalid_sha256'): f.run()
        for where in ('review', 'qualification_evidence', 'review_evidence'):
            f = Fixture()
            if where == 'review':
                f.acceptance['independent_reviews']['numerical'].update(sha256=None, bytes=None)
            else:
                pointer = f.acceptance['qualification'] if where == 'qualification_evidence' else f.acceptance['independent_reviews']['numerical']
                f.mutate_document(pointer, lambda x: x['evidence'][0].update(sha256=None, bytes=None))
                if where == 'qualification_evidence':
                    for review in f.acceptance['independent_reviews'].values():
                        f.mutate_document(review, lambda x: x.update(qualification_sha256=pointer['sha256']))
            with self.subTest(where=where), self.assertRaises(ValueError): f.run()

