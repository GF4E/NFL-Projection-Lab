def _launch(argv):
    """Lean parent: external watchdog starts before any scientific child import."""
    from research_score_split_watchdog import supervise
    import re
    parser = argparse.ArgumentParser(description='One accepted RF-02F worker under fixed external limits')
    parser.add_argument('--repository-root', required=True)
    parser.add_argument('--implementation-acceptance', required=True)
    parser.add_argument('--implementation-acceptance-sha256', required=True)
    args = parser.parse_args(argv)
    if Path(args.repository_root).resolve() != ROOT or not re.fullmatch('[0-9a-f]{64}', args.implementation_acceptance_sha256):
        raise ValueError('invalid_fixed_launch_binding')
    # This observation identity cannot be refreshed by changing a timestamp.
    observation = 'rf02f-observer-' + args.implementation_acceptance_sha256[:16]
    started = time.monotonic()
    command = [sys.executable, '-I', str(Path(__file__).resolve()),
        '--repository-root', str(ROOT), '--implementation-acceptance', args.implementation_acceptance,
        '--implementation-acceptance-sha256', args.implementation_acceptance_sha256,
        '--envelope-started-monotonic', repr(started)]
    report = supervise(command, cwd=ROOT, output_parent=ROOT/'work', identity=observation)
    print(json.dumps(report, sort_keys=True, allow_nan=False))
    return 0 if report['status'] == 'completed_process' and report['exit_code'] == 0 else 1


if __name__ == '__main__' and '--watchdog-phase-file' not in sys.argv:
