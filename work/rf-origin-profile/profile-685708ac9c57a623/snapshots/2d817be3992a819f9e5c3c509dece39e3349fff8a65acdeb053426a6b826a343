class RunFailure(ValueError):
    pass


def require(condition, reason):
    if not condition:
        raise RunFailure(reason)


def strict(value):
    return encoded(canonical(value))


def rss_mib():
    return resource.getrusage(resource.RUSAGE_SELF).ru_maxrss / (1024 ** 2 if sys.platform == 'darwin' else 1024)


class Budget:
    def __init__(self):
        self.started = time.monotonic()
        self.admission_started = None
        self.admission_active = False

    def check(self):
        now = time.monotonic()
        require(now - self.started <= 7200 and rss_mib() <= 4096, 'registered_runtime_or_memory_budget_exceeded')
        if self.admission_active:
            require(now - self.admission_started <= 600, 'combined_admission_collection_budget_exceeded')

    def start_admission(self):
        require(self.admission_started is None, 'admission_clock_restart_forbidden')
        self.admission_started, self.admission_active = time.monotonic(), True
        self.check()

    def end_admission(self):
        self.check()
        elapsed = time.monotonic() - self.admission_started
        self.admission_active = False
        return elapsed

    def remaining(self):
        deadlines = [self.started + 7200]
        if self.admission_active:
            deadlines.append(self.admission_started + 600)
        return max(.001, min(deadlines) - time.monotonic())


class Store(ImmutableRun):
    """Strict finite artifacts; completion/ atomically exposes terminal and index."""
    def __init__(self, parent, identity):
        super().__init__(parent, identity)
        self.finalized = False
        self.uncommitted_staging = []
        self.uncommitted_artifacts = set()

    def write(self, name, value):
        require(type(name) is str and name not in ('', '.', '..')
                and all(c in 'abcdefghijklmnopqrstuvwxyz0123456789-.' for c in name), 'invalid_output_name')
        require(not self.finalized and name not in self.index and name not in self.uncommitted_artifacts and name not in
                {'terminal-decision.json', 'terminal-failure.json', 'artifact-index.json'}, 'artifact_rewrite_or_flat_terminal_forbidden')
        raw = strict(value)
        self.uncommitted_artifacts.add(name)
        result = super().write(name, raw)
        self.uncommitted_artifacts.remove(name)
        return result

    def pointer(self, name):
        require(name in self.index, 'unknown_output_artifact')
        return {'name': name, **self.index[name]}

    def read_bound(self, pointer):
        require(type(pointer) is dict and set(pointer) == {'name', 'sha256', 'bytes'}
                and pointer['name'] in self.index and self.index[pointer['name']] ==
                {k: pointer[k] for k in ('sha256', 'bytes')}, 'output_pointer_binding_mismatch')
        raw = self.read(pointer['name'])
        require(len(raw) == pointer['bytes'] and sha(raw) == pointer['sha256'], 'output_artifact_hash_mismatch')
        return parse(raw)

    def finish(self, terminal, budget=None):
        require(not self.finalized, 'terminal_already_committed')
        try:
            os.stat('completion', dir_fd=self.fd, follow_symlinks=False)
        except FileNotFoundError:
            pass
        else:
            raise RunFailure('completion_already_exists')
        if budget is not None: budget()
        raw = strict(terminal)
        files = dict(self.index)
        uncommitted = []
        for name in sorted(self.uncommitted_artifacts):
            try:
                fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=self.fd)
            except FileNotFoundError:
                continue
            with os.fdopen(fd, 'rb') as stream:
                require(stat.S_ISREG(os.fstat(stream.fileno()).st_mode), 'nonregular_uncommitted_artifact')
                body = stream.read()
                os.fsync(stream.fileno())
            files[name] = {'sha256': sha(body), 'bytes': len(body)}
            uncommitted.append(name)
        require(not (uncommitted or self.uncommitted_staging) or terminal['status'] == 'protocol_invalid',
                'uncommitted_prefix_requires_invalid_terminal')
        for directory in self.uncommitted_staging:
            staging_fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=self.fd)
            try:
                for name in ('terminal.json', 'artifact-index.json'):
                    try:
                        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=staging_fd)
                    except FileNotFoundError:
                        continue
                    with os.fdopen(fd, 'rb') as stream:
                        require(stat.S_ISREG(os.fstat(stream.fileno()).st_mode), 'nonregular_staging_evidence')
                        body = stream.read()
                        os.fsync(stream.fileno())
                    files[directory + '/' + name] = {'sha256': sha(body), 'bytes': len(body)}
                os.fsync(staging_fd)
            finally:
                os.close(staging_fd)
        files['completion/terminal.json'] = {'sha256': sha(raw), 'bytes': len(raw)}
        index = strict({'files': files, 'uncommitted_staging': list(self.uncommitted_staging),
                        'uncommitted_artifacts': uncommitted})
        stage_name = '.completion-staging-' + sha(raw)[:16]
        os.mkdir(stage_name, mode=0o700, dir_fd=self.fd)
        self.uncommitted_staging.append(stage_name)
        staging = os.open(stage_name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=self.fd)
        try:
            for name, body in (('terminal.json', raw), ('artifact-index.json', index)):
                fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=staging)
                with os.fdopen(fd, 'wb') as stream:
                    stream.write(body); stream.flush(); os.fsync(stream.fileno())
            os.fsync(staging)
        finally:
            os.close(staging)
        if budget is not None: budget()
        os.rename(stage_name, 'completion', src_dir_fd=self.fd, dst_dir_fd=self.fd)
        self.finalized = True
        os.fsync(self.fd)
        return {'terminal_sha256': sha(raw), 'index_sha256': sha(index)}


def _evidence(pointer):
    require(type(pointer) is dict and set(pointer) == {'path', 'sha256'}, 'invalid_evidence_pointer')
    return parse(bound(pointer['path'], pointer['sha256']))


def preflight(root, acceptance_path, acceptance_sha256, budget):
    root = Path(root).resolve()
    require(root == ROOT, 'runner_repository_mismatch')
    acceptance = parse(bound(acceptance_path, acceptance_sha256))
    require(set(acceptance) == {'version', 'status', 'code_hashes', 'acceptances', 'audit_evidence'}
            and acceptance['version'] == 'rf02d-runner-implementation-acceptance.v1'
            and acceptance['status'] == 'accepted_for_one_bounded_replay', 'final_runner_acceptance_required')
    archive = Archive(PARENT_DIRECTORY)
    expected_files = set(archive.manifest['code_hashes']) | set(CONDITIONAL_FILES)
    require(len(expected_files) == 43 and set(acceptance['code_hashes']) == expected_files, 'exact_43_source_bindings_required')
    for name, digest in acceptance['code_hashes'].items():
        require(not Path(name).is_absolute() and '..' not in Path(name).parts
                and name.startswith(('scripts/research_score_', 'tests/research-score')), 'unsafe_code_path')
        bound(root / name, digest)
    require(all(acceptance['code_hashes'][name] == value for name, value in archive.manifest['code_hashes'].items()),
            'frozen_parent_code_mismatch')
    config = parse(bound(root / 'config/research-team-score-conditional.v1.json', CONFIG_SHA))
    bound(root / config['protocol'], PROTOCOL_SHA)
    require(all(acceptance['code_hashes'][name] == value for name, value in config['accepted_unit_hashes'].items()), 'accepted_finite_unit_mismatch')
    require(all(acceptance['code_hashes'][name] == value for name, value in ADMISSION_SOURCE.items()), 'accepted_admission_source_mismatch')
    require(set(acceptance['acceptances']) == {'admission', 'replay', 'identity', 'inference'}, 'stage_acceptance_membership')
    stages = {name: _evidence(pointer) for name, pointer in acceptance['acceptances'].items()}
    require(acceptance['acceptances']['admission']['sha256'] == ADMISSION_ACCEPTANCE
            and acceptance['acceptances']['replay']['sha256'] == REPLAY_ACCEPTANCE
            and acceptance['acceptances']['identity']['sha256'] == IDENTITY_ACCEPTANCE
            and acceptance['acceptances']['inference']['sha256'] == INFERENCE_ACCEPTANCE, 'frozen_stage_acceptance_mismatch')
    require(all(type(stage.get('status')) is str and stage['status'].startswith('accepted_') for stage in stages.values()),
            'unaccepted_stage')
    old_admission = _evidence(stages['admission']['evidence']['result.json'])
    require(old_admission['status'] == 'passed' and old_admission['counts']['recovered_distributions'] == 68140
            and old_admission['counts']['calibration_cases'] == 56430
            and old_admission['pins'] == {'parent_manifest': PARENT_MANIFEST, 'parent_index': PARENT_INDEX,
                'admitted_data': ADMITTED_DATA, 'config': CONFIG_SHA, 'protocol': PROTOCOL_SHA}, 'actual_admission_acceptance_mismatch')
    identity = stages['identity']
    require(identity['historical_identity_qualification_accepted'] is True and identity['exact_identity_occurrences'] == 520
            and identity['sample_keys_sha256'] == SAMPLE_SHA, 'fixed_identity_acceptance_required')
    identity_receipt = _evidence(identity['evidence']['receipt.json'])
    identity_manifest = _evidence(identity['evidence']['manifest.json'])
    require(len(identity_manifest['accepted_unit_hashes']) == 10
            and all(acceptance['code_hashes'].get(name) == value
                    for name, value in identity_manifest['accepted_unit_hashes'].items()),
            'identity_prior_unit_source_mismatch')
    require(all(acceptance['code_hashes'].get(name) == value
                for name, value in identity_manifest['qualification_source_hashes'].items())
            and set(identity_manifest['qualification_source_hashes']) ==
            {'scripts/research_score_conditional_qualify.py', 'tests/research-score-conditional-margin/test_qualify.py'},
            'accepted_identity_source_mismatch')
    require(identity_receipt['status'] == 'passed' and identity_receipt['complete_count'] == 520
            and identity_receipt['sample_sha256'] == SAMPLE_SHA
            and set(identity_receipt['artifacts']) == {'manifest.json', 'sample.json'} |
                {f'occurrence-{i:03}.json' for i in range(520)}, 'identity_result_mismatch')
    identity_directory = Path(identity['evidence']['receipt.json']['path']).parent
    for name, pointer in identity_receipt['artifacts'].items():
        require(type(name) is str and Path(name).name == name and '..' not in name, 'unsafe_identity_artifact')
        bound(identity_directory / name, pointer['sha256'], pointer['bytes'])
    for stage_name in ('replay', 'inference'):
        for name, digest in stages[stage_name]['accepted_source_hashes'].items():
            require(acceptance['code_hashes'].get(name) == digest, 'stage_accepted_source_mismatch')
    require(set(acceptance['audit_evidence']) == {'leakage', 'falsification'}, 'implementation_audit_membership')
    audits = {name: _evidence(pointer) for name, pointer in acceptance['audit_evidence'].items()}
    require(all(value.get('status') == 'accepted' and value.get('source_hashes') == acceptance['code_hashes']
                for value in audits.values()), 'implementation_audit_not_bound_to_sources')
    budget.check()
