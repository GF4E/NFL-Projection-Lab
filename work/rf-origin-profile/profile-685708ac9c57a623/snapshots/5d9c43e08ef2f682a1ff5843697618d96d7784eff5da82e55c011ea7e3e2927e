                    elif fault == 'publication': (x.store.path / pointer['name']).write_bytes(b'{}')
                    elif fault == 'plan': x.assembly['grading_plan']['outer'][0]['mode'] = 'new_score'
                    elif fault == 'source_pointer': x.assembly['grading_plan']['outer'][0]['source']['forecast_file']['sha256'] = '0'*64
                    else:
                        key = 'outer', 'full', 'z-target'; law = x.assembly['resolved_laws'][key]
                        x.assembly['resolved_laws'][key] = probability.SkellamDistribution(law) if fault == 'law_class' else replace(law, beta=math_next(law.beta))
                    with patch.object(archive, 'grade_inputs', side_effect=AssertionError('premature_labels')) as labels:
                        with self.assertRaises(ValueError): x.grade(grader, acc, pointer, validator)
                        with self.assertRaisesRegex(ValueError, 'grader_stopped'): x.grade(grader, acc, pointer)
                        labels.assert_not_called()

