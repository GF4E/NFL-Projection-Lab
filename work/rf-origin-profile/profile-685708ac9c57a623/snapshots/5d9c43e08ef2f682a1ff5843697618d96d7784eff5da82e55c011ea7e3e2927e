                self.assertEqual(high['value'], row['metrics'][target + '_upper_80'])
                self.assertEqual(low['value'], row['metrics'][target + '_lower_80'] - 1)
                self.assertEqual(high['law_sha256'], fingerprint(law_fields(law)))
                self.assertEqual(low['law_sha256'], high['law_sha256'])
