        self.assertEqual({r['variant'] for r in w['outer_rows'] if r['family'] == 'E3'}, set(forecast.SPLIT_VARIANTS))
        extra = iter(w['mass_calls'])
        for row in w['outer_rows'][:26]:
            law = x.assembly['resolved_laws']['outer', row['variant'], row['game_id']]
            delay = 24 if row['variant'] == 'availability_24h' else 12
            descriptor = next(r['distribution'] for r in w['assembly']['outer_selected_forecasts']
                if r['family'] == 'E3' and r['variant'] == row['variant'] and r['game_id'] == row['game_id'])
            self.assertEqual(descriptor['mapper'], x.pointers[delay])
            self.assertIs(law.independent, row['variant'] == 'independent_marginals')
            for target in original_grade.TARGETS:
                high, low = next(extra), next(extra)
