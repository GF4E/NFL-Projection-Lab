NUMERICAL_OBSERVATIONS = []


def fingerprint(value):
    return hashlib.sha256(strict(value)).hexdigest()


def law_fields(law):
    result = {}
    for field in fields(law):
        value = getattr(law, field.name)
        if isinstance(value, np.ndarray):
            result[field.name] = {'dtype': value.dtype.str, 'shape': list(value.shape),
                'c_bytes_hex': value.tobytes(order='C').hex(), 'writeable': value.flags.writeable,
                'values': value.tolist()}
        else:
            result[field.name] = {'type': type(value).__name__, 'value': native(value)}
            if type(value) is float:
                result[field.name]['float_bits'] = struct.pack('>d', value).hex()
    return result


def global_bindings():
    return (contract.encoded, saved.encoded, saved.distribution_descriptor,
        saved.recover_distribution, archive.recover_source_law, forecast._Assembly.resolve,
        forecast.assemble_forecasts, original_grade.score_forecast,
        original_grade.PublishedOriginGrader.grade, probability.score_forecast)


class IntegratedCase(Case):
    """Explicit synthetic adaptation of Case.publish; no global assembler patch."""
    def publish(self, accounting):
        year = self.view['origin']['season']
        if year == 2010:
            # The original state-only adapter performs no assembly or grading.
            return super().publish(accounting)
        if self.bank is None:
            self.bank = SplitTrajectoryBank(TEAMS)
            old = self.view['bank_prepared'][12]['history'][0].context
            initial = {d: {'targets': [old], 'history': []} for d in (12, 24)}
            diagonals = {(i, v): MeanTrajectory('E2', {'k': s['ks'], 'retention': s['retention']}, TEAMS, v)
                         .forecast_origin(old.season, old.week, [], [old])
                         for i, s in enumerate(forecast.split_setting_grid()[:9]) for v in forecast.STATE_VARIANTS}
            self.bank.advance(old.season, old.week, initial, diagonals)
        self.outputs = self.bank.advance(year, self.view['origin']['week'],
            self.view['bank_prepared'], self.view['diagonal_outputs'])
        self.assembly = composed.assemble_forecasts(self.view, self.bank, self.outputs,
            None if year < 2013 else choice(year, self.selected), local_mapper_pointers=self.pointers,
            parent_binding={'parent_manifest_sha256': archive.PARENT_MANIFEST,
                            'parent_index_sha256': archive.PARENT_INDEX}, accounting=accounting)
        pointer = controller.publish_origin(self.store, self.manifest, self.manifest_sha, self.view,
            self.bank, self.outputs, self.assembly, accounting.envelope)
        self.validate = partial(controller.validate_publication_binding, self.store, self.manifest,
            self.manifest_sha, self.view, self.assembly, pointer, accounting.envelope)
        return pointer


class IntegrationTests(unittest.TestCase):
    def case(self, year=2013, selected=0, kind=IntegratedCase, week=1):
        value = kind(year, selected, week); self.addCleanup(value.close); return value

    def run_real_pair(self, year, selected, failure=None):
        """Two real routes, with witnesses saved before cross-route equality."""
        witnesses, cases = [], []
        bindings = global_bindings()
        for label, case_type, module in (('original', Case, original_grade),
                                         ('composed', IntegratedCase, composed)):
            x = self.case(year, selected, case_type); cases.append(x)
            source_before = strict({group: list(rows.values()) for group, rows in x.view['source_laws'].items()})
            mapper_before = {d: (m.atoms.tobytes(), m.weights.tobytes(), m.b, m.epsilon)
                             for d, m in x.view['mappers'].items()}
            calls, mass_calls, memos = [], [], []
            real_score, real_cdf, real_memo = module.score_forecast, JointDistribution.cdf, encoding.EncodingMemo
            with measured(x.view['origin']) as acc:
                def create_memo():
                    self.assertIsNotNone(acc._active_callback)
                    self.assertEqual(acc._active_callback['kind'], 'fit')
                    memo = real_memo(); memos.append(memo); return memo
                def score(law, observed, game_id, **flags):
                    self.assertIs(type(law), JointDistribution)
                    self.assertIsNotNone(acc._active_callback)
                    metrics = real_score(law, observed, game_id, **flags)
                    calls.append({'game_id': game_id, 'observed': list(observed), 'flags': flags,
                        'law_sha256': fingerprint(law_fields(law)), 'metrics': native(metrics)})
                    return metrics
                def cdf(law, target, value):
                    answer = real_cdf(law, target, value)
                    if type(law) is JointDistribution:
                        mass_calls.append({'target': target, 'value': native(value), 'answer': native(answer),
                            'law_sha256': fingerprint(law_fields(law)),
                            'outside_score_callback': acc._active_callback is None})
                    return answer
                fault = patch.object(JointBase, 'fit', side_effect=failure) if failure else nullcontext()
                with fault, patch.object(encoding, 'EncodingMemo', side_effect=create_memo):
                    pointer = x.publish(acc)
                    with patch.object(module, 'score_forecast', side_effect=score), patch.object(JointDistribution, 'cdf', cdf):
                        result = x.grade(module.PublishedOriginGrader(), acc, pointer)
                callbacks = native(acc._active_origin['callbacks'])
            science = {k: x.assembly[k] for k in ('full_setting_forecasts', 'outer_selected_forecasts', 'grading_plan')}
            laws = [{'key': list(k), 'fields': law_fields(v)} for k, v in x.assembly['resolved_laws'].items()]
            witness = native({'route': label, 'year': year, 'selected': selected,
                'identity_scope': 'same_synthetic_manifest_for_exact_scientific_byte_comparison',
                'injected_fit_failure': None if failure is None else str(failure),
                'assembly': science, 'resolved_laws': laws, 'inner_rows': result['inner_rows'],
                'outer_rows': result['outer_rows'], 'counts': result['counts'], 'score_calls': calls,
                'mass_calls': mass_calls, 'memo_instances': len(memos), 'callbacks': callbacks,
                'provenance': x.store.read_bound(result['artifacts']['grading_provenance']),
                'publication': archive.parse(read_publication(x.store, pointer))})
            NUMERICAL_OBSERVATIONS.append(witness); witnesses.append(witness)
            # These are source integrity checks after retaining completed evidence.
            self.assertEqual(strict({group: list(rows.values()) for group, rows in x.view['source_laws'].items()}), source_before)
            self.assertEqual({d: (m.atoms.tobytes(), m.weights.tobytes(), m.b, m.epsilon)
                              for d, m in x.view['mappers'].items()}, mapper_before)
            self.assertEqual(len(calls), result['counts']['actual_score_calls'])
            self.assertEqual(len(mass_calls), result['counts']['actual_mass_cdf_calls'])
            self.assertTrue(all(r['outside_score_callback'] for r in mass_calls))
            self.assertEqual(len({id(m) for m in memos}), len(memos))
            self.assertEqual(len(memos), 0 if label == 'original' else sum(
                r['kind'] == 'fit' and r['operation'] == 'fit' for r in callbacks))
            for stage in ('inner', 'outer'):
                if result[stage + '_rows']:
                    self.assertEqual(strict(result[stage + '_rows']),
                        x.store.read(result['artifacts'][stage + '_losses']['name']))
            for row in result['outer_rows']:
                self.assertEqual(len(row['metrics']), 108 if row['family'] == 'E3' else 104)
                self.assertIs(type(row['metrics']['grid_transport_bound']), float)
            for row in calls:
                self.assertEqual(len(row['metrics']), 104 if row['flags']['diagnostics'] else 28)
        left, right = witnesses
        for name in ('assembly', 'resolved_laws', 'inner_rows', 'outer_rows', 'counts', 'score_calls',
                     'mass_calls', 'provenance', 'publication'):
            self.assertEqual(strict(left[name]), strict(right[name]), name)
        for key, law in cases[0].assembly['resolved_laws'].items():
            other = cases[1].assembly['resolved_laws'][key]
            self.assertIs(type(other), JointDistribution)
            for field in fields(law):
                a, b = getattr(law, field.name), getattr(other, field.name)
                if isinstance(a, np.ndarray):
                    self.assertFalse(np.shares_memory(a, b)); self.assertFalse(b.flags.writeable)
        self.assertTrue(all(a is b for a, b in zip(bindings, global_bindings())))
        return cases[1], witnesses[1]

