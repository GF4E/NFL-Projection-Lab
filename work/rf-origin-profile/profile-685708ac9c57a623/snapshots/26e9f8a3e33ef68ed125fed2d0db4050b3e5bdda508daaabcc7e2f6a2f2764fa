        signal.signal(signal.SIGALRM, previous_handler)
        store.close()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--run", action="store_true", help="Execute exactly one frozen offline run after synthetic checks")
    parser.add_argument("--preflight", action="store_true", help="Verify accepted bytes/runtime only; no real fit")
    args = parser.parse_args()
    if args.run == args.preflight:
        parser.error("select exactly one of --run or --preflight")
    if args.preflight:
        _, config, data, hashes = load_accepted(ROOT)
        print(json.dumps({"status": "preflight_pass", "runtime": runtime_manifest(config), "hashes": hashes,
                          "games": len(data["records"]), "origins": len(data["origins"]), "real_model_fits": 0}, sort_keys=True))
        return 0
    return run()


if __name__ == "__main__":
    raise SystemExit(main())
