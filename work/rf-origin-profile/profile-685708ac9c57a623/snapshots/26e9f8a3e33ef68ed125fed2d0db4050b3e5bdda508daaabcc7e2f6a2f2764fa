def plain(value):
    if isinstance(value, np.ndarray):
        return plain(value.tolist())
    if isinstance(value, np.generic):
        return plain(value.item())
    if isinstance(value, dict):
        return {str(key): plain(item) for key, item in value.items()}
    if isinstance(value, (list, tuple)):
        return [plain(item) for item in value]
    if isinstance(value, float) and not np.isfinite(value):
        return {"nonfinite": str(value)}
    return value


def _directory_fd(path):
    path = Path(path)
    if not path.is_absolute() or ".." in path.parts:
        raise ValueError("absolute_output_parent_required")
    fd = os.open(path.anchor, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        for part in path.parts[1:]:
            following = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
            os.close(fd)
            fd = following
        return fd
    except BaseException:
        os.close(fd)
        raise


class ImmutableRun:
    def __init__(self, parent, identity):
        if not identity or any(character not in "abcdefghijklmnopqrstuvwxyz0123456789-." for character in identity):
            raise ValueError("invalid_run_identity")
        self.path, self.index = Path(parent) / identity, {}
        parent_fd = _directory_fd(parent)
        try:
            os.mkdir(identity, mode=0o700, dir_fd=parent_fd)  # Existing identity is never resumed/restarted.
            self.fd = os.open(identity, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent_fd)
        finally:
            os.close(parent_fd)

    def write(self, name, value):
        if not name or any(c not in "abcdefghijklmnopqrstuvwxyz0123456789-." for c in name):
            raise ValueError("invalid_output_name")
        raw = value if isinstance(value, bytes) else encoded(plain(value))
        sha = digest(raw)
        try:
            fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=self.fd)
        except FileExistsError:
            if self.read(name) != raw:
                raise ValueError("immutable_output_conflict")
        else:
            with os.fdopen(fd, "wb") as stream:
                stream.write(raw)
                stream.flush()
                os.fsync(stream.fileno())
        if digest(self.read(name)) != sha:
            raise ValueError("output_hash_recovery_failed")
        self.index[name] = {"sha256": sha, "bytes": len(raw)}
        return sha

    def read(self, name):
        if not name or any(c not in "abcdefghijklmnopqrstuvwxyz0123456789-." for c in name):
            raise ValueError("invalid_output_name")
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=self.fd)
        with os.fdopen(fd, "rb") as stream:
            if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
                raise ValueError("nonregular_output_refused")
            return stream.read()

    def object(self, value):
        raw = encoded(plain(value))
        name = "object-" + digest(raw) + ".json"
        self.write(name, raw)
        return {"name": name, "sha256": digest(raw)}

    def finish_index(self):
        self.write("artifact-index.json", {"files": self.index.copy()})

    def close(self):
        os.close(self.fd)


def distribution_descriptor(fitted, mapper_pointer):
    return {"version": "rf.joint-distribution.v2", "mapper": mapper_pointer,
            "theta": fitted.theta.tolist(), "beta": fitted.beta, "rates": fitted.rates.tolist(),
            "alphaSha256": digest(encoded(fitted.alpha.tolist())), "iterations": fitted.iterations,
            "independent": fitted.independent, "mean": fitted.moments()[0].tolist(),
            "covariance": fitted.moments()[1].tolist()}


def recover_distribution(mapper, descriptor):
    theta = np.asarray(descriptor["theta"])
    _, alpha, beta, rates, _, _ = mapper.components(theta)
    if (digest(encoded(alpha.tolist())) != descriptor["alphaSha256"] or beta != descriptor["beta"]
            or rates.tolist() != descriptor["rates"]):
        raise ValueError("distribution_parameter_hash_mismatch")
    from research_score_distribution import JointDistribution
    recovered = JointDistribution(mapper.atoms, alpha, beta, rates, theta, descriptor["iterations"], descriptor["independent"])
    if recovered.moments()[0].tolist() != descriptor["mean"] or recovered.moments()[1].tolist() != descriptor["covariance"]:
        raise ValueError("distribution_moment_mismatch")
    return recovered


def lineage(prepared, config_hash, code_hash, manifest_hash, output_body):
    def node(identity, kind, body, parents=(), available=None):
        value = {"id": identity, "kind": kind, "body": body,
                 "parents": [{"id": p["id"], "sha256": p["sha256"]} for p in parents], "available_at": available}
        value["sha256"] = node_hash(value)
        return value
    configuration = node("configuration", "configuration", {"sha256": config_hash})
    source = node("eligible-football", "football_source", {"input_sha256": prepared["input_hash"], "ids": prepared["input_ids"],
                  "availability_class": "retrospective_inferred", "admission_manifest": manifest_hash})
    schema = node("feature-schema", "feature_schema", {"historical": ["game_id", "season", "week", "home", "away", "neutral", "home_score", "away_score"],
                  "target_context": ["game_id", "season", "week", "home", "away", "neutral"]})
    target_schema = node("target-schema", "target_schema", {"fields": ["home_final_score_including_OT", "away_final_score_including_OT"],
                         "type": "joint_nonnegative_integer_scores", "season_type": "REG", "overtime_occurrence": "diagnostic_only"})
    model = node("model", "model", {"code_sha256": code_hash}, [configuration, source, schema, target_schema])
    forecast = node("forecast", "forecast", output_body, [model])
    nodes = [configuration, source, schema, target_schema, model, forecast]
    verify_ancestry(nodes, {"forecast": forecast["sha256"]}, datetime.fromisoformat(prepared["origin_at"]))
    return {"expected_root": forecast["sha256"], "nodes": nodes}


def rss_mb():
    value = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss
    return value / (1024 ** 2 if sys.platform == "darwin" else 1024)


def check_budget(started, config):
    elapsed, rss = time.monotonic() - started, rss_mb()
    if elapsed > config["budget"]["fullReplayMaximumSeconds"] or rss > config["budget"]["maximumResidentMb"]:
        raise ValueError("registered_runtime_or_memory_budget_exceeded")
    return elapsed, rss


def inference_cost_probe(config):
    """Fixed synthetic capacity probe, never model evidence or real outcome fitting."""
    from research_score_replay import registered_series
    from research_score_metrics import TARGETS, LEVELS
    metadata_rows = [{"season": year, "week": week} for year in range(2013, 2025) for week in range(1, 18) for _ in range(16)]
    synthetic = {}
    for j, key in enumerate(registered_series(config)):
        rows = []
        for n in range(len(metadata_rows)):
            row = {"joint_energy_score": 10 + (n % 7) / 10 + (j % 5) * .01 * (1 + n % 3)}
            for target in TARGETS:
                row[target + "_pit"] = ((n % 10) + .5) / 10
                for level in LEVELS:
                    row[f"{target}_coverage_{round(100 * level)}"] = float(n % 10 < round(10 * level))
            rows.append(row)
        synthetic[key] = rows
    tick = time.monotonic()
    infer(config, metadata_rows, synthetic, members=100)
    seconds = time.monotonic() - tick
    return {"synthetic_members": 100, "seconds": seconds, "projected_10000_member_seconds": seconds * 100,
            "real_data_used": False, "extrapolation_not_a_runtime_guarantee": True}


