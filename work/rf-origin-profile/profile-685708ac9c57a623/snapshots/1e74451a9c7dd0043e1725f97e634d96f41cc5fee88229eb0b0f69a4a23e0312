TEAMS = tuple(f'T{i:02}' for i in range(32))
PARENT = {'parent_manifest_sha256': f.PARENT_MANIFEST, 'parent_index_sha256': f.PARENT_INDEX}


def native(value):
    return json.loads(strict(value))


def game(name, year, week, home=0, away=1):
    return GameContext(name, year, week, TEAMS[home], TEAMS[away])


def choice(year, selected):
    candidates = [{'setting': i, 'mean_energy': 1. if i == selected else 2.,
                   'failure_rate': 1. if selected is None else 0., 'eligible': selected is not None} for i in range(27)]
    return {'setting': selected, 'status': 'no_eligible_setting' if selected is None else 'selected',
            'games': 2, 'inner_seasons': [year-2, year-1], 'candidates': candidates}


def fixture(year=2013):
    """Real own histories and original diagonals on four synthetic origins."""
    bank = SplitTrajectoryBank(TEAMS)
    old = {(i, v): MeanTrajectory('E2', {'k': s['ks'], 'retention': s['retention']}, TEAMS, v)
           for i, s in enumerate(split_setting_grid()[:9]) for v in f.STATE_VARIANTS}
    warm, first, third = (game(name, 2010, week) for week, name in enumerate(('warm', 'first', 'third'), 1))
    results = [HistoricalResult(warm, 20, 10), HistoricalResult(first, 26, 14), HistoricalResult(third, 13, 24)]
    data = None
    steps = [(2010, 1, [warm], [], []), (2010, 2, [first], results[:1], results[:1]),
             (2010, 3, [third], results[:2], results[:1])]
    if year == 2010:
        steps = steps[:1]
    else:
        steps.append((year, 1, [game('z-target', year, 1), game('a-target', year, 1, 2, 3)], results, results[:2]))
    for y, week, targets, h12, h24 in steps:
        data = {d: {'history': h, 'targets': targets} for d, h in ((12, h12), (24, h24))}
        diagonal = {(i, v): native(e.forecast_origin(y, week, **{
            'eligible_results': data[24 if v == 'availability_24h' else 12]['history'], 'targets': targets}))
                    for (i, v), e in old.items()}
        outputs = bank.advance(y, week, data, diagonal)
    origin = {'season': year, 'week': 1, 'originAt': f'{year}-09-01T12:00:00+00:00',
              'targetGameIds': [g.game_id for g in targets],
              'windows': {'12': {'eligibleInputIds': [r.context.game_id for r in data[12]['history']]}}}
    prepared = {d: {**data[d], 'origin_at': origin['originAt'], 'delay_hours': d,
                    'input_hash': hashlib.sha256(strict([r.context.game_id for r in data[d]['history']])).hexdigest()}
                for d in (12, 24)}
    view = {'origin': origin, 'prepared_receipts': prepared, 'bank_prepared': data, 'diagonal_outputs': diagonal,
            'source_laws': {'full': {}, 'outer': {}}, 'mapper_sources': {}, 'mappers': {},
            'original_selection': None if year < 2013 else {family: {'setting': 0} for family in ('N0', 'E2', 'E1', 'S1')},
            'source_pointers': {}}
    pointers = {}
    if year == 2010:
        return view, bank, outputs, pointers
    for d in (12, 24):
        h = data[d]['history']
        mapper = f.JointBase.from_scores([[r.home_score, r.away_score] for r in h], weights(h, year, 2.5))
        payload = native({'atoms': mapper.atoms, 'weights': mapper.weights, 'b': mapper.b,
                          'epsilon': mapper.epsilon, 'input_sha256': prepared[d]['input_hash'], 'half_life': 2.5})
        digest = hashlib.sha256(strict(payload)).hexdigest()
        pointers[d] = {'name': 'object-' + digest + '.json', 'sha256': digest}
        view['mapper_sources'][d] = {'pointer': pointers[d], 'payload': payload}
        view['mappers'][d] = mapper
    laws = {}
    def law(mean, variant):
        d = 24 if variant == 'availability_24h' else 12
        key = d, tuple(mean), variant == 'independent_marginals'
        if key not in laws:
            fitted = view['mappers'][d].fit(mean)
            if key[2]:
                fitted = replace(fitted, independent=True)
            laws[key] = native(f.distribution_descriptor(fitted, pointers[d]))
        return copy.deepcopy(laws[key])
    for gid in origin['targetGameIds']:
        full = view['source_laws']['full']
        full['N0', 0, gid] = {'family': 'N0', 'setting': 0, 'game_id': gid, 'native_failure': None,
                              'distribution': law([20., 16.], 'full')}
        for i in range(9):
            forecast = next(r for r in outputs['E3', i, 'full']['forecasts'] if r['game_id'] == gid)
            full['E2', i, gid] = {'family': 'E2', 'setting': i, 'game_id': gid, 'native_failure': forecast['failure'],
                                  'distribution': law(forecast['mean'], 'full')}
    if year >= 2013:
        for family, variant in f._SOURCE_SERIES:
            for gid in origin['targetGameIds']:
                mean = [20., 16.]
                if family == 'E2':
                    selected = bank.selected_output(outputs, 'E3', 0, variant)
                    mean = next(r['mean'] for r in selected['forecasts'] if r['game_id'] == gid)
                view['source_laws']['outer'][family, variant, gid] = {
                    'family': family, 'setting': 0, 'variant': variant, 'game_id': gid, 'native_failure': None,
                    'distribution': law(mean, variant)}
    raw = strict({'full': list(view['source_laws']['full'].values()), 'outer': list(view['source_laws']['outer'].values())})
    view['source_pointers']['forecasts'] = {'name': f'forecasts-{year}-01.json',
                                           'sha256': hashlib.sha256(raw).hexdigest(), 'bytes': len(raw)}
    return view, bank, outputs, pointers


@contextmanager
def measured(origin):
    # Explicit tiny-fixture construction, with the real envelope, origin and
    # callback implementation. The production full-plan constructor is intact.
    envelope = RuntimeEnvelope()
    acc = object.__new__(OriginAccounting)
    acc.envelope, acc._plan, acc._origins = envelope, (strict(origin),), []
    acc._active_origin = acc._active_callback = None
    try:
        with acc.origin(origin):
            yield acc
    finally:
        envelope.close()


class ForecastUnitTests(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.fixtures = {year: fixture(year) for year in (2010, 2011, 2013, 2025)}

    def inputs(self, year=2013):
        return copy.deepcopy(self.fixtures[year])

    def assemble(self, inputs, selected=0):
        view, bank, outputs, pointers = inputs
        with measured(view['origin']) as accounting:
            result = f.assemble_forecasts(view, bank, outputs,
                None if view['origin']['season'] < 2013 else choice(view['origin']['season'], selected),
                local_mapper_pointers=pointers, parent_binding=PARENT, accounting=accounting)
        calls = accounting._origins[0]['callbacks']
        for i, call in enumerate(calls):
            self.assertGreater(call['seconds'], 0)
            self.assertEqual(call['kind'], 'fit')
            if i:
                self.assertGreaterEqual(call['started_seconds'], calls[i-1]['finished_seconds'])
        return result, calls

    def test_state_only_has_no_law_callbacks_or_outputs(self):
        with patch.object(f.JointBase, 'fit', side_effect=AssertionError('no2010fits')):
            result, calls = self.assemble(self.inputs(2010))
        self.assertEqual(result, {'full_setting_forecasts': [], 'outer_selected_forecasts': [],
                                 'grading_plan': {'inner': [], 'outer': []}, 'resolved_laws': {}})
        self.assertEqual(calls, [])

    def test_inner_population_order_diagonals_and_real_offdiagonal_laws(self):
        inputs = self.inputs(2011)
        result, calls = self.assemble(inputs)
        rows = result['full_setting_forecasts']; plans = result['grading_plan']['inner']
        self.assertEqual([(r['game_id'], r['setting']) for r in rows],
                         [(g, i) for g in ('z-target', 'a-target') for i in range(27)])
        self.assertEqual(len(calls), 36)
        self.assertEqual(result['outer_selected_forecasts'], [])
        for row, plan in zip(rows, plans):
            self.assertEqual(plan['key'], ['E3', row['setting'], row['game_id']])
            if row['setting'] < 9:
                original = inputs[0]['source_laws']['full']['E2', row['setting'], row['game_id']]
                self.assertEqual(row, {**original, 'family': 'E3'})
                self.assertEqual(plan['mode'], 'source_inner')
                self.assertEqual(plan['law_work']['fit_calls'], 0)
            else:
                law = result['resolved_laws']['inner', row['setting'], row['game_id']]
                self.assertEqual(native(f.distribution_descriptor(law, inputs[3][12])), row['distribution'])
                self.assertEqual(plan['law_work']['fit_calls'], 1)
                self.assertEqual(plan['law_work']['descriptor_recoveries'], 1)
                self.assertIsNone(row['native_failure'])

    def test_same_selected_reuses_exact_eleven_and_scores_only_new_zero_controls(self):
        inputs = self.inputs()
        before = strict(inputs[0]['source_laws']['outer']['E2', 'deterministic_noise', 'z-target'])
        result, calls = self.assemble(inputs)
        rows = result['outer_selected_forecasts']; plans = result['grading_plan']['outer']
        expected = [(family, v, g) for family, v in tuple(('E3', v) for v in SPLIT_VARIANTS) + f.RAW_REFERENCES
                    for g in ('z-target', 'a-target')]
        self.assertEqual([(r['family'], r['variant'], r['game_id']) for r in rows], expected)
        self.assertEqual([p['key'] for p in plans], [list(k) for k in expected])
        self.assertEqual(sum(p['mode'] == 'source_outer' for p in plans), 22)
        self.assertEqual(sum(p['mode'] == 'new_score' for p in plans), 4)
        self.assertEqual(sum(p['mode'] == 'raw_reference' for p in plans), 12)
        self.assertEqual(sum(c['stage'] == 'outer' and c['operation'] == 'fit' for c in calls), 4)
        for row, plan in zip(rows, plans):
            if plan['source']:
                self.assertEqual(plan['source']['kind'], 'source_forecast')
                self.assertEqual(plan['source']['forecast_file'], inputs[0]['source_pointers']['forecasts'])
                self.assertNotIn('loss_file', plan['source'])
            if plan['mode'] == 'source_outer':
                self.assertEqual(row, {**inputs[0]['source_laws']['outer']['E2', row['variant'], row['game_id']], 'family': 'E3'})
        self.assertEqual(before, strict(inputs[0]['source_laws']['outer']['E2', 'deterministic_noise', 'z-target']))

    def test_different_diagonal_full_uses_source_inner_law_but_requires_outer_score(self):
        inputs = self.inputs()
        result, calls = self.assemble(inputs, 1)
        e3 = result['grading_plan']['outer'][:26]
        self.assertTrue(all(p['mode'] == 'new_score' for p in e3))
        for plan in e3[:2]:
            self.assertEqual(plan['source']['source_population'], 'full_setting_forecasts')
            self.assertEqual(plan['source']['source_key'][:3], ['E2', 1, 'full'])
        self.assertEqual(sum(c['stage'] == 'outer' and c['operation'] == 'recovery' for c in calls), 2)
        self.assertEqual(sum(c['stage'] == 'outer' and c['operation'] == 'fit' for c in calls), 24)

    def test_selected_offdiagonal_full_reuses_current_own_inner_only(self):
        inputs = self.inputs()
        native_before = strict(inputs[2]['E3', 9, 'full'])
        result, calls = self.assemble(inputs, 9)
        for gid in ('z-target', 'a-target'):
            self.assertIs(result['resolved_laws']['inner', 9, gid], result['resolved_laws']['outer', 'full', gid])
        self.assertEqual(sum(c['stage'] == 'outer' for c in calls), 24)
        self.assertTrue(all(p['source'] is None for p in result['grading_plan']['outer'][:26]))
        self.assertEqual(native_before, strict(inputs[2]['E3', 9, 'full']))
        self.assertEqual(result['grading_plan']['outer'][0]['law_work']['kind'], 'current_origin_cache')

    def test_2025_no_unused_inner_or_offdiagonal_work(self):
        result, calls = self.assemble(self.inputs(2025), 26)
        self.assertEqual(result['full_setting_forecasts'], [])
        self.assertEqual(result['grading_plan']['inner'], [])
