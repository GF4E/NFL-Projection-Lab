    def test_noeligible_lazy_same_variant_fallback_without_fit_or_sentinel_escape(self):
        inputs = self.inputs(2025)
        with patch.object(f.JointBase, 'fit', side_effect=AssertionError('noeligible must not fit')):
            result, calls = self.assemble(inputs, None)
        self.assertEqual(len(calls), 26)
        for row in result['outer_selected_forecasts'][:26]:
            v = row['variant']; gid = row['game_id']
            fallback = f._Assembly.fallback_variant(v)
            self.assertEqual(row['native_failure'], 'no_eligible_setting')
            self.assertEqual(row['distribution'], inputs[0]['source_laws']['outer']['N0', fallback, gid]['distribution'])
            self.assertIsInstance(result['resolved_laws']['outer', v, gid], JointDistribution)
        self.assertTrue(all(c['used_fallback'] for c in calls))
        work = [p['law_work'] for p in result['grading_plan']['outer'][:26]]
        self.assertEqual(sum(w['fit_calls'] for w in work), 0)
        self.assertGreater(sum(w['source_cache_hits'] for w in work), 0)
        self.assertGreater(sum(w['saved_recoveries'] for w in work), 0)

    def test_grid_failure_one_attempt_exact_reason_and_delay_specific_N0(self):
        inputs = self.inputs(2025)
        real_fit = f.JointBase.fit
        fit_calls = []
        def fit(mapper, mean, *args, **kw):
            fit_calls.append(mapper)
            return real_fit(mapper, mean, *args, **kw)
        with patch.object(f.JointBase, 'fit', fit), patch.object(JointDistribution, 'grid', side_effect=NumericalFailure('synthetic_grid_failure')):
            result, calls = self.assemble(inputs, 9)
        self.assertEqual(len(fit_calls), 26)
        self.assertEqual(len(calls), 26)
        for row in result['outer_selected_forecasts'][:26]:
            self.assertEqual(row['native_failure'], 'synthetic_grid_failure')
            fallback = f._Assembly.fallback_variant(row['variant'])
            self.assertEqual(row['distribution'], inputs[0]['source_laws']['outer']['N0', fallback, row['game_id']]['distribution'])
        availability = next(r for r in result['outer_selected_forecasts'] if r['variant'] == 'availability_24h')
        self.assertEqual(availability['distribution']['mapper'], inputs[3][24])
        self.assertNotEqual(inputs[3][12], inputs[3][24])

    def test_native_absorbing_failure_uses_original_reason_without_fit_for_that_engine(self):
        inputs = self.inputs(2025)
        view, bank, outputs, _ = inputs
        engine = bank.engines['E3', 9, 'full']
        engine._absorb('synthetic_absorbing_failure')
        output = outputs['E3', 9, 'full']; output['absorbing_failure'] = True
        for row in output['forecasts']:
            row.update(mean=None, failure=engine.failure_reason)
        result, calls = self.assemble(inputs, 9)
        full_calls = [c for c in calls if c['variant'] == 'full']
        self.assertTrue(all(c['native_failure'] == 'synthetic_absorbing_failure' and c['used_fallback'] for c in full_calls))
        self.assertTrue(all(p['law_work']['fit_calls'] == 0 for p in result['grading_plan']['outer'][:2]))

