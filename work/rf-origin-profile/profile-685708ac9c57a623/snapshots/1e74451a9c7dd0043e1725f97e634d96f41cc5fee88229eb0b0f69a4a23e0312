    def test_new_independence_noise_shuffle_and_both_zero_controls_use_selected_own_means(self):
        inputs = self.inputs(2025); view, bank, outputs, _ = inputs
        result, calls = self.assemble(inputs, 26)
        rows = {(r['variant'], r['game_id']): r for r in result['outer_selected_forecasts'] if r['family'] == 'E3'}
        for variant in ('independent_marginals', 'deterministic_noise', 'shuffled_identity',
                        'zero_strength_update', 'zero_scoring_level_update'):
            expected = bank.selected_output(outputs, 'E3', 26, variant)
            for forecast in expected['forecasts']:
                row = rows[variant, forecast['game_id']]
                self.assertIsNone(row['native_failure'])
                np.testing.assert_allclose(row['distribution']['mean'], forecast['mean'], rtol=0, atol=1e-7)
                self.assertIs(row['distribution']['independent'], variant == 'independent_marginals')
                if variant == 'independent_marginals':
                    self.assertEqual(row['distribution']['covariance'][0][1], 0.)

    def test_invalid_native_population_origin_mean_and_borrowed_flag_before_callbacks(self):
        for case in ('missing', 'extra', 'reverse', 'mean', 'flag', 'origin', 'borrowed'):
            inputs = self.inputs(2025); view, bank, outputs, pointers = inputs
            row = outputs['E3', 26, 'full']['forecasts'][0]
            if case == 'missing': outputs.pop(('E3', 26, 'full'))
            elif case == 'extra': outputs['E3', 27, 'full'] = outputs['E3', 26, 'full']
            elif case == 'reverse': outputs['E3', 26, 'full']['forecasts'].reverse()
            elif case == 'mean': row['mean'] = np.asarray(row['mean']) + 1.
            elif case == 'flag': row['initialization_only'] = not row['initialization_only']
            elif case == 'origin': bank.engines['E3', 26, 'full'].last_origin = (2024, 1)
            else: outputs['E3', 0, 'full']['forecasts'][0]['failure'] = 'fake'
            with self.subTest(case=case), measured(view['origin']) as acc:
                with self.assertRaises(ValueError):
                    f.assemble_forecasts(view, bank, outputs, choice(2025, 26), local_mapper_pointers=pointers, parent_binding=PARENT, accounting=acc)
                self.assertEqual(acc._active_origin['callbacks'], [])

