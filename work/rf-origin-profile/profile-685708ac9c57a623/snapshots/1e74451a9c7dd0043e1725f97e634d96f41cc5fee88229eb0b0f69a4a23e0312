        for case in ('setting', 'mean', 'independence', 'mapper', 'payload', 'failure', 'missingN0', 'loss_pointer', 'label'):
            inputs = self.inputs(2025); view, bank, outputs, pointers = inputs
            row = view['source_laws']['outer']['E2', 'full', 'z-target']
            if case == 'setting': row['setting'] = 1
            elif case == 'mean': row['distribution']['mean'][0] += 1.
            elif case == 'independence': row['distribution']['independent'] = True
            elif case == 'mapper': pointers[24] = copy.deepcopy(pointers[12])
            elif case == 'payload': view['mapper_sources'][12]['payload']['epsilon'] *= 2
            elif case == 'failure': view['source_laws']['outer']['N0', 'full', 'z-target']['native_failure'] = 'fake'
            elif case == 'missingN0': view['source_laws']['outer'].pop(('N0', 'availability_24h', 'z-target'))
            elif case == 'loss_pointer': view['source_pointers']['forecasts']['name'] = 'outer-losses-2025-01.json'
            else: row['observed_home'] = 20
            with self.subTest(case=case), measured(view['origin']) as acc:
                with self.assertRaises(ValueError):
                    f.assemble_forecasts(view, bank, outputs, choice(2025, 9), local_mapper_pointers=pointers, parent_binding=PARENT, accounting=acc)
                self.assertEqual(acc._active_origin['callbacks'], [])

    def test_choice_must_be_frozen_prior_two_year_strict_decision(self):
        for case in ('future', 'bool', 'chosen', 'missing', 'tie', 'failure', 'nan'):
            view, bank, outputs, pointers = self.inputs(2025)
            decision = choice(2025, 9)
            if case == 'future': decision['inner_seasons'] = [2024, 2025]
            elif case == 'bool': decision['setting'] = True
            elif case == 'chosen': decision['setting'] = 10
            elif case == 'missing': decision['candidates'].pop()
            elif case == 'tie': decision['candidates'][0]['mean_energy'] = 1. + 1e-9
            elif case == 'failure': decision['candidates'][9]['failure_rate'] = .006
            else: decision['candidates'][9]['mean_energy'] = float('nan')
            with self.subTest(case=case), measured(view['origin']) as acc:
                with self.assertRaises(ValueError):
                    f.assemble_forecasts(view, bank, outputs, decision, local_mapper_pointers=pointers, parent_binding=PARENT, accounting=acc)
                self.assertEqual(acc._active_origin['callbacks'], [])

    def test_source_recovery_corruption_abort_retains_failed_callback_no_retry(self):
        view, bank, outputs, pointers = self.inputs(2025)
        # Keep request/flags plausible; strict component recovery catches this.
        view['source_laws']['outer']['E2', 'full', 'z-target']['distribution']['theta'][0] += .001
        with measured(view['origin']) as acc:
            with self.assertRaisesRegex(ValueError, 'distribution_parameter_hash_mismatch'):
                f.assemble_forecasts(view, bank, outputs, choice(2025, 0), local_mapper_pointers=pointers, parent_binding=PARENT, accounting=acc)
            calls = acc._active_origin['callbacks']
            self.assertEqual(len(calls), 1)
            self.assertEqual(calls[0]['operation'], 'recovery')
            self.assertEqual(calls[0]['error_type'], 'ValueError')
            self.assertGreater(calls[0]['seconds'], 0)

    def test_runtime_stop_is_not_numerical_fallback_or_second_callback(self):
        view, bank, outputs, pointers = self.inputs(2025)
        with measured(view['origin']) as acc:
            with patch.object(f.JointBase, 'fit', side_effect=RuntimeStop('synthetic_stop')) as fitted:
                with self.assertRaisesRegex(RuntimeStop, 'synthetic_stop'):
                    f.assemble_forecasts(view, bank, outputs, choice(2025, 9), local_mapper_pointers=pointers, parent_binding=PARENT, accounting=acc)
            self.assertEqual(fitted.call_count, 1)
            self.assertEqual(len(acc._active_origin['callbacks']), 1)
            self.assertEqual(acc._active_origin['callbacks'][0]['error_type'], 'RuntimeStop')

    def test_arrays_readonly_no_source_mutation_and_cache_not_global(self):
        inputs = self.inputs(2025)
        source_before = {k: strict(v) for k, v in inputs[0]['source_laws']['outer'].items()}
        result, first_calls = self.assemble(inputs, None)
        result2, second_calls = self.assemble(inputs, None)
        self.assertEqual(len(first_calls), len(second_calls))
        self.assertEqual(source_before, {k: strict(v) for k, v in inputs[0]['source_laws']['outer'].items()})
        law = result['resolved_laws']['outer', 'full', 'z-target']
        other = result2['resolved_laws']['outer', 'full', 'z-target']
        for field in ('atoms', 'alpha', 'rates', 'theta'):
            values = getattr(law, field)
            self.assertFalse(values.flags.writeable)
            self.assertFalse(np.shares_memory(values, getattr(other, field)))
            self.assertFalse(np.shares_memory(values, inputs[0]['mappers'][12].atoms))
        result['outer_selected_forecasts'][0]['distribution']['theta'][0] += 10.
        self.assertEqual(source_before, {k: strict(v) for k, v in inputs[0]['source_laws']['outer'].items()})


