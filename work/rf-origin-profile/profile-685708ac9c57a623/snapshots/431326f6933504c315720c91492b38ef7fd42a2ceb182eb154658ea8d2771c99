    def test_calibration_vector_is_copied_and_constructor_is_observation_only(self):
        original = fixture()
        fingerprint = unit.distribution_fingerprint(original)
        case = unit.calibration_case(original, np.int64(0), np.int32(2))
        self.assertFalse(np.shares_memory(case['empirical_probabilities'], original.alpha))
        case['empirical_probabilities'][0] = 0
        self.assertEqual(fingerprint, unit.distribution_fingerprint(original))
        self.assertEqual(str(inspect.signature(unit.transform_distribution)), '(distribution, s)')


