            unit.calibration_case(overflowing, 1, 1)
        unrepresentable_split = replace(fixture(), rates=np.array([np.nextafter(0., 1.), 1e308]))
        with self.assertRaisesRegex(unit.ConditionalAdapterFailure, 'unrepresentable_background_split'):
            unit.calibration_case(unrepresentable_split, 1, 1)

    def test_calibration_extreme_log_mass_imbalance_rejected(self):
        for alpha, beta, rates in ((1., 1e-300, [2., 3.]),
