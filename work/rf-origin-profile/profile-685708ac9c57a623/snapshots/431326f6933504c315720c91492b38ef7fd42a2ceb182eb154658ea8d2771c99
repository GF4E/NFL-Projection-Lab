    def test_exact_class_independence_and_invalid_fields(self):
        original = fixture()

        class Subclass(JointDistribution):
            pass

        for invalid in (object(), Subclass(**vars(original)), replace(original, independent=True),
                        replace(original, independent=0)):
            with self.assertRaises(unit.ConditionalAdapterFailure):
                unit.transform_distribution(invalid, .5)
        changes = [('atoms', np.array([])), ('atoms', np.empty((0, 2))),
                   ('atoms', np.array([[0, 1, 2]])), ('atoms', np.array([[-1, 2]])),
                   ('atoms', np.array([[.5, 1.5]])), ('atoms', np.array([[np.nan, 0]])),
                   ('atoms', np.array([[np.inf, 0]])), ('atoms', [[0, 0]]),
                   ('alpha', np.ones(2)), ('alpha', -original.alpha), ('alpha', original.alpha * 2),
                   ('alpha', np.full(8, np.nan)), ('beta', 0.), ('beta', -1.), ('beta', np.inf),
                   ('rates', np.array([0., 2.])), ('rates', np.array([1., np.inf])),
                   ('rates', np.array([1.])), ('theta', np.array([0., np.nan])),
                   ('theta', np.zeros(3)), ('iterations', -1), ('iterations', 1.), ('iterations', True)]
        for field, value in changes:
            with self.subTest(field=field, value=value), self.assertRaises(unit.ConditionalAdapterFailure):
                unit.transform_distribution(replace(original, **{field: value}), 1.)
        for scale in (-.1, 1.1, np.nan, np.inf, [.5], '0.5'):
            with self.assertRaises(unit.ConditionalAdapterFailure):
                unit.transform_distribution(original, scale)

    def test_allocation_bounds_precede_dense_allocation(self):
        original = fixture()
        for atoms in (np.array([[101, 100]]), np.array([[1e308, 0.]]),
                      np.array([[np.iinfo(np.uint64).max, 0]], dtype=np.uint64),
                      np.zeros((65537, 2), dtype=np.int8)):
            invalid = replace(original, atoms=atoms, alpha=np.zeros(len(atoms)), beta=1.)
            with patch.object(unit.np, 'zeros', side_effect=AssertionError('dense_allocation_before_bounds')):
                with self.assertRaisesRegex(unit.ConditionalAdapterFailure, 'limit_exceeded'):
                    unit.transform_distribution(invalid, .5)
        maximum = replace(original, atoms=np.array([[0, 200], [200, 0]]), alpha=np.array([.3, .3]))
        result, _ = unit.transform_distribution(maximum, .5)
        self.assertTrue(np.all(result.atoms.sum(axis=1) == 200))
        many = replace(original, atoms=np.zeros((65536, 2), dtype=np.int8),
                       alpha=np.full(65536, .5 / 65536), beta=.5)
        result, _ = unit.transform_distribution(many, .5)
        np.testing.assert_array_equal(result.atoms, [[0, 0]])
        np.testing.assert_array_equal(result.alpha, [.5])

