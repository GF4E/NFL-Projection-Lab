    def test_calibration_case_background_only_total_and_zero(self):
        original = fixture()
        case = unit.calibration_case(original, 1, 2)
        self.assertIsNone(case['empirical_probabilities'])
        self.assertEqual(case['empirical_fraction'], 0.)
        self.assertEqual(case['background_fraction'], 1.)
        probability = original.rates[0] / original.rates.sum()
        self.assertAlmostEqual(case['conditional_mean'], 3 * probability, delta=1e-10)
        self.assertAlmostEqual(case['fixed_variance'], 3 * probability * (1 - probability), delta=1e-10)
        self.assertAlmostEqual(case['squared_residual'], (1 - 3 * probability) ** 2, delta=1e-10)
        for distribution in (original, replace(original, alpha=np.zeros(len(original.alpha)), beta=1.)):
            zero = unit.calibration_case(distribution, 0, 0)
            self.assertEqual(zero['conditional_mean'], 0.)
            self.assertEqual(zero['conditional_variance'], 0.)
            self.assertEqual(zero['fixed_variance'], 0.)
            self.assertEqual(zero['squared_residual'], 0.)

    def test_calibration_balanced_unequal_means_and_direct_enumeration(self):
        poisson_mass = math.exp(-4) * 4 ** 4 / math.factorial(4)
        beta = 1 / (1 + poisson_mass)
        qemp = beta * poisson_mass
        original = JointDistribution(np.array([[0, 4], [4, 0]]), np.array([.75 * qemp, .25 * qemp]),
                                     beta, np.array([2., 2.]), np.zeros(2), 0)
        case = unit.calibration_case(original, 0, 4)
        self.assertAlmostEqual(case['empirical_fraction'], .5, delta=1e-12)
        self.assertAlmostEqual(case['background_fraction'], .5, delta=1e-12)
        self.assertAlmostEqual(case['conditional_mean'], 1.5, delta=1e-12)
        self.assertAlmostEqual(case['fixed_variance'], .75, delta=1e-12)
        self.assertAlmostEqual(case['conditional_variance'], 2.25, delta=1e-12)
        np.testing.assert_array_equal(case['empirical_probabilities'], [.75, 0., 0., 0., .25])
        for distribution, observation in ((original, (0, 4)), (fixture(), (1, 6)), (fixture(), (2, 0))):
            row = unit.calibration_case(distribution, *observation)
            total = sum(observation)
            p = distribution.rates[0] / distribution.rates.sum()
            background = np.array([math.comb(total, h) * p ** h * (1 - p) ** (total - h)
                                   for h in range(total + 1)])
            mixture = row['empirical_fraction'] * row['empirical_probabilities'] + row['background_fraction'] * background
            direct_mean = math.fsum(h * float(mass) for h, mass in enumerate(mixture))
            direct_variance = math.fsum(float(mass) * (h - direct_mean) ** 2 for h, mass in enumerate(mixture))
            self.assertAlmostEqual(math.fsum(mixture), 1., delta=1e-12)
            self.assertAlmostEqual(row['conditional_mean'], direct_mean, delta=1e-10)
            self.assertAlmostEqual(row['conditional_variance'], direct_variance, delta=1e-10)
            self.assertAlmostEqual(row['squared_residual'], (observation[0] - direct_mean) ** 2, delta=1e-10)
            expected_log_mass = math.log(math.fsum(distribution.alpha[distribution.atoms.sum(axis=1) == total])
                                         + distribution.beta * math.exp(-distribution.rates.sum())
                                         * distribution.rates.sum() ** total / math.factorial(total))
            self.assertAlmostEqual(row['log_total_mass'], expected_log_mass, delta=1e-10)
        estimate = estimate_scale([case['empirical_probabilities']], [case['empirical_fraction']],
                                  [case['fixed_variance']], [case['squared_residual']], [1.])
        self.assertAlmostEqual(estimate['s'], 1., delta=1e-12)

    def test_calibration_case_invalid_observations_and_total_rates(self):
        for observation in ((-1, 2), (1.5, 2), (1., 2), (True, 2), ('1', 2),
                            (np.nan, 0), (0, np.inf), (201, 0), (100, 101)):
            with self.subTest(observation=observation), self.assertRaises(unit.ConditionalAdapterFailure):
