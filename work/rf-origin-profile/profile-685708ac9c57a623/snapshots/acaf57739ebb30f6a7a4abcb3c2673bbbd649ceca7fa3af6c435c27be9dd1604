"""Frozen RF-02D development inference and separate mapping/candidate decisions."""
import hashlib

import numpy as np

from research_score_contract import encoded
from research_score_inference import block_weights, weekly_sums, simultaneous_intervals
from research_score_metrics import TARGETS, LEVELS, aggregate

VERSION = 'rf02d-conditional-inference.v1'
CONFIG_CANONICAL_SHA = 'fac9699963dbf0ba41e03706099902b462b7965bda448f7ddc2ab3c2d5b084d1'
LENGTHS = (1, 3, 6)
YEARS = tuple(range(2013, 2026))
YEAR_COUNTS = (256,) * 8 + (272, 271, 272, 272, 272)
AUDITS = {'admission', 'leakage', 'falsification', 'no_new_numerical_failure'}
LIMITATIONS = {'production_authorized': False, 'prospective_evidence': False,
              'external_five_percent_achieved': False, 'original_publication_verified': False,
              'history_informed_exploratory_intervals': True, 'original_decisions_overwritten': False}


class InferenceFailure(ValueError):
    pass


def require(condition, reason):
    if not condition:
        raise InferenceFailure(reason)


def _registered(config):
    require(hashlib.sha256(encoded(config)).hexdigest() == CONFIG_CANONICAL_SHA, 'frozen_configuration_mismatch')
    mapped = tuple(map(tuple, config['series']))
    raw = tuple(map(tuple, config['raw_references']))
    comparisons = [(row['id'], tuple(row['reference']), tuple(row['candidate'])) for row in config['comparisons']]
    cells = tuple(map(tuple, config['calibration_cells']))
    require(len(mapped) == len(set(mapped)) == 20 and len(raw) == len(set(raw)) == 6
            and not set(mapped) & set(raw) and len(comparisons) == 28
            and len({row[0] for row in comparisons}) == 28 and len(cells) == len(set(cells)) == 16,
            'registered_family_mismatch')
    return mapped, raw, comparisons, cells


def _number(value):
    return type(value) in (int, float) and np.isfinite(value)


def _validate(config, metadata, rows_by_series, audit_checks):
    mapped, raw, comparisons, cells = _registered(config)
    require(type(audit_checks) is dict and set(audit_checks) == AUDITS
            and all(type(value) is bool and value for value in audit_checks.values()), 'required_audit_failure')
    require(type(metadata) is list and len(metadata) == 3407, 'production_common_population_required')
    require(all(type(row) is dict and set(row) == {'game_id', 'season', 'week'}
                and type(row['game_id']) is str and row['game_id']
                and type(row['season']) is int and row['season'] in YEARS
                and type(row['week']) is int and 1 <= row['week'] <= 18 for row in metadata), 'invalid_game_metadata')
    keys = [row['game_id'] for row in metadata]
    require(len(set(keys)) == 3407 and [(r['season'], r['week']) for r in metadata]
            == sorted((r['season'], r['week']) for r in metadata), 'duplicate_or_unordered_common_games')
    require([sum(row['season'] == year for row in metadata) for year in YEARS] == list(YEAR_COUNTS)
            and len({(r['season'], r['week']) for r in metadata}) == 226, 'season_or_origin_population_mismatch')
    require(set(rows_by_series) == set(mapped + raw), 'required_series_membership')
    metrics, failures = {}, {}
    observed = None
    for key in mapped + raw:
        rows = rows_by_series[key]
        require(len(rows) == 3407 and [row['game_id'] for row in rows] == keys, 'series_game_alignment_mismatch')
        require(all(type(row) is dict and set(row) == {'game_id', 'metrics', 'native_failure'} for row in rows),
                'invalid_scored_row_schema')
        require(all(row['native_failure'] is None or (type(row['native_failure']) is str and row['native_failure'])
                    for row in rows), 'invalid_native_failure_flag')
        failures[key] = [row['native_failure'] is not None for row in rows]
        require(key[0] not in ('N0', 'N0C') or not any(failures[key]), 'required_N0_native_failure')
        metrics[key] = [row['metrics'] for row in rows]
        first_fields = set(metrics[key][0])
        required = {'joint_energy_score', 'joint_nll', 'home_win_probability', 'home_win_observed',
                    'tie_probability', 'away_win_probability', 'predicted_covariance', 'residual_product',
                    'grid_cells', 'grid_transport_bound', 'grid_probability_bound', 'double_grid_difference',
                    'home_win_brier', 'home_win_log_loss', 'win_tie_loss_brier', 'win_tie_loss_log_loss',
                    'tail_absolute_margin_21', 'tail_total_70', 'observed_absolute_margin_21', 'observed_total_70'}
        for target in TARGETS:
            required.update(target + suffix for suffix in ('_crps', '_mae', '_squared_error', '_mean', '_observed', '_pit'))
            for level in LEVELS:
                required.update(f'{target}_{suffix}_{round(100 * level)}'
                                for suffix in ('lower', 'upper', 'coverage', 'width', 'boundary_distance'))
            if key in mapped:
                required.add(target + '_interval_mass_80')
        require(required <= first_fields, 'incomplete_required_metrics')
        for row in metrics[key]:
            require(type(row) is dict and set(row) == first_fields, 'inconsistent_metric_fields')
            require(all(_number(value) for name, value in row.items() if name != 'grid_cells'), 'nonfinite_or_nonnumeric_metric')
            require(type(row['grid_cells']) is list and len(row['grid_cells']) == 2
                    and all(type(value) is int and value > 0 for value in row['grid_cells']), 'invalid_grid_shape')
            require(row['joint_energy_score'] >= 0 and row['joint_nll'] >= 0, 'negative_proper_loss')
            require(0 < row['home_win_probability'] < 1 and 0 <= row['tie_probability'] <= 1
                    and 0 <= row['away_win_probability'] <= 1
                    and abs(sum(row[name] for name in ('home_win_probability', 'tie_probability', 'away_win_probability')) - 1) <= 1e-10
                    and row['home_win_observed'] in (0, 1), 'invalid_win_diagnostics')
            for target in TARGETS:
                require(0 <= row[target + '_pit'] <= 1 and row[target + '_crps'] >= 0
                        and row[target + '_mae'] >= 0 and row[target + '_squared_error'] >= 0, 'invalid_marginal_metrics')
                if key in mapped:
                    require(0 <= row[target + '_interval_mass_80'] <= 1, 'invalid_actual_interval_mass')
                for level in LEVELS:
                    suffix = str(round(100 * level))
                    lo, hi = row[f'{target}_lower_{suffix}'], row[f'{target}_upper_{suffix}']
                    value = row[target + '_observed']
                    require(lo == int(lo) and hi == int(hi) and lo <= hi
                            and row[f'{target}_width_{suffix}'] == hi - lo
                            and row[f'{target}_coverage_{suffix}'] == float(lo <= value <= hi), 'invalid_interval_diagnostics')
        outcomes = [tuple(row[target + '_observed'] for target in TARGETS) + (row['home_win_observed'],) for row in metrics[key]]
        require(all(h >= 0 and a >= 0 and h == int(h) and a == int(a) and h + a <= 200
                    and margin == h - a and total == h + a and win == float(h > a)
                    for h, a, margin, total, win in outcomes), 'inconsistent_observed_targets')
        require(observed is None or outcomes == observed, 'cross_series_outcome_mismatch')
        observed = outcomes
    for family in ('N0', 'E2'):
        for variant in ('full', 'availability_24h'):
            require(failures[family, variant] == failures[family + 'C', variant], 'inherited_failure_flag_mismatch')
        require(failures[family + 'C', 'full'] == failures[family + 'C', 'independent_marginals'],
                'independent_full_failure_flag_mismatch')
    return mapped, raw, comparisons, cells, metrics, failures


def paired_block_statistics(losses, residuals, counts, game_groups, references, candidates):
    """Explicit synthetic matrices are allowed here; production membership is enforced above."""
    losses, residuals, counts = (np.asarray(value, dtype=float) for value in (losses, residuals, counts))
    groups, references, candidates = (np.asarray(value) for value in (game_groups, references, candidates))
    require(losses.ndim == residuals.ndim == counts.ndim == 2 and len(losses) == len(residuals)
            and groups.shape == (len(losses),) and groups.dtype.kind in 'iu'
            and references.ndim == candidates.ndim == 1 and references.shape == candidates.shape
            and references.dtype.kind in 'iu' and candidates.dtype.kind in 'iu'
            and len(references) > 0 and len(counts) >= 2 and counts.shape[1] > 0
            and np.all(groups >= 0) and np.all(groups < counts.shape[1])
            and np.all(references >= 0) and np.all(candidates >= 0)
            and np.all(references < losses.shape[1]) and np.all(candidates < losses.shape[1]), 'invalid_block_shapes')
    require(all(np.all(np.isfinite(value)) for value in (losses, residuals, counts))
            and np.all(losses >= 0) and np.all(counts >= 0) and np.all(counts == np.floor(counts)), 'invalid_block_values')
    totals = counts @ np.bincount(groups, minlength=counts.shape[1])
    require(np.all(totals > 0), 'empty_bootstrap_member')
    means = losses.mean(axis=0)
    sampled_means = counts @ weekly_sums(losses, groups, counts.shape[1]) / totals[:, None]
    require(np.all(means > 0) and np.all(sampled_means[:, references] > 0), 'nonpositive_reference_loss')
    gains = 1 - means[candidates] / means[references]
    sampled_gains = 1 - sampled_means[:, candidates] / sampled_means[:, references]
    energy = simultaneous_intervals(gains, sampled_gains)
    point_residuals = residuals.mean(axis=0)
    sampled_residuals = counts @ weekly_sums(residuals, groups, counts.shape[1]) / totals[:, None]
    calibration = simultaneous_intervals(point_residuals, sampled_residuals)
    return {'gains': gains, 'sampled_gains': sampled_gains, 'energy': energy,
            'residuals': point_residuals, 'sampled_residuals': sampled_residuals,
            'calibration': calibration, 'denominators': totals}


def _bands(point, endpoints):
    lower, upper, sd, _ = endpoints
    return [{'point': float(point[i]), 'lower': float(lower[i]), 'upper': float(upper[i]),
             'bootstrap_sd': float(sd[i])} for i in range(len(point))]


def _infer(metadata, metrics, mapped, raw, comparisons, cells):
    series = mapped + raw
    lookup = {key: i for i, key in enumerate(series)}
    references = np.array([lookup[ref] for _, ref, _ in comparisons])
    candidates = np.array([lookup[candidate] for _, _, candidate in comparisons])
    losses = np.array([[row['joint_energy_score'] for row in metrics[key]] for key in series]).T
    residuals = np.array([[row[target + '_coverage_80'] - row[target + '_interval_mass_80']
                           for row in metrics[family, variant]] for family, variant, target, _ in cells]).T
    coverage_columns = [(key, target, round(100 * level)) for key in mapped for target in TARGETS for level in LEVELS]
    coverage = np.array([[row[f'{target}_coverage_{level}'] for row in metrics[key]]
                         for key, target, level in coverage_columns]).T
    output = {'population': '2013-2024_development_only', 'games': len(metadata),
              'comparison_order': [name for name, _, _ in comparisons], 'calibration_cell_order': [list(c) for c in cells],
              'comparisons': {name: {'reference': list(ref), 'candidate': list(candidate), 'blocks': {}}
                              for name, ref, candidate in comparisons},
              'calibration_cells': {':'.join(map(str, cell)): {'blocks': {}} for cell in cells}, 'blocks': {}}
    for length in LENGTHS:
        counts, groups, keys = block_weights(metadata, length, members=10000, required_seasons=12)
        require(counts.shape == (10000, len(keys)), 'production_bootstrap_member_count_mismatch')
        stats = paired_block_statistics(losses, residuals, counts, groups, references, candidates)
        for (name, _, _), result in zip(comparisons, _bands(stats['gains'], stats['energy'])):
            output['comparisons'][name]['gain'] = result.pop('point')
            output['comparisons'][name]['blocks'][str(length)] = result
        for cell, result in zip(cells, _bands(stats['residuals'], stats['calibration'])):
            output['calibration_cells'][':'.join(map(str, cell))]['residual'] = result.pop('point')
            output['calibration_cells'][':'.join(map(str, cell))]['blocks'][str(length)] = result
        counts = counts.astype(float)
        sampled_coverage = counts @ weekly_sums(coverage, groups, len(keys)) / stats['denominators'][:, None]
        endpoints = np.quantile(sampled_coverage, [.025, .975], axis=0, method='linear')
        nominal = {':'.join((*key, target, str(level))): {'point': float(coverage[:, i].mean()),
                   'lower': float(endpoints[0, i]), 'upper': float(endpoints[1, i])}
                   for i, (key, target, level) in enumerate(coverage_columns)}
        pit = {}
        for key in mapped:
            for target in TARGETS:
                values = np.array([row[target + '_pit'] for row in metrics[key]])
                observed_bins = np.eye(10)[np.minimum(9, np.floor(values * 10).astype(int))]
                proportions = observed_bins.mean(axis=0)
                sampled = counts @ weekly_sums(observed_bins, groups, len(keys)) / stats['denominators'][:, None]
                radius = float(np.quantile(np.max(np.abs(sampled - proportions), axis=1), .95, method='linear'))
                pit[':'.join((*key, target))] = {'family': 'ten_bins_for_this_series_target', 'radius': radius,
                      'lower': np.maximum(0, proportions - radius).tolist(), 'upper': np.minimum(1, proportions + radius).tolist()}
        output['blocks'][str(length)] = {'members': 10000, 'energy_critical_max_standardized': stats['energy'][3],
                                        'calibration_critical_max_standardized': stats['calibration'][3],
                                        'coverage': nominal, 'pit_simultaneous_bands': pit}
    return output


def _validate_calibration(values, rows):
    require(set(values) == set(TARGETS) | {'home_win'}, 'required_calibration_completeness')
    for target, result in values.items():
        require(type(result.get('n')) is int and result['n'] == len(rows), 'required_calibration_population')
        predictions = [row['home_win_probability' if target == 'home_win' else target + '_mean'] for row in rows]
        if result.get('status') == 'available':
            require(all(_number(result.get(field)) for field in ('intercept', 'slope')), 'required_calibration_failure')
        elif result.get('status') == 'unavailable_by_design':
            require(result.get('reason') == 'constant_predictor' and type(result.get('rank')) is int and result['rank'] == 1
                    and _number(result.get('prediction_min')) and result['prediction_min'] == result.get('prediction_max')
                    and all(value == result['prediction_min'] for value in predictions), 'unsubstantiated_structural_unavailability')
        else:
            raise InferenceFailure('required_calibration_failure')


def _all_bounds(inference, name, endpoint, positive):
    return all(inference['comparisons'][name]['blocks'][str(length)][endpoint] > 0 if positive
               else inference['comparisons'][name]['blocks'][str(length)][endpoint] < 0 for length in LENGTHS)


def _cell_checks(inference, families):
    return {name: all(row['blocks'][str(length)]['lower'] <= 0 <= row['blocks'][str(length)]['upper']
                       for length in LENGTHS)
            for name, row in inference['calibration_cells'].items() if name.split(':')[0] in families}


def _decision(metadata, metrics, failures, mapped, inference):
    """Small synthetic decisions may use explicit cohorts; evaluate enforces real counts."""
    development = [i for i, row in enumerate(metadata) if 2013 <= row['season'] <= 2024]
    diagnostic = [i for i, row in enumerate(metadata) if row['season'] == 2025]
    seasons = sorted({metadata[i]['season'] for i in development})
    def mean(key, metric, indices=development):
        require(indices, 'empty_decision_cohort')
        result = float(np.mean([metrics[key][i][metric] for i in indices]))
        require(np.isfinite(result), 'nonfinite_decision_mean')
        return result
    def gain(reference, candidate, indices=development):
        denominator = mean(reference, 'joint_energy_score', indices)
        require(denominator > 0, 'nonpositive_decision_reference')
        return 1 - mean(candidate, 'joint_energy_score', indices) / denominator
    secondary = ['joint_nll'] + [target + '_crps' for target in TARGETS]
    mapping = {}
    for variant in ('full', 'availability_24h'):
        reference, candidate = ('E2', variant), ('E2C', variant)
        name = f'E2:{variant}->E2C:{variant}'
        mapping[variant + '_energy_lower_positive_all_blocks'] = _all_bounds(inference, name, 'lower', True)
        for metric in secondary:
            mapping[variant + '_' + metric] = mean(candidate, metric) <= 1.005 * mean(reference, metric)
    mapping.update({'calibration:' + name: value for name, value in _cell_checks(inference, {'E2C'}).items()})
    candidate = ('E2C', 'full')
    checks, stability = {}, {}
    for reference in (('N0', 'full'), ('N0C', 'full')):
        label = ':'.join(reference)
        overall = gain(reference, candidate)
        by_season = {str(year): gain(reference, candidate, [i for i in development if metadata[i]['season'] == year]) for year in seasons}
        leave_one = {str(year): gain(reference, candidate, [i for i in development if metadata[i]['season'] != year]) for year in seasons}
        exposed = gain(reference, candidate, diagnostic)
        checks[label + ':energy_gain_at_least_one_percent'] = overall >= .01
        checks[label + ':energy_lower_positive_all_blocks'] = _all_bounds(inference, label + '->E2C:full', 'lower', True)
        checks[label + ':eight_improved_seasons'] = sum(value > 0 for value in by_season.values()) >= 8
        checks[label + ':all_leave_one_out_positive'] = all(value > 0 for value in leave_one.values())
        checks[label + ':exposed_2025_positive'] = exposed > 0
        for metric in secondary:
            checks[label + ':' + metric] = mean(candidate, metric) <= 1.005 * mean(reference, metric)
        for target in ('home', 'away'):
            checks[label + ':' + target + '_mae'] = mean(candidate, target + '_mae') <= mean(reference, target + '_mae') + .1
        for target in TARGETS:
            checks[label + ':' + target + '_width'] = mean(candidate, target + '_width_80') <= 1.1 * mean(reference, target + '_width_80') or overall >= .02
        checks[label + ':availability_24h_gain'] = gain((reference[0], 'availability_24h'), ('E2C', 'availability_24h')) > 0
        stability[label] = {'development_gain': overall, 'season_gains': by_season, 'leave_one_season_out_gains': leave_one,
                            'exposed_2025_gain': exposed,
                            'availability_24h_gain': gain((reference[0], 'availability_24h'), ('E2C', 'availability_24h'))}
    for reference in ('E2', 'E1'):
        checks[reference + ':energy_lower_positive_all_blocks'] = _all_bounds(inference, reference + ':full->E2C:full', 'lower', True)
    checks['not_stably_worse_than_S1'] = not _all_bounds(inference, 'S1:full->E2C:full', 'upper', False)
    for target in TARGETS:
        coverage = mean(candidate, target + '_coverage_80')
        checks[target + ':nominal_80_coverage_range'] = .72 <= coverage <= .88
    checks.update({'calibration:' + name: value for name, value in _cell_checks(inference, {'N0C', 'E2C'}).items()})
    failure_rates = {':'.join(key): float(np.mean(values)) for key, values in failures.items()}
    failure_gates = set(mapped) | {(family, variant) for family in ('N0', 'E2')
                                   for variant in ('full', 'availability_24h')}
    for name, rate in failure_rates.items():
        if tuple(name.split(':')) in failure_gates:
            checks[name + ':native_failure_ceiling'] = rate <= .005
    for family, variant in mapped:
        if family != 'E2C' or variant in ('full', 'availability_24h'):
            continue
        name = f'E2C:full->E2C:{variant}'
        checks[variant + ':does_not_stably_outperform_full'] = not _all_bounds(inference, name, 'lower', True)
        if variant in ('no_offense', 'no_defense'):
            checks[variant + ':positive_mechanism_all_blocks'] = _all_bounds(inference, name, 'upper', False)
    mapping_supported, candidate_qualified = all(mapping.values()), all(checks.values())
    status = ('research_candidate_qualified_not_promoted' if candidate_qualified else
              'mapping_supported_only' if mapping_supported else 'reject_all')
    return {'status': status, 'mapping_supported': mapping_supported, 'candidate_qualified': candidate_qualified,
            'mapping_checks': mapping, 'candidate_checks': checks, 'stability': stability,
            'all_issued_native_failure_rates': failure_rates, 'failure_population': '2013-2025_all_issued',
            'N0_mapping_gains': {variant: gain(('N0', variant), ('N0C', variant)) for variant in ('full', 'availability_24h')},
            **LIMITATIONS}


def evaluate(config, metadata, rows_by_series, audit_checks):
    """Full fixed production gate. Caller authenticates artifacts and audit evidence."""
    result = {'version': VERSION, 'status': 'protocol_invalid', 'mapping_supported': False,
              'candidate_qualified': False, **LIMITATIONS}
    try:
        mapped, raw, comparisons, cells, metrics, failures = _validate(config, metadata, rows_by_series, audit_checks)
        development = [i for i, row in enumerate(metadata) if row['season'] <= 2024]
        diagnostic = [i for i, row in enumerate(metadata) if row['season'] == 2025]
        dev_metrics = {key: [rows[i] for i in development] for key, rows in metrics.items()}
        scorecards = {}
        for key in mapped + raw:
            card = aggregate(dev_metrics[key])
            if key in mapped:
                _validate_calibration(card['calibration'], dev_metrics[key])
            scorecards[':'.join(key)] = {'development': card,
                'exposed_2025': aggregate([metrics[key][i] for i in diagnostic]),
                'development_2014_2024_descriptive': aggregate([metrics[key][i] for i in development if metadata[i]['season'] >= 2014])}
        result['scorecards'] = scorecards
        inference = _infer([metadata[i] for i in development], dev_metrics, mapped, raw, comparisons, cells)
        result['inference'] = inference
        result.update(_decision(metadata, metrics, failures, mapped, inference))
        result['audit_checks'] = dict(audit_checks)
        result['counts'] = {'development_games': 3135, 'exposed_2025_games': 272, 'mapped_series': 20,
                            'raw_references': 6, 'energy_comparisons': 28, 'calibration_cells': 16}
        encoded(result)  # Never turn nonfinite numerical output into a string marker.
    except Exception as exc:
        result = {'version': VERSION, 'status': 'protocol_invalid', 'mapping_supported': False,
                  'candidate_qualified': False, 'failure_type': type(exc).__name__, 'reason': str(exc), **LIMITATIONS}
    return result
