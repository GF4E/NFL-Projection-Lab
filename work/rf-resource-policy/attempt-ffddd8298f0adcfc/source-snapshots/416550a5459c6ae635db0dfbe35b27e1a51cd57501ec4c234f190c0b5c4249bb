def saved(mapper, independent=False):
    theta = np.array([0., -0.])
    _, alpha, beta, rates, _, _ = mapper.components(theta)
    distribution = JointDistribution(mapper.atoms, alpha, beta, rates, theta, 3, independent)
    mean, covariance = distribution.moments()
    descriptor = {'version': 'rf.joint-distribution.v2', 'mapper': {'name': 'object-' + 'a' * 64 + '.json', 'sha256': 'a' * 64},
                  'theta': theta.tolist(), 'alphaSha256': unit.sha(unit.encoded(alpha.tolist())), 'beta': beta,
                  'rates': rates.tolist(), 'iterations': 3, 'independent': independent,
                  'mean': mean.tolist(), 'covariance': covariance.tolist()}
    return distribution, descriptor


def source_record(game='old', season=2013, week=1, kickoff='2013-09-05T18:00:00+00:00', home=0, away=2):
    dt = datetime.fromisoformat(kickoff)
    return {'gameId': game, 'season': season, 'week': week, 'homeTeam': 'A', 'awayTeam': 'B', 'neutral': False,
            'homeScore': home, 'awayScore': away, 'kickoffAt': kickoff,
            'availability': {str(delay): (dt + timedelta(hours=delay)).isoformat() for delay in (12, 24)}}


def case_source(record, failure=None):
    return {'game_id': record['gameId'], 'season': record['season'],
            'origin_at': (datetime.fromisoformat(record['kickoffAt']) - timedelta(days=2)).isoformat(),
            'kickoff_at': record['kickoffAt'], 'availability': record['availability'], 'native_failure': failure}


