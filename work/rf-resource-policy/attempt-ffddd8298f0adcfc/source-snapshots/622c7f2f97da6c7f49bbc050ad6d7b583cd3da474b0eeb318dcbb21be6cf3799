    parser.add_argument("--report", type=Path)
    args = parser.parse_args()
    started = time.monotonic()
    suite = unittest.defaultTestLoader.loadTestsFromTestCase(SplitMeanUnitTests)
    result_ = unittest.TextTestRunner(verbosity=2).run(suite)
    seconds = time.monotonic() - started
    rss = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss / (1024 ** 2 if sys.platform == "darwin" else 1024)
    bounded = seconds <= 120 and rss <= 2048
    report = {"status": "passed_synthetic_only" if result_.wasSuccessful() and bounded else "failed",
              "tests": result_.testsRun, "failures": len(result_.failures), "errors": len(result_.errors),
              "testSecondsExcludingImports": seconds, "peakRssMiB": rss, "withinBounds": bounded,
              "python": sys.version.split()[0], "numpy": np.__version__,
              "sourceSha256": {str(p.relative_to(ROOT)): hashlib.sha256(p.read_bytes()).hexdigest()
                  for p in [ROOT / "scripts/research_score_models.py", ROOT / "scripts/research_score_split_models.py", Path(__file__).resolve()]},
              "historicalDataLoaded": False, "historicalFitOrScore": False}
    if args.report:
        args.report.parent.mkdir(parents=True, exist_ok=True)
        args.report.write_text(json.dumps(report, indent=2) + "\n")
    print(json.dumps(report))
    raise SystemExit(0 if result_.wasSuccessful() and bounded else 1)
