    def test_binding_failure_or_boolean_proof_prevents_labels_and_poisoned_retry(self):
        for invalid in ('raise', 'boolean'):
            x = self.case(2011); grader = g.PublishedOriginGrader()
            with measured(x.view['origin']) as acc:
                pointer = x.publish(acc)
                def bad():
                    if invalid == 'raise': raise ValueError('binding_failed')
                    return True
                with patch.object(a, 'grade_inputs', side_effect=AssertionError('premature labels')) as opened:
                    with self.assertRaises(ValueError): x.grade(grader, acc, pointer, bad)
                    with self.assertRaisesRegex(ValueError, 'grader_stopped'): x.grade(grader, acc, pointer)
                    opened.assert_not_called()

    def test_tampered_publication_plan_or_law_rejected_before_labels(self):
        for invalid in ('publication', 'plan', 'law'):
            x = self.case(2011)
            with measured(x.view['origin']) as acc:
                pointer = x.publish(acc)
                if invalid == 'publication':
                    (x.store.path / pointer['name']).write_bytes(b'{}')
                elif invalid == 'plan':
                    x.assembly['grading_plan']['inner'][0]['mode'] = 'new_score'
                else:
                    x.assembly['resolved_laws']['inner', 9, 'z-target'] = x.assembly['resolved_laws']['inner', 9, 'a-target']
                    # These tiny means can coincide, so force a different real law.
                    x.assembly['resolved_laws']['inner', 9, 'z-target'] = x.view['mappers'][12].fit([22., 13.])
                with patch.object(a, 'grade_inputs', side_effect=AssertionError('premature labels')) as opened:
                    with self.assertRaises(ValueError): x.grade(g.PublishedOriginGrader(), acc, pointer)
                    opened.assert_not_called()

