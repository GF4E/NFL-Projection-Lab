    def test_score_failure_and_stop_retain_callback_no_retry_or_terminal(self):
        for error in (NumericalFailure('synthetic_double_grid_failure'), RuntimeStop('synthetic_budget_stop')):
            x = self.case(2011); grader = g.PublishedOriginGrader()
            with measured(x.view['origin']) as acc:
                pointer = x.publish(acc)
                with patch.object(g, 'score_forecast', side_effect=error) as score:
                    with self.assertRaises(type(error)): x.grade(grader, acc, pointer)
                    self.assertEqual(grader.last_attempt_origin, [2011, 1])
                    copied_origin = grader.last_attempt_origin; copied_origin[0] = 2025
                    self.assertEqual(grader.last_attempt_origin, [2011, 1])
                    with self.assertRaisesRegex(ValueError, 'grader_stopped'): x.grade(grader, acc, pointer)
                    self.assertIsNone(grader.last_attempt_origin)
                    self.assertEqual(score.call_count, 1)
                calls = [r for r in acc._active_origin['callbacks'] if r['kind'] == 'score']
                self.assertEqual(len(calls), 1); self.assertEqual(calls[0]['error_type'], type(error).__name__)
                attempted = grader.last_attempt_counts
                self.assertEqual(attempted['actual_score_calls'], 1)
                self.assertEqual(attempted['scored_inner'], 0)
                self.assertEqual(attempted['copied_diagonal_inner'], 9)
                attempted['actual_score_calls'] = 99
                self.assertEqual(grader.last_attempt_counts['actual_score_calls'], 1)
            self.assertFalse((x.store.path / 'completion').exists())
            self.assertNotIn('inner-losses-2011-01.json', x.store.index)

    def test_saved_score_reload_fault_poisoned_and_partial_file_retained(self):
        x = self.case(2011); grader = g.PublishedOriginGrader()
        with measured(x.view['origin']) as acc:
            pointer = x.publish(acc)
            original = x.store.read_bound
            def changed(p):
                result = original(p)
                if p['name'].startswith('inner-losses-'):
                    result[0]['metrics']['joint_energy_score'] += 1
                return result
            with patch.object(x.store, 'read_bound', changed):
                with self.assertRaisesRegex(ValueError, 'saved_scores_changed'): x.grade(grader, acc, pointer)
            with self.assertRaisesRegex(ValueError, 'grader_stopped'): x.grade(grader, acc, pointer)
        self.assertIn('inner-losses-2011-01.json', x.store.index)
        self.assertNotIn('grading-provenance-2011-01.json', x.store.index)

    def test_directory_fsync_fault_withholds_ready_batch_and_retains_attempt(self):
        x = self.case(2011); grader = g.PublishedOriginGrader(); returned = None
        with measured(x.view['origin']) as acc:
            pointer = x.publish(acc)
            original = g.os.fsync
            def failure(fd):
                if fd == x.store.fd:
                    raise OSError('synthetic_score_directory_fsync_failure')
                return original(fd)
            with patch.object(g.os, 'fsync', failure):
                with self.assertRaisesRegex(OSError, 'score_directory_fsync'):
                    returned = x.grade(grader, acc, pointer)
            self.assertIsNone(returned)
            self.assertEqual(grader.last_attempt_origin, [2011, 1])
            self.assertEqual(grader.last_attempt_counts['actual_score_calls'], 36)
            self.assertEqual(grader.last_attempt_counts['inner_rows'], 54)
            with self.assertRaisesRegex(ValueError, 'grader_stopped'): x.grade(grader, acc, pointer)
        self.assertIn('inner-losses-2011-01.json', x.store.index)
        self.assertIn('grading-provenance-2011-01.json', x.store.index)
        self.assertFalse((x.store.path / 'completion').exists())

