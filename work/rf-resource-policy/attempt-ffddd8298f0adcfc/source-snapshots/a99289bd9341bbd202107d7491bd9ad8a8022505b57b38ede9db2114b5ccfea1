    def test_first_double_grid_persists_across_origins_and_resets_only_by_new_season(self):
        x, origins = self.multi_origin_case(); grader = g.PublishedOriginGrader()
        for index, origin in enumerate(origins):
            x.view = a.forecast_inputs(x.context, origin, lambda: None)
            x.pointers = {d: put_object(x.store, value['payload']) for d, value in x.view['mapper_sources'].items()}
            with measured(origin) as acc:
                pointer = x.publish(acc); x.grade(grader, acc, pointer)
                calls = [r for r in acc._active_origin['callbacks'] if r['kind'] == 'score']
            self.assertEqual([r['double_grid'] for r in calls],
