        with measured(origins[-1]) as acc, patch.object(a, 'grade_inputs', side_effect=AssertionError('repeat labels')) as opened:
            with self.assertRaisesRegex(ValueError, 'grader_original_origin_order'): x.grade(grader, acc, pointer)
            opened.assert_not_called()

