def _current(context, origin, budget_check, *, grade=False):
    origin = _context_origin(context, origin)
    records = {r['gameId']: r for r in parse(context._records_bytes)}
    archive, config = _reader(context), parse(context._config_bytes)
    selection = parse(dict(context._selection_bytes)[origin['season']]) if origin['season'] >= 2013 else None
    result = _origin_artifacts(archive, records, origin, setting_grid(config), registered_series(config), selection,
                               parse(context._mapper_pointer_bytes), budget_check, grade=grade)
    return origin, records, selection, result


def forecast_inputs(context, origin, budget_check):
    """Return current pregame inputs only; target labels/losses stay private."""
    origin, _, selection, result = _current(context, origin, budget_check)
    prepared, diagonal, full, outer, mappers, mapper_sources, _, _, pointers = result
    selected_sources = {(f, v, g): row for (f, v, g), row in outer.items()
                        if f in ('N0', 'E2') or (f, v) in RAW_REFERENCES}
    return {'origin': origin, 'prepared_receipts': prepared,
            'bank_prepared': {d: {k: list(prepared[d][k]) for k in ('history', 'targets')} for d in (12, 24)},
            'diagonal_outputs': diagonal,
            'source_laws': {'full': {key: row for key, row in full.items() if key[0] in ('N0', 'E2')},
                            'outer': selected_sources},
            'mapper_sources': mapper_sources, 'mappers': mappers, 'original_selection': selection,
            'source_pointers': {k: p for k, p in pointers.items() if 'losses' not in k}}


@dataclass(frozen=True)
class _GradingReceipt:
    origin: tuple
    manifest_sha256: str
    publication_sha256: str
    parent_manifest_sha256: str
    _seal: object = field(repr=False, compare=False)
    _diagonal_binding: tuple = field(default=(), repr=False)


def _publication(origin, pointer, read_publication, expected_manifest_sha256):
    _hash(expected_manifest_sha256)
    require(type(pointer) is dict and set(pointer) == {'name', 'sha256', 'bytes'} and type(pointer['name']) is str
            and re.fullmatch('[a-z0-9][a-z0-9.-]*', pointer['name']) and '..' not in pointer['name']
            and type(pointer['bytes']) is int and pointer['bytes'] > 0 and callable(read_publication), 'invalid_publication_pointer')
    _hash(pointer['sha256'])
    raw = read_publication(copy.deepcopy(pointer))
    require(type(raw) is bytes and len(raw) == pointer['bytes'] and sha(raw) == pointer['sha256'], 'publication_bytes_mismatch')
    value = parse(raw)
    require(type(value) is dict and set(value) == {'version', 'manifest_sha256', 'parent_manifest_sha256', 'origin',
            'origin_at', 'target_game_ids', 'full_setting_forecasts', 'outer_selected_forecasts'}
            and value['version'] == 'rf02f.origin-publication.v1' and value['manifest_sha256'] == expected_manifest_sha256
            and value['parent_manifest_sha256'] == PARENT_MANIFEST and value['origin'] == list(_origin_key(origin))
            and all(type(x) is int for x in value['origin']) and value['origin_at'] == origin['originAt']
            and value['target_game_ids'] == origin['targetGameIds'], 'publication_owner_or_origin_mismatch')
    full_expected = [('E3', i, g) for g in origin['targetGameIds'] for i in range(27)] if 2011 <= origin['season'] <= 2024 else []
    outer_series = tuple(('E3', v) for v in SPLIT_VARIANTS) + RAW_REFERENCES
    outer_expected = [(f, v, g) for f, v in outer_series for g in origin['targetGameIds']] if origin['season'] >= 2013 else []
    for selected, field_name, expected in ((False, 'full_setting_forecasts', full_expected),
                                           (True, 'outer_selected_forecasts', outer_expected)):
        rows = value[field_name]
        require(type(rows) is list and len(rows) == len(expected), 'publication_incomplete_population')
        for row, key in zip(rows, expected):
            fields = {'family', 'setting', 'game_id', 'native_failure', 'distribution'} | ({'variant'} if selected else set())
            require(type(row) is dict and set(row) == fields and type(row['distribution']) is dict
                    and (row['setting'] is None and selected or type(row['setting']) is int), 'publication_row_schema')
            _reason(row['native_failure'])
            maximum = {'E3': 27, 'N0': 1, 'E2': 9, 'E1': 27, 'S1': 6}.get(row['family'], 0)
            require(row['setting'] is None or 0 <= row['setting'] < maximum, 'publication_setting_range')
            require(row['setting'] is not None or row['native_failure'] == 'no_eligible_setting', 'publication_noeligible_flag')
            require(row['family'] != 'N0' or row['native_failure'] is None, 'publication_N0_native_failure')
            actual = (row['family'], row['variant'] if selected else row['setting'], row['game_id'])
            require(actual == key, 'publication_member_order_mismatch')
            # Recipe/law semantics are separately validated by the controller.
            def no_outcomes(item):
                if type(item) is dict:
                    for k, v in item.items():
                        require(type(k) is str and not ('observed' in k.lower() or k in {'metrics', 'labels', 'homeScore', 'awayScore', 'overtime'}),
                                'outcome_in_forecast_publication')
                        no_outcomes(v)
                elif type(item) is list:
                    for v in item:
                        no_outcomes(v)
            no_outcomes(row['distribution'])
    return _GradingReceipt(_origin_key(origin), expected_manifest_sha256, pointer['sha256'], PARENT_MANIFEST, _SEAL)


def grade_inputs(context, origin, publication_pointer, budget_check, *, read_publication, expected_manifest_sha256):
    """Open grader-only current labels/losses after a complete bound publication."""
    origin = _context_origin(context, origin)
    budget_check()
    proof = _publication(origin, publication_pointer, read_publication, expected_manifest_sha256)
    origin, records, _, result = _current(context, origin, budget_check, grade=True)
    inner, losses, pointers = result[6:]
    proof = _GradingReceipt(proof.origin, proof.manifest_sha256, proof.publication_sha256,
                            proof.parent_manifest_sha256, _SEAL,
                            tuple((r['setting'], r['game_id'], r['metrics']['joint_energy_score'], r['native_failure'])
                                  for r in inner if r['family'] == 'E2')
                            if 2011 <= origin['season'] <= 2024 else ())
    by_key = {(row['family'], row['variant'], row['game_id']): row for row in losses}
    return {'origin': origin, 'grading_receipt': proof,
            'labels': {g: [records[g]['homeScore'], records[g]['awayScore']] for g in origin['targetGameIds']},
            'diagonal_inner_rows': [row for row in inner if row['family'] == 'E2'],
            'raw_outer_rows': [by_key[f, v, g] for f, v in RAW_REFERENCES for g in origin['targetGameIds']] if losses else [],
            'e2_outer_rows': [row for row in losses if row['family'] == 'E2'], 'source_pointers': pointers}


class StrictSelectionFeed:
    """Own an empty selector; admit complete post-publication batches in order."""
    def __init__(self, context):
        require(type(context) is SourceContext and context._seal is _SEAL, 'unadmitted_source_context')
        self._context = context
        self._selector = SplitSelectionHistory()
        self._origins = tuple(b for b in context._origins if 2011 <= parse(b)['season'] <= 2024)
        self._next = 0
        self._manifest = None
        self._accepted_rows = {}

    def _integrity(self):
        require(self._selector.settings == {'E3': split_setting_grid()}
                and self._selector.config == {'failure': {'innerSettingIneligibleAboveFailureRate': .005},
                                               'common': {'selectionTieTolerance': 1e-8}}
                and self._selector.rows == self._accepted_rows, 'selector_state_or_grid_changed')

    def add(self, origin, rows, grading_receipt):
        self._integrity()
        origin = _context_origin(self._context, origin)
        require(self._next < len(self._origins) and encoded(origin) == self._origins[self._next], 'nonchronological_inner_batch')
        require(type(grading_receipt) is _GradingReceipt and grading_receipt._seal is _SEAL
                and grading_receipt.origin == _origin_key(origin) and grading_receipt.parent_manifest_sha256 == PARENT_MANIFEST,
                'missing_bound_grading_receipt')
        require(self._manifest is None or grading_receipt.manifest_sha256 == self._manifest, 'selection_run_swap')
        year = origin['season']
        require(year < 2013 or year in self._selector.frozen_choices, 'annual_selection_not_frozen_before_grading')
        diagonal = grading_receipt._diagonal_binding
        require([(i, game) for i, game, _, _ in diagonal]
                == [(i, game) for game in origin['targetGameIds'] for i in range(9)], 'missing_diagonal_grading_binding')
        diagonal = {(i, game): (energy, reason) for i, game, energy, reason in diagonal}
        expected = [('E3', i, g) for g in origin['targetGameIds'] for i in range(27)]
        require(type(rows) is list and len(rows) == len(expected), 'selection_batch_population')
        additions = {}
        for row, key in zip(rows, expected):
            require(type(row) is dict and set(row) == {'family', 'setting', 'game_id', 'native_failure', 'metrics'}
                    and type(row['setting']) is int and (row['family'], row['setting'], row['game_id']) == key,
                    'selection_batch_order_or_types')
            require(type(row['metrics']) is dict and 'joint_energy_score' in row['metrics'], 'selection_metric_missing')
            energy = row['metrics']['joint_energy_score']
            _number(energy, 'invalid_selection_energy', 0)
            failed = _reason(row['native_failure'])
            if row['setting'] < 9:
                require(encoded([energy, row['native_failure']])
                        == encoded(list(diagonal[row['setting'], row['game_id']])), 'reused_diagonal_selection_changed')
            additions[year, row['game_id'], 'E3', row['setting']] = (float(energy), failed)
        require(not (set(additions) & set(self._accepted_rows)), 'duplicate_selection_batch')
        # Commit only after all rows pass; the unchanged helper now cannot fail.
        for (y, game, family, setting), (energy, failed) in additions.items():
            self._selector.add(y, game, family, setting, energy, failed)
        self._accepted_rows.update(additions)
        self._manifest = grading_receipt.manifest_sha256
        self._next += 1

    def select(self, year, expected_by_season):
        self._integrity()
        require(type(year) is int and 2013 <= year <= 2025, 'invalid_outer_year')
        require(type(expected_by_season) is dict and all(type(y) is int for y in expected_by_season), 'invalid_universe_type')
        admitted = self._context.expected_by_season
        for prior in (year - 2, year - 1):
            require(prior in expected_by_season and type(expected_by_season[prior]) is list
                    and expected_by_season[prior] == admitted[prior], 'prior_universe_changed')
        expected = {(y, g, 'E3', i) for y in (year - 2, year - 1) for g in admitted[y] for i in range(27)}
        require({k for k in self._accepted_rows if k[0] in (year - 2, year - 1)} == expected, 'prior_selection_population')
        require(not any(k[0] > year for k in self._accepted_rows), 'selection_future_prefill')
        # Recompute from the same validated prior rows even when the pure helper
        # has a cached choice, so tampering with that mutable cache fails closed.
        fresh = SplitSelectionHistory()
        fresh.rows = dict(self._accepted_rows)
        expected_choice = fresh.select(year, expected_by_season)
        if year in self._selector.frozen_choices:
            require(self._selector.frozen_choices[year] == expected_choice, 'cached_selection_changed')
        return self._selector.select(year, expected_by_season)
