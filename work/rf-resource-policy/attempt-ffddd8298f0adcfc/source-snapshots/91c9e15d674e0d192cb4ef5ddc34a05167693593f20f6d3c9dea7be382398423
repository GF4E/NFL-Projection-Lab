def _number(value, reason, minimum=None):
    require(type(value) in (int, float) and math.isfinite(value)
            and (minimum is None or value >= minimum), reason)


def _reason(value):
    require(value is None or (type(value) is str and bool(value.strip())), 'invalid_native_reason')
    return value is not None


def _hash(value):
    require(type(value) is str and re.fullmatch('[0-9a-f]{64}', value), 'invalid_hash')


def _origin_key(origin):
    require(type(origin) is dict and type(origin.get('season')) is int
            and type(origin.get('week')) is int, 'invalid_origin_type')
    return origin['season'], origin['week']


def _suffix(origin):
    year, week = _origin_key(origin)
    return f'{year}-{week:02}'


def _pointer(archive, name):
    require(name in archive.index, 'missing_source_artifact:' + name)
    return {'name': name, **archive.index[name]}


def _physical(archive):
    require({p.name for p in archive.directory.iterdir()} == set(archive.index) | {'artifact-index.json'},
            'physical_archive_membership_mismatch')


def _prepared(records, origin):
    result = {delay: prepare_origin(records, origin, delay) for delay in (12, 24)}
    for delay, receipt in result.items():
        require([g.game_id for g in receipt['targets']] == origin['targetGameIds'], 'target_order_mismatch')
        require(type(origin['windows'][str(delay)]['minimumTrainingMet']) is bool, 'invalid_training_flag')
    return result


def _state(state, origin, prepared, settings, series):
    require(type(state) is dict and set(state) == {'origin', 'actual_computation_at', 'historical_status',
            'prospective', 'trajectory_state'} and state['origin'] == origin
            and state['historical_status'] == 'retrospective_inferred' and state['prospective'] is False,
            'state_origin_provenance_mismatch')
    require(datetime.fromisoformat(state['actual_computation_at']).utcoffset() is not None, 'invalid_state_timestamp')
    expected = [(f, i, v) for f, v in series if v not in ('independent_marginals', 'deterministic_noise')
                for i in range(len(settings[f]))]
    rows = state['trajectory_state']
    require(type(rows) is list and len(rows) == len(expected), 'state_population_mismatch')
    native, diagonal = {}, {}
    for row, key in zip(rows, expected):
        require(type(row) is dict and set(row) == {'key', 'output', 'ratings', 'offense', 'defense'}
                and type(row['key']) is list and len(row['key']) == 3
                and type(row['key'][1]) is int and tuple(row['key']) == key, 'state_key_mismatch')
        family, index, variant = key
        output = row['output']
        require(type(output) is dict and set(output) == {'forecasts', 'events', 'support', 'league_mean',
                'home_effect', 'elo_score_slope', 'absorbing_failure'}, 'native_output_schema')
        require(type(output['absorbing_failure']) is bool, 'native_absorbing_flag')
        forecasts = output['forecasts']
        require(type(forecasts) is list and [r.get('game_id') for r in forecasts]
                == sorted(origin['targetGameIds']), 'native_target_population')
        for forecast in forecasts:
            require(type(forecast) is dict and set(forecast) == {'game_id', 'mean', 'failure', 'initialization_only'}
                    and type(forecast['initialization_only']) is bool, 'native_forecast_schema')
            failed = _reason(forecast['failure'])
            mean = forecast['mean']
            if mean is not None:
                require(type(mean) is list and len(mean) == 2, 'native_mean_shape')
                for value in mean:
                    _number(value, 'native_mean_nonfinite')
                require(failed or min(mean) > 0, 'successful_native_mean_not_positive')
            require(failed or mean is not None, 'successful_native_mean_missing')
            require(mean is not None or forecast['failure'] == 'warmup_no_prior_score' or output['absorbing_failure'],
                    'unexplained_native_mean_missing')
            if forecast['failure'] == 'warmup_no_prior_score':
                require(mean is None and forecast['initialization_only'] is True, 'warmup_native_flag_mismatch')
            native[(*key, forecast['game_id'])] = forecast
        if family != 'E2':
            continue
        for field in ('ratings', 'offense', 'defense'):
            require(type(row[field]) is list and len(row[field]) == 32, 'diagonal_state_shape')
            for value in row[field]:
                _number(value, 'diagonal_state_nonfinite')
        require(output['support'] is None and type(output['elo_score_slope']) in (int, float)
                and output['elo_score_slope'] == 0, 'diagonal_support_mismatch')
        if output['league_mean'] is not None:
            _number(output['league_mean'], 'invalid_league_mean', 0)
        _number(output['home_effect'], 'invalid_home_effect')
        events = output['events']
        delay = 24 if variant == 'availability_24h' else 12
        require(type(events) is dict and set(events) == {'delivered', 'initialization_only', 'offseason_retention_applied'}
                and type(events['offseason_retention_applied']) is bool, 'diagonal_event_schema')
        require(events['offseason_retention_applied'] is (origin['season'] > 2010 and origin['week'] == 1),
                'diagonal_offseason_event_mismatch')
        expected_delivered = origin['windows'][str(delay)]['firstDeliveryIds']
        require(type(events['delivered']) is list and events['delivered'] == expected_delivered,
                'diagonal_delivery_mismatch')
        init = events['initialization_only']
        require(type(init) is list and all(type(x) is str for x in init) and len(init) == len(set(init))
                and set(init) <= set(expected_delivered), 'diagonal_initialization_mismatch')
        require(set(expected_delivered) <= set(prepared[delay]['input_ids']), 'delivery_outside_closure')
        diagonal[index, variant] = copy.deepcopy(output)
    require(set(diagonal) == {(i, v) for i in range(9) for v in STATE_VARIANTS}, 'diagonal_cache_population')
    return native, diagonal


def _mapper(payload, prepared, records, season):
    validate_mapper(payload, prepared, records)
    expected = JointBase.from_scores([[r.home_score, r.away_score] for r in prepared['history']],
                                    weights(prepared['history'], season, 2.5))
    exact = {'atoms': expected.atoms.tolist(), 'weights': expected.weights.tolist(), 'b': expected.b,
             'epsilon': expected.epsilon, 'input_sha256': prepared['input_hash'], 'half_life': 2.5}
    require(encoded(payload) == encoded(exact), 'mapper_empirical_weights_or_parameters_mismatch')
    return expected


def _descriptor(value):
    require(type(value) is dict and set(value) == {'version', 'mapper', 'theta', 'beta', 'rates', 'alphaSha256',
            'iterations', 'independent', 'mean', 'covariance'} and value['version'] == 'rf.joint-distribution.v2',
            'saved_descriptor_schema')
    require(type(value['mapper']) is dict and set(value['mapper']) == {'name', 'sha256'}, 'saved_mapper_pointer')
    _hash(value['mapper']['sha256'])
    require(value['mapper']['name'] == 'object-' + value['mapper']['sha256'] + '.json', 'saved_mapper_pointer')
    _hash(value['alphaSha256'])
    require(type(value['iterations']) is int and value['iterations'] >= 0
            and type(value['independent']) is bool, 'saved_descriptor_flags')
    for name in ('theta', 'rates', 'mean'):
        require(type(value[name]) is list and len(value[name]) == 2, 'saved_descriptor_vector')
        for number in value[name]:
            _number(number, 'saved_descriptor_nonfinite')
    require(min(value['rates'] + value['mean']) > 0, 'saved_descriptor_positive')
    _number(value['beta'], 'saved_beta', 0)
    require(value['beta'] <= 1, 'saved_beta')
    require(type(value['covariance']) is list and len(value['covariance']) == 2, 'saved_covariance')
    for row in value['covariance']:
        require(type(row) is list and len(row) == 2, 'saved_covariance')
        for number in row:
            _number(number, 'saved_covariance')


def recover_source_law(mapper, descriptor):
    """Lazy saved-component recovery only. Never invoke fit/grid/scorer."""
    require(type(mapper) is JointBase, 'unqualified_mapper_class')
    _descriptor(descriptor)
    return recover_distribution(mapper, descriptor)


def _metrics(value, target, outer):
    require(type(value) is dict and set(value) == (_OUTER_METRICS if outer else _BASE_METRICS),
            'inner_outer_metric_schema_mismatch')
    for name, number in value.items():
        if name != 'grid_cells':
            _number(number, 'invalid_saved_metric')
    cells = value['grid_cells']
    require(type(cells) is list and len(cells) == 2 and all(type(x) is int and 0 < x <= 1024 for x in cells),
            'invalid_saved_grid_shape')
    _number(value['joint_energy_score'], 'invalid_inner_energy', 0)
    h, a = target['homeScore'], target['awayScore']
    require([value[t + '_observed'] for t in _TARGETS] == [h, a, h-a, h+a], 'saved_observation_mismatch')


def _law_row(row, selected=False):
    fields = {'family', 'setting', 'game_id', 'native_failure', 'distribution'} | ({'variant'} if selected else set())
    require(type(row) is dict and set(row) == fields and type(row['family']) is str
            and type(row['game_id']) is str and (row['setting'] is None and selected or type(row['setting']) is int),
            'source_law_row_schema')
    _reason(row['native_failure'])
    _descriptor(row['distribution'])


def _selection_schema(selection, settings):
    require(type(selection) is dict and set(selection) == set(settings), 'selection_schema')
    for family, decision in selection.items():
        require(type(decision) is dict and set(decision) == {'candidates', 'games', 'inner_seasons', 'setting', 'status'}
                and type(decision['games']) is int and type(decision['inner_seasons']) is list
                and all(type(y) is int for y in decision['inner_seasons'])
                and (decision['setting'] is None or type(decision['setting']) is int), 'selection_typed_metadata')
        require(type(decision['candidates']) is list and len(decision['candidates']) == len(settings[family]),
                'selection_candidate_count')
        for i, candidate in enumerate(decision['candidates']):
            require(type(candidate) is dict and set(candidate) == {'setting', 'mean_energy', 'failure_rate', 'eligible'}
                    and type(candidate['setting']) is int and candidate['setting'] == i
                    and type(candidate['eligible']) is bool, 'selection_typed_candidate')
            _number(candidate['mean_energy'], 'selection_energy', 0)
            _number(candidate['failure_rate'], 'selection_failure_rate', 0)
            require(candidate['failure_rate'] <= 1, 'selection_failure_rate')


def _origin_artifacts(archive, records, origin, settings, series, selection, mapper_pointers, budget_check, *, grade=False):
    """Generic bound-reader boundary also used by small synthetic fixtures."""
    budget_check()
    prepared = _prepared(list(records.values()), origin)
    suffix = _suffix(origin)
    state_name = 'state-' + suffix + '.json'
    native, diagonal = _state(archive.read(state_name), origin, prepared, settings, series)
    pointers = {'state': _pointer(archive, state_name)}
    if _origin_key(origin) in WARMUPS:
        require(origin['windows']['12']['minimumTrainingMet'] is False, 'warmup_training_contradiction')
        name = 'warmup-' + suffix + '.json'
        require(archive.read(name) == {'status': 'warmup_unforecastable', 'targets': origin['targetGameIds']},
                'warmup_envelope_mismatch')
        require(all(prefix + suffix + '.json' not in archive.index for prefix in ('forecasts-', 'inner-losses-', 'ancestry-')),
                'unexpected_warmup_forecast')
        pointers['warmup'] = _pointer(archive, name)
        return prepared, diagonal, {}, {}, {}, {}, [], [], pointers
    require(origin['windows']['12']['minimumTrainingMet'] is True, 'unregistered_warmup_exception')
    publication_name = 'forecasts-' + suffix + '.json'
    publication = archive.read(publication_name)
    require(type(publication) is dict and set(publication) == {'classification', 'origin_at', 'manifest_sha256',
            'full_setting_forecasts', 'outer_selected_forecasts'} and publication['classification'] == 'retrospective'
            and publication['origin_at'] == origin['originAt'] and publication['manifest_sha256'] == archive.manifest_sha256,
            'forecast_origin_provenance_mismatch')
    ancestry_name = 'ancestry-' + suffix + '.json'
    ancestry = archive.read(ancestry_name)
    require(type(ancestry) is dict and set(ancestry) == {'12', '24'}, 'lineage_delay_population')
    mappers, mapper_sources = {}, {}
    for delay in (12, 24):
        budget_check()
        validate_lineage(ancestry[str(delay)], prepared[delay], archive.manifest, archive.manifest_sha256,
                         archive.index[publication_name]['sha256'])
        key = prepared[delay]['input_hash']
        require(key in mapper_pointers, 'eligible_mapper_missing')
        pointer = mapper_pointers[key]
        payload = archive.read(pointer)
        mappers[delay] = _mapper(payload, prepared[delay], records, origin['season'])
        mapper_sources[delay] = {'pointer': copy.deepcopy(pointer), 'payload': payload}
    full, outer = {}, {}
    expected = [(f, i, game) for game in origin['targetGameIds'] for f, grid in settings.items() for i in range(len(grid))]
    full_rows = publication['full_setting_forecasts']
    require(type(full_rows) is list and len(full_rows) == len(expected), 'full_source_population')
    for row, key in zip(full_rows, expected):
        _law_row(row)
        family, setting, game = key
        require((row['family'], row['setting'], row['game_id']) == key, 'full_source_order')
        require(row['distribution']['mapper'] == mapper_sources[12]['pointer'] and row['distribution']['independent'] is False,
                'full_mapper_or_flags_mismatch')
        forecast = native[family, setting, 'full', game]
        if forecast['failure'] is not None:
            require(row['native_failure'] == forecast['failure'], 'full_native_reason_mismatch')
        if row['native_failure'] is None:
            validate_requested_mean(dict(row, variant='full'), native, {family: {'setting': setting}})
        else:
            require(family != 'N0' and encoded(row['distribution']) == encoded(full['N0', 0, game]['distribution']),
                    'full_N0_fallback_mismatch')
        full[key] = row
    inner_name = 'inner-losses-' + suffix + '.json'
    inner = []
    if grade:
        inner = archive.read(inner_name)
        require(type(inner) is list and len(inner) == len(expected), 'inner_source_population')
        for row, key in zip(inner, expected):
            require(type(row) is dict and set(row) == {'family', 'setting', 'game_id', 'native_failure', 'metrics'}
                    and type(row['setting']) is int and (row['family'], row['setting'], row['game_id']) == key,
                    'inner_source_order_or_schema')
            require(row['native_failure'] == full[key]['native_failure'], 'inner_native_reason_mismatch')
            _metrics(row['metrics'], records[row['game_id']], False)
    losses = []
    if origin['season'] >= 2013:
        outer_name = 'outer-losses-' + suffix + '.json'
        outer_expected = [(f, v, g) for f, v in series for g in origin['targetGameIds']]
        rows = publication['outer_selected_forecasts']
        require(type(rows) is list and [(r['family'], r['variant'], r['game_id']) for r in rows] == outer_expected,
                'selected_forecast_population_mismatch')
        outer = dict(zip(outer_expected, rows))
        if grade:
            losses = archive.read(outer_name)
            outer, _ = validate_selected_rows(publication, losses, origin, series)
        for key, row in outer.items():
            _law_row(row, True)
            family, variant, game = key
            validate_requested_mean(row, native, selection)
            delay = 24 if variant == 'availability_24h' else 12
            require(row['distribution']['mapper'] == mapper_sources[delay]['pointer']
                    and row['distribution']['independent'] is (variant == 'independent_marginals'), 'selected_mapper_or_flags')
            if row['setting'] is None:
                require(row['native_failure'] == 'no_eligible_setting', 'no_eligible_reason_mismatch')
            elif variant == 'full':
                require(encoded(row['distribution']) == encoded(full[family, row['setting'], game]['distribution'])
                        and row['native_failure'] == full[family, row['setting'], game]['native_failure'], 'selected_full_source_mismatch')
            else:
                v = 'full' if variant in ('independent_marginals', 'deterministic_noise') else variant
                reason = native[family, row['setting'], v, game]['failure']
                require(reason is None or row['native_failure'] == reason, 'selected_native_reason_mismatch')
            if row['native_failure'] is not None:
                fallback = variant if ('N0', variant) in series else 'full'
                require(family != 'N0' and encoded(row['distribution']) == encoded(outer['N0', fallback, game]['distribution']),
                        'selected_N0_fallback_mismatch')
            if variant == 'independent_marginals':
                validate_independent_source(outer[family, 'full', game], row)
        for row in losses:
            require(type(row) is dict and set(row) == {'family', 'variant', 'game_id', 'native_failure', 'metrics'},
                    'outer_loss_schema')
            _metrics(row['metrics'], records[row['game_id']], True)
        pointers['outer_losses'] = _pointer(archive, outer_name)
    else:
        require(publication['outer_selected_forecasts'] == [], 'early_outer_population')
    pointers.update(forecasts=_pointer(archive, publication_name), ancestry=_pointer(archive, ancestry_name),
                    inner_losses=_pointer(archive, inner_name))
    return prepared, diagonal, full, outer, mappers, mapper_sources, inner, losses, pointers


@dataclass(frozen=True)
class SourceContext:
    _directory: Path = field(repr=False)
    _index_bytes: bytes = field(repr=False)
    _manifest_bytes: bytes = field(repr=False)
    _records_bytes: bytes = field(repr=False)
    _origins: tuple = field(repr=False)
    _config_bytes: bytes = field(repr=False)
    _selection_bytes: tuple = field(repr=False)
    _mapper_pointer_bytes: bytes = field(repr=False)
    _inner: tuple = field(repr=False)
    _provenance_bytes: bytes = field(repr=False)
    _seal: object = field(repr=False, compare=False)
    _origin_keys: tuple = field(init=False, repr=False)

    def __post_init__(self):
        object.__setattr__(self, '_origin_keys', tuple(_origin_key(parse(raw)) for raw in self._origins))

    @property
    def origins(self):
        return [parse(raw) for raw in self._origins]

    @property
    def teams(self):
        records = parse(self._records_bytes)
        return sorted({r['homeTeam'] for r in records} | {r['awayTeam'] for r in records})

    @property
    def expected_by_season(self):
        records = parse(self._records_bytes)
        return {year: [r['gameId'] for r in records if r['season'] == year] for year in range(2010, 2026)}

    @property
    def provenance(self):
        return parse(self._provenance_bytes)


def _context_origin(context, origin):
    require(type(context) is SourceContext and context._seal is _SEAL, 'unadmitted_source_context')
    key = _origin_key(origin)
    require(key in context._origin_keys, 'origin_not_exact_admitted_source')
    raw = context._origins[context._origin_keys.index(key)]
    require(encoded(origin) == raw, 'origin_not_exact_admitted_source')
    return parse(raw)


def _reader(context):
    # Local mutable reader; no caller can alter the context's index bytes.
    archive = object.__new__(Archive)
    archive.directory = context._directory
    archive.index = parse(context._index_bytes)['files']
    archive.manifest = parse(context._manifest_bytes)
    archive.manifest_sha256, archive.index_sha256 = sha(context._manifest_bytes), sha(context._index_bytes)
    archive.checked = {}
    return archive


def admit_source(repository_root, budget_check):
    """Production-only complete admission inside the owning controller's clock."""
    from research_score_compute_run import preflight
    root = Path(repository_root)
    require(callable(budget_check), 'missing_shared_budget')
    budget_check()
    for name, fingerprint in HELPER_HASHES.items():
        bound(root / name, fingerprint)
    bound(root / PROTOCOL_PATH, PROTOCOL_SHA)
    registry = parse(bound(root / CONFIG_PATH, CONFIG_SHA))
    acceptance = parse(bound(root / ACCEPTANCE_PATH, PROTOCOL_ACCEPTANCE_SHA))
    require(acceptance['protocol']['sha256'] == PROTOCOL_SHA and acceptance['machineRegistry']['sha256'] == CONFIG_SHA,
            'protocol_acceptance_mismatch')
    for key in ('independentFinalSupplements', 'preservedEarlierReviews', 'acceptedPureUnits'):
        for pointer in acceptance[key]:
            budget_check()
