    def test_dict_list_hooks_are_called_once_on_fast_and_fallback(self):
        for cls, expected_hook in [(DictHook, 'items'), (ListHook, 'iter')]:
            for bad in (False, True):
                def factory(cls=cls, bad=bad):
                    v = cls({'x': Opaque() if bad else 1}) if cls is DictHook else cls([Opaque() if bad else 1])
                    v.calls, v.fail = [], False
                    return v
                snap = (lambda bad=bad: {'x': Opaque() if bad else 1}) if cls is DictHook else (lambda bad=bad: [Opaque() if bad else 1])
                left, right, _ = self.compare(cls.__name__+'-fallback-'+str(bad), factory,
                                              eligible=not bad, snapshot_factory=snap)
                _emit({'test': self.id(), 'label': cls.__name__+'-hook-count-'+str(bad), 'kind': 'hook_counts',
                       'original': list(left.calls), 'candidate': list(right.calls), 'expected': [expected_hook]})
                self.assertEqual(left.calls, [expected_hook]); self.assertEqual(right.calls, [expected_hook])

    def test_numpy_hooks_are_called_once_on_fast_and_fallback(self):
        for cls, expected_hook in [(ArrayHook, 'tolist'), (ItemHook, 'item')]:
            for bad in (False, True):
                def factory(cls=cls, bad=bad):
                    v = np.array([1.]).view(cls) if cls is ArrayHook else cls(1.)
                    v.calls, v.fail, v.payload = [], False, [Opaque()] if bad else {'x': [-0., 2]}
                    return v
                left, right, _ = self.compare(cls.__name__+'-fallback-'+str(bad), factory,
                    eligible=not bad, snapshot_factory=lambda bad=bad: [Opaque()] if bad else {'x': [-0., 2]})
                _emit({'test': self.id(), 'label': cls.__name__+'-hook-count-'+str(bad), 'kind': 'hook_counts',
                       'original': list(left.calls), 'candidate': list(right.calls), 'expected': [expected_hook]})
                self.assertEqual(left.calls, [expected_hook]); self.assertEqual(right.calls, [expected_hook])

    def test_raw_hook_failures_propagate_once(self):
        for cls, hook in [(ArrayHook, 'tolist'), (ItemHook, 'item'), (DictHook, 'items'), (ListHook, 'iter')]:
            def factory(cls=cls):
                v = np.array([1.]).view(cls) if cls is ArrayHook else cls(1.) if cls is ItemHook else cls()
                v.calls, v.fail, v.payload = [], True, None
                return v
            left, right, outcome = self.compare('failed-hook-'+cls.__name__, factory, eligible=None)
            self.assertEqual(outcome['kind'], 'error')
            _emit({'test': self.id(), 'label': cls.__name__+'-failed-hook-count', 'kind': 'hook_counts',
                   'original': list(left.calls), 'candidate': list(right.calls), 'expected': [hook]})
            self.assertEqual(left.calls, [hook]); self.assertEqual(right.calls, [hook])
        self.compare('valid-after-hook-errors', lambda: {'ok': [1, -0.]})

    def test_self_and_mutual_cycles_keep_original_failure(self):
        def self_list():
            x = []; x.append(x); return x
        def self_dict():
            x = {}; x['self'] = x; return x
        def mutual():
            a, b = [], {}; a.append(b); b['a'] = a; return a
        for label, factory in [('self-list', self_list), ('self-dict', self_dict), ('mutual', mutual)]:
            self.compare(label, factory, eligible=None)
            self.guard(label+'-canonical-domain', factory(), False)
        self.compare('valid-after-cycles', lambda: [1, {'x': []}])

