    def test_depth_exact_boundary_and_deep_delegation(self):
        for cls in (list, dict):
            for depth in (1, 31, 32, 33, 80):
                self.compare(cls.__name__+'-depth-'+str(depth), lambda depth=depth, cls=cls: _nested(depth, kind=cls),
                             eligible=depth <= LIMIT_DEPTH)
        recursion = sys.getrecursionlimit()
        self.compare('beyond-canonical-recursion', lambda: _nested(recursion * 2), eligible=None)
        self.assertEqual(sys.getrecursionlimit(), recursion)

    def test_node_boundary_counts_root_and_key_occurrences(self):
        for nodes in (LIMIT_NODES-1, LIMIT_NODES, LIMIT_NODES+1):
            self.compare('list-nodes-'+str(nodes), lambda nodes=nodes: [0] * (nodes-1), eligible=nodes <= LIMIT_NODES)
        # 1 dict + 1 key + 1 list + N scalar values: exactly N+3 nodes.
        for nodes in (LIMIT_NODES, LIMIT_NODES+1):
            self.compare('key-counts-as-node-'+str(nodes), lambda nodes=nodes: {'x': [0] * (nodes-3)}, eligible=nodes <= LIMIT_NODES)

    def test_shared_occurrences_count_again_at_node_guard(self):
        # 1 root + M occurrences of (1 list + 1 integer); no unique-ID shortcut.
        for count in (65535, 65536):
            shared = [0]
            snapshot = [shared] * count
            self.guard('shared-node-count-'+str(count), snapshot, 1+2*count <= LIMIT_NODES)
        self.compare('shared-node-fallback', lambda: [[0]] * 65536, eligible=False)

    def test_string_char_guard_counts_values_and_keys(self):
        for chars in (LIMIT_CHARS-1, LIMIT_CHARS, LIMIT_CHARS+1):
            self.compare('string-chars-'+str(chars), lambda chars=chars: 'a' * chars, eligible=chars <= LIMIT_CHARS)
        for chars in (LIMIT_CHARS, LIMIT_CHARS+1):
            self.compare('key-plus-value-chars-'+str(chars), lambda chars=chars: {'é': 'a' * (chars-1)}, eligible=chars <= LIMIT_CHARS)
        # Repeated shared string occurrences count again; Unicode characters,
        # not ensure_ascii output bytes, define the eligibility boundary.
        shared = '😀' * (LIMIT_CHARS // 2)
        self.guard('shared-unicode-characters-at', [shared, shared], True)
        self.guard('shared-unicode-characters-over', [shared, shared, 'x'], False)

    def test_guard_rejects_snapshot_subclasses_without_hooks(self):
        values = [Text('x'), Integer(1), Floating(1.), {Text('x'): 1}, (), np.int64(1), np.array([1])]
        for i, value in enumerate(values):self.guard('snapshot-unsupported-'+str(i), value, False)
        for cls, value in [(DictHook, {'x': 1}), (ListHook, [1])]:
