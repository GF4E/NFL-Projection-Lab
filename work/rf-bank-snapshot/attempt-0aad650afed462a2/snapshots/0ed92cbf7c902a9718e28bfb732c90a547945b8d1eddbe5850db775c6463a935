"""Independent RF strict serializer equality tests; qualification owns execution.

OBSERVATIONS are emitted before equality assertions. A qualification driver may
set a writer to persist each record immediately. No frozen module is patched.
"""
from pathlib import Path
import hashlib
import math
import struct
import sys
import unittest
from unittest.mock import patch

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / 'scripts'))
import numpy as np
from research_score_conditional_run import strict as original_strict
from research_score_conditional_replay import canonical
import research_score_strict_compute as candidate

OBSERVATIONS = []
_OBSERVATION_WRITER = None
LIMIT_DEPTH = 32
LIMIT_NODES = 131072
LIMIT_CHARS = 4 * 1024 * 1024


def set_observation_writer(writer):
    """Optional streaming sink; the driver, not tests, chooses the output path."""
    global _OBSERVATION_WRITER
    if writer is not None and not callable(writer):
        raise TypeError('observation writer must be callable or None')
    _OBSERVATION_WRITER = writer


def _emit(value):
    if _OBSERVATION_WRITER is None:
        OBSERVATIONS.append(value)
    else:
        _OBSERVATION_WRITER(value)


def _capture(function, value):
    try:
        result = function(value)
    except Exception as error:
        return {'kind': 'error', 'module': type(error).__module__,
                'type': type(error).__qualname__, 'message': str(error)}, type(error)
    if type(result) is bytes:
        return {'kind': 'bytes', 'type': 'bytes', 'bytes': len(result),
                'sha256': hashlib.sha256(result).hexdigest(),
                'ascii_body': result.decode('ascii')}, bytes
    return {'kind': 'unexpected_return', 'type': type(result).__qualname__}, type(result)


def _nested(levels, leaf=0, kind=list):
    result = leaf
    for _ in range(levels):
        result = [result] if kind is list else {'x': result}
    return result


class Text(str):
    pass


class Integer(int):
    pass


class Floating(float):
    pass


class Opaque:
    pass


class ItemHook(np.float64):
    def item(self, *args):
        self.calls.append('item')
        if self.fail:
            raise RuntimeError('item hook failed')
        return self.payload


class ArrayHook(np.ndarray):
    def tolist(self):
        self.calls.append('tolist')
        if self.fail:
            raise RuntimeError('tolist hook failed')
        return self.payload


class DictHook(dict):
    def items(self):
        self.calls.append('items')
        if self.fail:
            raise RuntimeError('items hook failed')
        return super().items()


class ListHook(list):
    def __iter__(self):
        self.calls.append('iter')
        if self.fail:
            raise RuntimeError('iter hook failed')
        return super().__iter__()


class StrictEqualityTests(unittest.TestCase):
    def compare(self, label, factory, *, eligible=True, snapshot_factory=None):
        # Original/candidate receive distinct but equal inputs, including their
        # own counters for side-effecting hooks. Eligibility uses a third,
        # independent canonical snapshot, never a second traversal of either.
        left, right = factory(), factory()
        original, original_type = _capture(original_strict, left)
        actual, actual_type = _capture(candidate.strict, right)
        if eligible is None:
            eligibility = {'expected': None, 'actual': None,
                           'reason': 'raw canonicalization must fail before encoding eligibility'}
        else:
            snapshot = snapshot_factory() if snapshot_factory is not None else canonical(factory())
            answer = candidate.eligible(snapshot)
            eligibility = {'expected': eligible, 'actual': answer, 'type': type(answer).__name__}
        _emit({'test': self.id(), 'label': label,
               'input': {'root_type': type(left).__name__, 'deterministic_builder': label,
                         'reproducer': 'frozen test method named by test field'},
               'original': original, 'candidate': actual, 'eligibility': eligibility})
        self.assertIs(actual_type, original_type, label)
        self.assertEqual(actual, original, label)
        if eligible is not None:
            self.assertIs(type(eligibility['actual']), bool, label)
            self.assertIs(eligibility['actual'], eligible, label)
        return left, right, original

    def guard(self, label, snapshot, expected):
        actual = candidate.eligible(snapshot)
        _emit({'test': self.id(), 'label': label, 'kind': 'guard_only',
               'expected': expected, 'actual': actual, 'type': type(actual).__name__})
        self.assertIs(type(actual), bool)
        self.assertIs(actual, expected, label)

    def test_scalar_tokens_and_empty_containers(self):
        for i, value in enumerate((None, False, True, 0, -1, 1, '', [], {}, (), 0.0, -0.0)):
            with self.subTest(i=i):
                self.compare('scalar-'+str(i), lambda v=value: v)
        self.compare('nested-empty-containers', lambda: {'z': [[], {}, ()], 'a': ({}, [None])})

    def test_insertion_order_string_sorting_and_delimiters(self):
        for order in [('10', '2', '02', 'a'), ('a', '02', '2', '10')]:
            self.compare('key-order-'+','.join(order), lambda order=order: {k: {'{}[],:': ['x,y', ':{}', []]} for k in order})
        a = candidate.strict({'2': 2, '10': 10, '02': 2})
        b = candidate.strict({'02': 2, '10': 10, '2': 2})
        self.assertEqual(a, b)

    def test_quotes_backslashes_and_every_control_character(self):
        values = [''.join(chr(i) for i in range(32)), '\\"\\\\\\/', '{}[],:',
                  'prefix\\\\\\\\\\\\\\"suffix', '\\' * 257 + '"' + '\\' * 258,
                  'outside:\ninside:\tend:\r', '\x7f']
        self.compare('all-control-escapes', lambda: {v: [v, '', {'quoted"': '\\'}] for v in values})

    def test_unicode_bmp_nonbmp_surrogates_and_key_order(self):
        keys = ['\u0000', 'é', '中', '\u2028', '\u2029', '\uffff', '\U00010000', '\U0010ffff', '\ud800', '\udfff']
        self.compare('unicode-and-lone-surrogates', lambda: {k: [k, 'é😀\\"\n'] for k in reversed(keys)})
        result = candidate.strict({'é': '\ud800😀'})
        self.assertIn(b'\\u00e9', result)
        self.assertIn(b'\\ud800\\ud83d\\ude00', result)
        self.assertTrue(result.endswith(b'\n') and not result.endswith(b'\n\n'))

    def test_float_bits_extremes_and_exponent_boundaries(self):
        values = [0., -0., float.fromhex('0x0.0000000000001p-1022'),
                  -float.fromhex('0x0.0000000000001p-1022'), sys.float_info.min,
                  sys.float_info.max, -sys.float_info.max,
                  1e-7, 1e-6, 1e-5, 1e-4, 1e15, 1e16, 1e20, 1e21,
                  math.nextafter(1e-4, 0.), math.nextafter(1e16, math.inf)]
        self.compare('finite-float-extremes', lambda: {'values': list(values)})
        self.assertNotEqual(candidate.strict(0.), candidate.strict(-0.))

    def test_integer_bit_guard_and_bool_distinction(self):
        for value in [-(1 << 256), -(1 << 255), -1, 0, 1, (1 << 255), (1 << 256)-1, 1 << 256]:
            self.compare('integer-bits-'+str(value.bit_length())+'-'+str(value < 0),
                         lambda value=value: {'integer': value, 'boolean': True},
                         eligible=value.bit_length() <= 256)
        self.assertNotEqual(candidate.strict(True), candidate.strict(1))

    def test_python_decimal_conversion_boundary_unchanged(self):
        limit = sys.get_int_max_str_digits()
        digits = limit if limit else 4300
        for name, value in [('at', 10 ** (digits-1)), ('over', 10 ** digits), ('negative-over', -(10 ** digits))]:
            self.compare('decimal-digit-limit-'+name, lambda value=value: [value], eligible=False)
        self.assertEqual(sys.get_int_max_str_digits(), limit)

