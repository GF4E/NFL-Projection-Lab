    def test_mutations_between_calls_and_same_shape_replacement(self):
        left = {'nested': [1., -0.], 'first': 1, 'last': 2}
        right = {'nested': [1., -0.], 'first': 1, 'last': 2}
        states = [lambda x: None, lambda x: x['nested'].__setitem__(0, 2.),
                  lambda x: x['nested'].__setitem__(1, 0.), lambda x: x.__setitem__('new', []),
                  lambda x: x.pop('first'), lambda x: x.__setitem__('first', 1),
                  lambda x: x.__setitem__('nested', [5., -0.])]
        digests=[]
        for i, mutate in enumerate(states):
            mutate(left); mutate(right)
            before=original_strict(left)
            original, ot=_capture(original_strict,left); actual, at=_capture(candidate.strict,right)
            _emit({'test':self.id(),'label':'mutable-dict-'+str(i),'original':original,'candidate':actual,
                   'eligibility':{'actual':candidate.eligible(canonical(right)),'expected':True},
                   'input':{'canonical_ascii':before.decode('ascii')}})
            self.assertIs(ot,at);self.assertEqual(original,actual);digests.append(actual['sha256'])
        self.assertNotEqual(digests[0],digests[1]);self.assertNotEqual(digests[1],digests[2])
        self.assertEqual(digests[3],digests[5])
        arrays=[np.array([1., -0.]),np.array([1., -0.])]
        for i in range(4):
            if i==1:
                for x in arrays:x[0]=2.
            if i==2:
                for x in arrays:x.view(np.uint64)[1]=0
            if i==3: arrays=[np.array([7.,-0.]),np.array([7.,-0.])]
            original, ot=_capture(original_strict,arrays[0]);actual,at=_capture(candidate.strict,arrays[1])
            _emit({'test':self.id(),'label':'mutable-array-'+str(i),'original':original,'candidate':actual,
                   'input':{'dtype':arrays[0].dtype.str,'shape':list(arrays[0].shape),'bytes_hex':arrays[0].tobytes().hex()},
                   'eligibility':{'actual':True,'expected':True}})
            self.assertIs(ot,at);self.assertEqual(original,actual)

    def test_direct_fallback_uses_single_canonical_snapshot(self):
        def factory():
            v = np.array([1.]).view(ArrayHook)
            v.calls, v.fail, v.payload = [], False, [Opaque()]
            return v
        original_value, candidate_value = factory(), factory()
        original, original_type = _capture(original_strict, original_value)
        real_canonical, real_encoded = candidate.canonical, candidate.encoded
        with patch.object(candidate, 'canonical', wraps=real_canonical) as conversion, \
             patch.object(candidate, 'encoded', wraps=real_encoded) as fallback:
            actual, actual_type = _capture(candidate.strict, candidate_value)
            snapshot = fallback.call_args.args[0] if fallback.call_args else None
            observed = {'test': self.id(), 'label': 'single-canonical-direct-fallback',
                'original': original, 'candidate': actual, 'canonical_calls': conversion.call_count,
                'encoded_calls': fallback.call_count, 'original_hooks': original_value.calls,
                'candidate_hooks': candidate_value.calls, 'fallback_snapshot_type': type(snapshot).__name__,
                'eligibility': {'expected': False, 'actual': candidate.eligible([Opaque()])}}
            _emit(observed)
            self.assertIs(actual_type, original_type); self.assertEqual(actual, original)
            self.assertEqual(conversion.call_count, 1); self.assertEqual(fallback.call_count, 1)
            self.assertIs(type(snapshot), list); self.assertIs(type(snapshot[0]), Opaque)
            self.assertEqual(original_value.calls, ['tolist']); self.assertEqual(candidate_value.calls, ['tolist'])
        self.compare('valid-after-direct-fallback', lambda: {'valid': [-0.]})

    def test_unexpected_fastpath_errors_propagate_without_retry(self):
        value = {'x': [1, -0., 'é']}
        original, _ = _capture(original_strict, value)
        for local_name in ('dumps', '_pretty'):
            error = RuntimeError('injected '+local_name+' failure')
            real_encoded = candidate.encoded
            with patch.object(candidate, local_name, side_effect=error) as failed, \
                 patch.object(candidate, 'encoded', wraps=real_encoded) as fallback:
                actual, actual_type = _capture(candidate.strict, value)
                _emit({'test': self.id(), 'label': 'injected-'+local_name,
                       'original': original, 'candidate': actual, 'injected_error': str(error),
                       'failed_calls': failed.call_count, 'fallback_calls': fallback.call_count,
                       'eligibility': {'expected': True, 'actual': candidate.eligible(value)}})
                self.assertIs(actual_type, RuntimeError)
                self.assertEqual(actual['message'], str(error))
                self.assertEqual(failed.call_count, 1); self.assertEqual(fallback.call_count, 0)
            self.compare('valid-after-injected-'+local_name, lambda: {'ok': [1, -0.]})

    def test_eligible_has_no_conversion_or_encoder_calls(self):
        with patch.object(candidate, 'canonical', side_effect=AssertionError('guard canonicalized')) as conversion, \
             patch.object(candidate, 'dumps', side_effect=AssertionError('guard encoded')) as compact, \
             patch.object(candidate, 'encoded', side_effect=AssertionError('guard fallback encoded')) as fallback:
            self.guard('pure-guard-eligible', {'x': [1, -0.]}, True)
            self.guard('pure-guard-ineligible', {'x': Opaque()}, False)
            _emit({'test': self.id(), 'label': 'pure-guard-call-counts', 'canonical_calls': conversion.call_count,
                   'compact_calls': compact.call_count, 'encoded_calls': fallback.call_count})
            self.assertEqual((conversion.call_count, compact.call_count, fallback.call_count), (0, 0, 0))

