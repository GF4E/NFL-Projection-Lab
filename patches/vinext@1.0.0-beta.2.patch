+import { AsyncLocalStorage } from "node:async_hooks";
+import { createHmac } from "node:crypto";
+
+//#region internal qualification-only reproducible build entropy
+const qualificationBuildContextStorage = new AsyncLocalStorage();
+const qualificationDomains = new Map([
+	["pages-client-assets-build-session", 16],
+	["prerender-secret", 32],
+	["preview-mode-encryption-key", 32],
+	["preview-mode-id", 16],
+	["preview-mode-signing-key", 32],
+	["shared-revalidate-secret", 32]
+]);
+const qualificationDomainPrefix = Buffer.from("vinext/qualification-build/v1\0", "utf8");
+
+async function runWithQualificationBuildContextInternal(context, callback, observeZeroized) {
+	if (!Buffer.isBuffer(context) || context.length !== 32) {
+		throw new Error("internal qualification build context must contain exactly 32 bytes");
+	}
+	let retainedContext;
+	try {
+		if (qualificationBuildContextStorage.getStore()) {
+			throw new Error("internal qualification build context is already active");
+		}
+		retainedContext = Buffer.from(context);
+		return await qualificationBuildContextStorage.run(retainedContext, callback);
+	} finally {
+		context.fill(0);
+		if (retainedContext) {
+			retainedContext.fill(0);
+			observeZeroized?.({ inputContext: context, retainedContext });
+		}
+	}
+}
+
+function runWithQualificationBuildContext(context, callback) {
+	return runWithQualificationBuildContextInternal(context, callback);
+}
+
+function runWithQualificationBuildContextForTest(context, callback, observeZeroized) {
+	if (typeof observeZeroized !== "function") {
+		throw new Error("internal qualification build zeroization observer must be a function");
+	}
+	return runWithQualificationBuildContextInternal(context, callback, observeZeroized);
+}
+
+function qualificationBuildActive() {
+	return qualificationBuildContextStorage.getStore() !== void 0;
+}
+
+function qualificationBuildHex(domain) {
+	const context = qualificationBuildContextStorage.getStore();
+	if (!context) return void 0;
+	const byteLength = qualificationDomains.get(domain);
+	if (!byteLength) throw new Error(`unknown internal qualification build domain: ${domain}`);
+	return createHmac("sha256", context)
+		.update(qualificationDomainPrefix)
+		.update(domain, "utf8")
+		.digest()
+		.subarray(0, byteLength)
+		.toString("hex");
+}
+//#endregion
+export { qualificationBuildActive, qualificationBuildHex, runWithQualificationBuildContext, runWithQualificationBuildContextForTest };
